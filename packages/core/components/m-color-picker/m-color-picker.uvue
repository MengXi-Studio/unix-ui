	.m-color-picker__panel-hue {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
	}

	.m-color-picker__panel-white {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-image: linear-gradient(to right, #ffffff 0%, rgba(255, 255, 255, 0) 100%);
	}

	.m-color-picker__panel-black {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-image: linear-gradient(to top, #000000 0%, rgba(0, 0, 0, 0) 100%);
	}

	.m-color-picker__thumb {
		position: absolute;
		width: $m-color-picker-thumb-size;
		height: $m-color-picker-thumb-size;
		border-radius: $m-radius-max;
		border: $m-color-picker-thumb-border-width solid $m-color-picker-thumb-border-color;
		transform: translate(-50%, -50%);
	}

	/* ========== 滑块轨道（色相条 / 透明度条共用） ========== */
	.m-color-picker__track {
		position: relative;
		width: 100%;
		height: $m-color-picker-track-height;
		margin-top: $m-color-picker-track-margin-top;
		border-radius: $m-radius-max;
	}

	.m-color-picker__hue-fill {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		border-radius: $m-radius-max;
		background-image: linear-gradient(to right, #ff0000 0%, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000 100%);
	}

	.m-color-picker__checker {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		flex-direction: row;
		overflow: hidden;
		border-radius: $m-radius-max;
		background-color: $m-white;
	}

	.m-color-picker__checker-cell {
		width: $m-color-picker-checker-cell-width;
		height: 100%;
		background-color: $m-color-picker-checker-color;
	}

	.m-color-picker__checker-cell--light {
		background-color: $m-white;
	}

	.m-color-picker__alpha-fill {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		border-radius: $m-radius-max;
	}

	.m-color-picker__track-thumb {
		position: absolute;
		top: 50%;
		width: $m-color-picker-thumb-size;
		height: $m-color-picker-thumb-size;
		border-radius: $m-radius-max;
		border: $m-color-picker-thumb-border-width solid $m-color-picker-thumb-border-color;
		transform: translate(-50%, -50%);
	}

	/* ========== 数值输入 ========== */
	.m-color-picker__inputs {
		flex-direction: row;
		margin-top: $m-color-picker-inputs-margin-top;
	}

	.m-color-picker__input-item {
		flex: 1;
		flex-direction: column;
		margin-right: $m-color-picker-input-gap;
	}

	.m-color-picker__input-label {
		font-size: $m-color-picker-input-label-font-size;
		line-height: $m-color-picker-input-label-line-height;
		color: $m-text-color-tertiary;
	}

	.m-color-picker__input {
		height: $m-color-picker-input-height;
		padding: 0 6px;
