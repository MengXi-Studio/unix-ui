		border-radius: $m-radius-md;
		background-color: $m-white;
	}

	.m-color-picker__swatch--active {
		border-color: $m-color-picker-swatch-active-border-color;
		border-width: 2px;
	}

	.m-color-picker__swatch-fill {
		flex: 1;
		border-radius: 4px;
	}

	/* ========== 吸管（仅 Web 渲染） ========== */
	.m-color-picker__eyedropper {
		flex-direction: row;
		align-items: center;
		align-self: flex-start;
		margin-top: $m-color-picker-swatches-margin-top;
		padding: $m-color-picker-eyedropper-padding;
