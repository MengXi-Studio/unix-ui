/**
 * m-icon 图标字体的 base64 内联数据（由 packages/core/static/m-icon.ttf 生成，勿手工编辑）。
 * 用途：微信小程序 wxss 的 @font-face 不支持本地字体文件路径，MP-WEIXIN 端改用
 * uni.loadFontFace 在运行时加载该 base64 数据（m-icon.uvue 内条件编译）。
 * 重新生成：base64 -i packages/core/static/m-icon.ttf
 */
export const M_ICON_FONT_BASE64 = 'data:font/truetype;charset=utf-8;base64,'
