/**
 * m-space 与 m-space-item 的间距上下文（跨组件共享，独立 .uts）
 *
 * uvue 无 $children、ucss 无 :first-child 结构选择器且 App 端不支持 CSS gap
 * （官方属性清单与原生运行时属性表均无 gap，声明会被静默丢弃），
 * 容器侧无法给插槽直通的任意子元素加间距；
 * 由 space provide 本上下文并解析间距值，item 在 setup 中同步注册自身 id、
 * onUnmounted 注销，按注册序（即渲染顺序）判断首 / 非首轮位，
 * 非首项经 margin 实现主轴间距（m-compact 同款机制）。
 */
import { computed, reactive, type ComputedRef } from 'vue'

/** provide / inject 配对 key（字符串 key，App 原生端无需 Symbol 支持） */
export const SPACE_KEY: string = '__mxi_space__'

/** 间距方向：horizontal 水平 / vertical 垂直 */
export type SpaceDirection = 'horizontal' | 'vertical'

/** 间距大小项：number 补 px、string 原样 */
export type SpaceSize = number | string

/**
 * space 注入上下文：维护组内已挂载 item 的有序 id 集合与间距状态。
 * main / cross 为 ComputedRef（跟随 size prop 响应式，m-row 挂 computed 进 ctx 的先例）：
 * 空串表示未传 size，item 侧走 $m-space-size 主题默认类；非空为已补 px 的间距值。
 */
export class SpaceContext {
	/** 组内 item id 有序集合（reactive 数组，注册 / 注销自动触发间距重算） */
	ids: string[] = reactive<string[]>([])
	/** 排列方向（props 只读快照，创建后不变） */
	direction: SpaceDirection = 'horizontal'
	/** 水平排列下是否换行（props 只读快照，创建后不变；换行行间距经 item margin-bottom 实现） */
	wrap: boolean = false
	/** 主轴间距（横向为列间距 / 纵向为行间距），空串走主题默认 */
	main: ComputedRef<string> = computed<string>(() => '')
	/** 交叉轴间距（横向 wrap 的换行行间距），空串走主题默认 */
	cross: ComputedRef<string> = computed<string>(() => '')

	/** 注册 item（item setup 中同步调用，注册顺序即渲染顺序，首帧即为正确位置） */
	register(id: string): void {
		this.ids.push(id)
	}

	/** 注销 item（onUnmounted 调用，v-if / v-for 动态增删后位置自动重算） */
	unregister(id: string): void {
		const index = this.ids.indexOf(id)
		if (index != -1) {
			this.ids.splice(index, 1)
		}
	}

	/** 查询 id 的注册序位（-1 表示未注册） */
	indexOf(id: string): number {
		return this.ids.indexOf(id)
	}
}

/** item id 自增计数器（模块级） */
let spaceIdCounter = 0

/** 生成全局唯一 item id（item setup 中调用一次） */
export function generateSpaceId(): string {
	spaceIdCounter++
	return 'mxi_space_' + spaceIdCounter
}
