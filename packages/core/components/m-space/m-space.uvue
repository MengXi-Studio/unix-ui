<template>
	<!-- 间距容器：flex 容器 + m-space-item 子项组合。
	     App 端不支持 CSS gap（官方属性清单与原生运行时属性表均无，声明被静默丢弃），
	     ucss 又无子级选择器，插槽直通的任意子元素无法从容器侧加间距，
	     故子项需经 m-space-item 包裹（provide/inject 注册序，m-compact 同款机制），
	     由 item 注入主轴 margin；水平方向容器以等值负 margin-left 补偿
	     （经典 gutter 技法），保证换行后各行行首与首行顶格。 -->
	<view :class="rootClass" :style="rootStyle">
		<slot></slot>
	</view>
</template>

<script setup lang="uts">
	/**
	 * m-space 间距：水平 / 垂直排列的间距容器。
	 * 间距实现：解析 size 为主轴 / 交叉轴间距挂入 SpaceContext provide 给组内
	 * m-space-item（horizontal 全部 item margin-left + 容器等值负 margin 补偿顶格，
	 * vertical 非首项 margin-top，wrap 时全部 item margin-bottom 行间距）；
	 * 未传 size 时 item 走 $m-space-size 主题默认类（覆盖变量全局生效）。
	 */
	import { SPACE_KEY, SpaceContext, type SpaceDirection, type SpaceSize } from './context.uts'

	type Props = {
		/** 间距方向 */
		direction?: SpaceDirection
		/** 间距大小：number（补 px）/ string（原样）/ 数组 [横向, 纵向]（垂直方向取第一个值作主轴间距）；为空走主题默认 $m-space-size */
		size?: SpaceSize | SpaceSize[]
		/** 子元素对齐方式：未传时水平默认 center、垂直默认 stretch */
		align?: SpaceAlign
		/** 是否自动换行（仅水平方向生效） */
		wrap?: boolean
		/** 是否块级填充父元素 */
		fill?: boolean
		/** 自定义根节点类名 */
		customClass?: string.ClassString
		/** 自定义根节点内联样式 */
		customStyle?: string
	}

	/**
	 * 子元素对齐方式
	 */
	type SpaceAlign = 'start' | 'end' | 'center' | 'baseline'

	const props = withDefaults(defineProps<Props>(), {
		direction: 'horizontal',
		size: null,
		align: null,
		wrap: false,
		fill: false,
		customClass: '',
		customStyle: ''
	})

	/**
	 * 间距值归一：number 补 px（如 20 → '20px'），string 原样返回
	 */
	function sizeValue(value: SpaceSize): string {
		if (typeof value == 'number') return value.toString() + 'px'
		return value
	}

	/**
	 * 主轴间距（横向为列间距 / 纵向为行间距）：
	 * 单值 → 该值；数组 → 第一个值；未传 → 空串走 item 侧 $m-space-size 默认类
	 */
	const mainGap = computed<string>(() => {
		const s = props.size
		if (s == null) return ''
		if (Array.isArray(s)) {
			const arr = s as SpaceSize[]
			return sizeValue(arr[0])
		}
		return sizeValue(s)
	})

	/**
	 * 交叉轴间距（横向 wrap 的换行行间距）：
	 * 单值 → 该值；数组 → 横向取第二个值（缺省同第一个值）/ 纵向忽略（Q2=A 定案）；未传 → 空串走默认类
	 */
	const crossGap = computed<string>(() => {
		const s = props.size
		if (s == null) return ''
		if (Array.isArray(s)) {
			const arr = s as SpaceSize[]
			if (props.direction == 'vertical') return ''
			return arr.length > 1 ? sizeValue(arr[1]) : sizeValue(arr[0])
		}
		return sizeValue(s)
	})

	// 间距上下文：direction / wrap 为 props 只读快照（m-compact 先例），间距值挂 computed 跟随 size 响应
	const ctx = new SpaceContext()
	ctx.direction = props.direction
	ctx.wrap = props.wrap && props.direction == 'horizontal'
	ctx.main = mainGap
	ctx.cross = crossGap
	provide(SPACE_KEY, ctx)

	/** 根节点类名：direction / align / wrap / fill 变体按 props 拼接（horizontal 未传 align 默认 center；vertical 未传不设由 --vertical 类走 stretch 默认） */
	const rootClass = computed<string>(() => {
		let cls = 'm-space'
		if (props.direction == 'vertical') cls += ' m-space--vertical'
		if (props.align != null) {
			cls += ' m-space--align-' + (props.align as SpaceAlign)
		} else if (props.direction == 'horizontal') {
			cls += ' m-space--align-center'
		}
		if (props.wrap && props.direction == 'horizontal') cls += ' m-space--wrap'
		if (props.fill) cls += ' m-space--fill'
		// 水平方向主轴间距补偿类：抵消全部子项的 margin-left（默认间距走 -$m-space-size，
		// size 传入时被下方 rootStyle 的等值内联负 margin 覆盖），保证换行行首与首行顶格
		if (props.direction == 'horizontal') cls += ' m-space--compensate'
		if (props.customClass != '') cls += ' ' + props.customClass
		return cls
	})

	/** 根节点内联样式：customStyle 补分号；水平方向 size 传入时追加等值负 margin-left 补偿（内联优先级高于补偿类） */
	const rootStyle = computed<string>(() => {
		let style = props.customStyle
		if (style != '' && !style.endsWith(';')) style += ';'
		if (props.direction == 'horizontal') {
			const main = mainGap.value
			// 负值 size 不做二次取负（避免拼出 '--4px' 非法值）
			if (main != '' && !main.startsWith('-')) {
				style += 'margin-left: -' + main + ';'
			}
		}
		return style
	})
</script>

<style lang="scss">
	/*
	 * 主题变量说明（默认主题内置 + 变量覆盖）：
	 * 组件内顶层引入 theme/vars.scss（全部 !default），零配置即有默认主题；
	 * 覆盖方式：项目根 uni.scss 直接定义 $m-* 变量（禁止 @import vars.scss，
	 * uni.scss 注入机制与组件内引入同一文件会触发循环导入）。
	 */
	@import '../../theme/vars.scss';

	/* ========== 基类（横向 + 收缩贴合内容；间距由 m-space-item 的 margin 实现） ========== */
	.m-space {
		flex-direction: row;
		align-self: flex-start; /* 收缩宽度贴内容，fill 时覆盖为 stretch */
	}

	/* ========== 方向变体（vertical 未传 align 时显式走 stretch 默认） ========== */
	.m-space--vertical {
		flex-direction: column;
		align-items: stretch;
	}

	/* ========== 换行变体（仅水平方向拼接） ========== */
	.m-space--wrap {
		flex-wrap: wrap;
	}

	/* ========== 填充变体（块级填充父元素，覆盖收缩） ========== */
	.m-space--fill {
		width: 100%;
		align-self: stretch;
	}

	/* ========== 主轴间距补偿（仅水平方向拼接）：等值抵消全部子项的 margin-left，
	   换行后各行行首与首行顶格（经典 gutter 负 margin 技法；size 传入时被内联等值负 margin 覆盖） ========== */
	.m-space--compensate {
		margin-left: -$m-space-size;
	}

	/* ========== 对齐变体（声明顺序在基类与方向类之后，覆盖生效） ========== */
	.m-space--align-start {
		align-items: flex-start;
	}
	.m-space--align-center {
		align-items: center;
	}
	.m-space--align-end {
		align-items: flex-end;
	}
	.m-space--align-baseline {
		/* App 端 align-items 不支持 baseline，降级为首行起点对齐；Web 端保持 baseline 语义 */
		align-items: flex-start;
		/* #ifdef WEB */
		align-items: baseline;
		/* #endif */
	}
</style>
