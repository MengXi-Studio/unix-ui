<template>
	<!-- 标签页容器：标签栏（sticky 时由 m-sticky 包裹吸附）+ 内容区（m-tab 子项承载）。
	     双形态：m-tab 子组件插槽式（内容区渲染）或 options 数组纯标签栏（无内容区）。
	     scrollspy 滚动导航依赖页面回传 scroll-top（对齐 m-sticky 受控协议）。 -->
	<view ref="rootRef" id="m-tabs-root" :class="rootClass" :style="rootStyle">
		<!-- 标签栏：sticky 吸附分支（模板无法抽公共块，两分支重复渲染同一结构） -->
		<m-sticky v-if="sticky && showHeader" :scroll-top="scrollTop" :offset-top="offsetTop" @change="onStickyChange">
			<view ref="navRef" id="m-tabs-nav" class="m-tabs__nav" :class="navClass">
				<view v-if="slots['nav-left'] != null" class="m-tabs__nav-extra">
					<slot name="nav-left"></slot>
				</view>
				<scroll-view
					id="m-tabs-nav-scroll"
					class="m-tabs__nav-scroll"
					:direction="canScroll ? 'horizontal' : 'none'"
					:scroll-left="navScrollLeft"
					:scroll-with-animation="true"
					:show-scrollbar="false"
					ref="navScrollRef"
					@scroll="onNavScroll"
				>
					<view :class="navRowClass">
						<view
							v-for="(item, i) in navItems"
							:id="'m-tabs-tab-' + i"
							:key="item.key"
							class="m-tabs__title"
							:class="titleClass(item, i)"
							:style="titleStyle(item, i)"
							@click="onTitleClick(item, i)"
						>
							<text :class="titleTextClass(item, i)">{{ item.title }}</text>
							<view v-if="item.dot || item.badge != ''" class="m-tabs__title-badge-wrap">
								<m-badge :content="item.badge" :dot="item.dot" :show-zero="item.showZeroBadge" />
							</view>
							<view v-if="showTitleLine(item, i)" class="m-tabs__title-line" :style="lineInlineStyle"></view>
						</view>
					</view>
				</scroll-view>
				<view v-if="slots['nav-right'] != null" class="m-tabs__nav-extra">
					<slot name="nav-right"></slot>
				</view>
				<view v-if="showFreeLine" ref="lineRef" id="m-tabs-line" class="m-tabs__line" :style="lineStyle"></view>
			</view>
		</m-sticky>
		<template v-else-if="showHeader">
			<view ref="navRef" id="m-tabs-nav" class="m-tabs__nav" :class="navClass">
				<view v-if="slots['nav-left'] != null" class="m-tabs__nav-extra">
					<slot name="nav-left"></slot>
				</view>
				<scroll-view
					id="m-tabs-nav-scroll"
					class="m-tabs__nav-scroll"
					:direction="canScroll ? 'horizontal' : 'none'"
					:scroll-left="navScrollLeft"
					:scroll-with-animation="true"
					:show-scrollbar="false"
					ref="navScrollRef"
					@scroll="onNavScroll"
				>
					<view :class="navRowClass">
						<view
							v-for="(item, i) in navItems"
							:id="'m-tabs-tab-' + i"
							:key="item.key"
							class="m-tabs__title"
							:class="titleClass(item, i)"
							:style="titleStyle(item, i)"
							@click="onTitleClick(item, i)"
						>
							<text :class="titleTextClass(item, i)">{{ item.title }}</text>
							<view v-if="item.dot || item.badge != ''" class="m-tabs__title-badge-wrap">
								<m-badge :content="item.badge" :dot="item.dot" :show-zero="item.showZeroBadge" />
							</view>
							<view v-if="showTitleLine(item, i)" class="m-tabs__title-line" :style="lineInlineStyle"></view>
						</view>
					</view>
				</scroll-view>
				<view v-if="slots['nav-right'] != null" class="m-tabs__nav-extra">
					<slot name="nav-right"></slot>
				</view>
				<view v-if="showFreeLine" ref="lineRef" id="m-tabs-line" class="m-tabs__line" :style="lineStyle"></view>
			</view>
		</template>

		<!-- 内容区：options 纯标签栏模式不渲染；viewport 裁剪轨道平移，track 承载 m-tab 们 -->
		<view
			v-if="!optionsMode"
			class="m-tabs__viewport"
			@touchstart="onTouchStart"
			@touchmove="onTouchMove"
			@touchend="onTouchEnd"
		>
			<view ref="trackRef" class="m-tabs__track" :class="trackClass" :style="trackStyle">
				<slot></slot>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	/**
	 * m-tabs 标签页容器：支持 pill 形态与 options 数组形态。
	 * 标题栏由容器按注册快照渲染（uni-app x 无 VNode 移动能力，m-tab 插槽内容无法上提）；
	 * 内容显隐经上下文下发（renderSet / everSet / scrollspy 三协议）。
	 * active 匹配语义（索引与 name 混用）：先按 name 分类型全等匹配，无命中回退索引（clamp）。
	 * sticky 吸附复用 m-sticky、scrollspy 滚动导航依赖页面回传 scroll-top（对齐 m-sticky 受控协议）。
	 * 底部条平移动画与内容轨道动画走 UniElement.animate（ucss 无 @keyframes）。
	 */
	import { TABS_KEY, TabsContext, TabItem, TabsClickEvent } from './tabs.uts'
	import MSticky from '../m-sticky/m-sticky.uvue'
	import MBadge from '../m-badge/m-badge.uvue'

	/** 标签页样式风格 */
	type TabsType = 'line' | 'card' | 'pill'

	/** options 数组的字段名映射 */
	type TabsFieldNames = {
		label: string
		value: string
		disabled: string
		dot: string
		badge: string
	}

	/** 切换拦截回调：返回 false 阻止本次切换（boolean 同步版，对齐 m-popup before-close；类型标注不含 null——VDOM 编译器生成的 props type 数组不接受 null 成员，未传时运行时仍为 null） */
	type TabsBeforeChange = (name: string | number | null, index: number) => boolean

	const DEFAULT_FIELD_NAMES: TabsFieldNames = { label: 'label', value: 'value', disabled: 'disabled', dot: 'dot', badge: 'badge' }

	type Props = {
		/** 当前激活标签（v-model:active；索引或 name 混用：先按 name 分类型匹配，无命中回退索引） */
		active?: string | number
		/** 样式风格：line 底部条 / card 卡片 / pill 药丸 */
		type?: TabsType
		/** 主题色（line 底部条、card / pill 选中填充、激活标题色派生；空串用主题变量） */
		color?: string
		/** 标签栏背景色（空串用主题变量） */
		background?: string
		/** 底部条与内容切换动画时长（秒，0 禁用动画） */
		duration?: number
		/** 底部条宽度（number 补 px / string 原样） */
		lineWidth?: string | number
		/** 底部条高度（number 补 px / string 原样） */
		lineHeight?: string | number
		/** 是否开启内容切换转场动画（轨道模式） */
		animated?: boolean
		/** 是否显示标签栏外边框（仅 line 风格生效） */
		border?: boolean
		/** 是否省略过长标题文字（仅平分布局生效） */
		ellipsis?: boolean
		/** 是否吸顶（复用 m-sticky，需页面回传 scroll-top） */
		sticky?: boolean
		/** 是否左侧收缩布局（标签不再平分，向左排列） */
		shrink?: boolean
		/** 是否手势左右滑动切换内容（走轨道模式，手势切换不触发 before-change） */
		swipeable?: boolean
		/** 是否延迟渲染（标签首次激活才渲染内容） */
		lazyRender?: boolean
		/** 是否滚动导航（内容平铺展示，滚动时联动激活；需页面回传 scroll-top） */
		scrollspy?: boolean
		/** 是否显示标签栏 */
		showHeader?: boolean
		/** 吸顶时与滚动容器顶部的距离（px，透传 m-sticky） */
		offsetTop?: number
		/** 滚动阈值：标签数超过该值时标签栏开始横向滚动（平分布局失效） */
		swipeThreshold?: number
		/** 标题选中态颜色（空串用主题变量派生） */
		titleActiveColor?: string
		/** 标题默认态颜色（空串用主题变量） */
		titleInactiveColor?: string
		/** 切换前拦截回调（返回 false 阻止；手势滑动不触发） */
		beforeChange?: TabsBeforeChange
		/** options 数组（纯标签栏形态：label / value / disabled / dot / badge，无内容区） */
		options?: UTSJSONObject[]
		/** options 字段名映射（未传用默认） */
		fieldNames?: TabsFieldNames
		/** 页面滚动距离（px，sticky 与 scrollspy 依赖页面 / 滚动容器回传） */
		scrollTop?: number
		/** 自定义根节点类名 */
		customClass?: string.ClassString
		/** 自定义根节点内联样式 */
		customStyle?: string
	}

	const props = withDefaults(defineProps<Props>(), {
		active: 0,
		type: 'line',
		color: '',
		background: '',
		duration: 0.3,
		lineWidth: '',
		lineHeight: '',
		animated: false,
		border: false,
		ellipsis: true,
		sticky: false,
		shrink: false,
		swipeable: false,
		lazyRender: true,
		scrollspy: false,
		showHeader: true,
		offsetTop: 0,
		swipeThreshold: 5,
		titleActiveColor: '',
		titleInactiveColor: '',
		beforeChange: null,
		options: null,
		fieldNames: null,
		scrollTop: 0,
		customClass: '',
		customStyle: ''
	})

	const emit = defineEmits<{
		/** 激活标签变化（v-model:active；值为标签 name，未指定 name 时为索引） */
		'update:active': [name: string | number]
		/** 激活标签变化（交互路径派发；scrollspy 滚动联动与外部回灌不派发） */
		change: [name: string | number | null, index: number]
		/** 点击标签（含禁用标签） */
		'click-tab': [event: TabsClickEvent]
		/** 吸顶状态变化（sticky 模式透传 m-sticky） */
		'sticky-change': [isFixed: boolean]
	}>()

	const slots = useSlots()

	// ========== 上下文与元素引用 ==========

	/** m-tab 注册上下文（options 模式不 provide，子组件不存在） */
	const ctx = new TabsContext()
	provide(TABS_KEY, ctx)

	/** 根节点（实测宽度用于底部条位置计算） */
	const rootRef = ref<UniElement | null>(null)
	/** 内容轨道节点（animated / swipeable 平移动画载体） */
	const trackRef = ref<UniElement | null>(null)
	/** 独立底部条节点（平分 line 布局） */
	const lineRef = ref<UniElement | null>(null)
	/** 标题栏滚动视口节点（滚动 / 收缩布局激活标签居中测量基准） */
	const navScrollRef = ref<UniElement | null>(null)
	/** 标题栏滚动位置（scroll-left 绑定值；@scroll 回灌镜像实际位置，手动滚动后同值目标也能重新触发） */
	const navScrollLeft = ref(0)
	/** 标签栏节点（scrollspy 判定基准线 = 标签栏底边实时视口位置；两个模板分支互斥渲染，ref 安全） */
	const navRef = ref<UniElement | null>(null)
	/** scrollspy 滚动容器缓存（判定基准线与点击定位共用；findScrollParent 含试位移探测，滚动高频路径必须缓存避免重复副作用） */
	let spyHolder: UniElement | null = null
	/** 滚动容器是否已探测（含「确认为页面级滚动」的结果缓存） */
	let spyHolderSearched = false

	/**
	 * 数字或纯数字字符串补 px（"40" → "40px"，"40px" 原样）
	 */
	function addUnit(value: string | number): string {
		if (typeof value == 'number') return value.toString() + 'px'
		const s = value as string
		const pattern = new RegExp('^-?\\d+(\\.\\d+)?$')
		return pattern.test(s) ? s + 'px' : s
	}

	/**
	 * 尺寸解析为 px 数值（number 直取；string 纯数字或带 px 后缀均可）
	 */
	function parsePx(value: string | number): number {
		if (typeof value == 'number') return value
		const s = (value as string).replace('px', '')
		const n = parseFloat(s)
		return isNaN(n) ? 40 : n
	}

	/**
	 * 深度优先查找指定 id 的后代元素
	 *
	 * Web 端 scroll-view 渲染为多层包装容器，标题项不一定是 ref 节点的直接子节点，
	 * 按 id 查找对包装层数量不敏感；搜索范围限定在自身标题栏子树内（多实例 id 互不串扰）。
	 * 注意只认 id attribute（getAttribute）——UniElement 的 id 属性在 App 端不存在，
	 * Web 端也不映射 DOM id（见 LESSONS #82）。
	 */
	function findDescendantById(el: UniElement, id: string): UniElement | null {
		// #ifdef MP
		// 小程序端 UniElement 无 children（子树不可遍历），按 id 查找不可用——
		// 调用点判空降级（测量走 queryRectById）
		return null
		// #endif
		// #ifndef MP
		const attr = el.getAttribute('id')
		if (attr != null && attr == id) return el
		for (let i = 0; i < el.children.length; i++) {
			const found = findDescendantById(el.children[i], id)
			if (found != null) return found
		}
		return null
		// #endif
	}

	/**
	 * 判断元素是否为滚动容器候选（可实际滚动）
	 *
	 * 对齐 m-sticky 的判定思路：Web 端 scroll-view 渲染为多层 class 含 uni-scroll-view 的节点，
	 * 外层壳 overflow hidden 不可滚，须以「滚动高度大于可视高度」为准。
	 *
	 * @param el 待判断的元素
	 * @return 是否可作为滚动容器
	 */
	function isScrollCandidate(el: UniElement): boolean {
		// offsetHeight（UniElement 类型可用）替代 clientHeight，语义一致（可视高度），对齐 m-sticky 同名判定
		return el.scrollHeight > el.offsetHeight + 4
	}

	/**
	 * 候选二次验证：试位移并读回，确认可实际滚动
	 *
	 * scrollHeight 大于可视高度的候选未必真可滚——Web 端 overflow: visible 的普通包装层
	 * 同样会把后代溢出计入 scrollHeight（实测 uni-scroll-view-content sh=3660 > oh=626
	 * 被误判为候选），对其赋值 scrollTop 被静默拒绝，导致点击定位完全失效。位移与还原
	 * 在同一同步任务内完成，不产生可见闪烁。
	 */
	function isReallyScrollable(el: UniElement): boolean {
		const before = el.scrollTop
		el.scrollTop = before + 10
		const moved = el.scrollTop > before + 0.5
		el.scrollTop = before
		return moved
	}

	/**
	 * 向上查找最近的滚动容器（对齐 m-sticky 同名逻辑）
	 *
	 * @param start 起始元素
	 * @return 滚动容器元素（未找到为 null）
	 */
	function findScrollParent(start: UniElement | null): UniElement | null {
		// #ifdef MP
		// 小程序端 UniElement 无 parentElement（祖先不可遍历），滚动容器探测不可用——
		// 返回 null（scrollspy 判定按页面级滚动语义退化，点击定位回退 uni.pageScrollTo）
		return null
		// #endif
		// #ifndef MP
		let cur = start != null ? start.parentElement : null
		while (cur != null) {
			if (isScrollCandidate(cur) && isReallyScrollable(cur)) return cur
			cur = cur.parentElement
		}
		return null
		// #endif
	}

	/**
	 * 懒探测并缓存 scrollspy 滚动容器（结果含 null——页面级滚动同样缓存，避免每次滚动重复向上探测）
	 */
	function ensureSpyHolder() {
		if (spyHolderSearched) return
		spyHolder = findScrollParent(rootRef.value)
		spyHolderSearched = true
	}

	// #ifdef MP
	/** 组件实例（createSelectorQuery 的 in 作用域参数；setup 期一次性获取） */
	const mpInstance = getCurrentInstance()

	/**
	 * 小程序端测量：按 id 在组件实例作用域内查询节点矩形（多实例安全）
	 *
	 * 小程序端 UniElement 无 children / parentElement（子树不可遍历），且
	 * getBoundingClientRectAsync 仅支持有 id 的元素——统一走 createSelectorQuery
	 * 按 id 直查（标题 / 底部条 / 标签栏 / 内容块均带 id）。
	 *
	 * @param id 目标元素 id（组件实例内唯一即可）
	 * @param cb 测量回调（DOMRect 兼容结构，未查到传 null）
	 */
	const queryRectById = (id: string, cb: (rect: DOMRect | null) => void) => {
		uni.createSelectorQuery().in(mpInstance!.proxy!)
			.select('#' + id)
			.boundingClientRect()
			.exec((ret: Array<any>) => {
				const first = ret.length > 0 ? ret[0] : null
				cb(first as DOMRect | null)
			})
	}
	// #endif

	/**
	 * 标题栏滚动回灌：镜像实际滚动位置（保持 scroll-left 绑定值与真实位置一致）
	 */
	const onNavScroll = (e: UniScrollEvent) => {
		navScrollLeft.value = e.detail.scrollLeft
	}

	// ========== 状态 ==========

	/** 容器实测宽度（px，底部条位置与轨道平移距离依据） */
	const selfWidth = ref(0)
	/** 轨道平移偏移（px，swipeable 跟手阶段响应式驱动） */
	const trackOffset = ref(0)
	/** swipeable 手势是否处于跟手阶段（true 时 watch 编排器让位给手势） */
	const gesturing = ref(false)
	/** 独立底部条平移位置（px，测量制；见 animateLine） */
	const lineLeft = ref<number>(0)
	/** 是否首定（首个激活项直接定位，不做动画） */
	let firstSet = true

	/** options 纯标签栏模式 */
	const optionsMode = computed<boolean>(() => props.options != null)

	/** 字段名映射（null 兜底默认） */
	const fields = computed<TabsFieldNames>(() => {
		const f = props.fieldNames
		if (f != null) return f
		return DEFAULT_FIELD_NAMES
	})

	/**
	 * options 数组解析为标签项快照（key 用负数段避免与子组件注册 key 冲突）
	 */
	function parseOptions(): TabItem[] {
		const list: TabItem[] = []
		const opts = props.options
		if (opts == null) return list
		for (let i = 0; i < opts.length; i++) {
			const o = opts[i]
			let name: string | number | null = null
			const numVal = o.getNumber(fields.value.value)
			if (numVal != null) {
				name = numVal
			} else {
				name = o.getString(fields.value.value)
			}
			list.push({
				index: i,
				key: -1000 - i,
				title: o.getString(fields.value.label) ?? '',
				name: name,
				disabled: o.getBoolean(fields.value.disabled) == true,
				dot: o.getBoolean(fields.value.dot) == true,
				badge: o.getString(fields.value.badge) ?? '',
				showZeroBadge: true
			})
		}
		return list
	}

	/** 标签栏数据源：子组件注册快照或 options 解析结果 */
	const navItems = computed<TabItem[]>(() => {
		if (optionsMode.value) {
			return parseOptions()
		}
		return ctx.items.value
	})

	/** 激活注册序（-1 未激活；options 模式直接驱动本状态） */
	const activeIndex = ctx.activeIndex

	// ========== 布局判定 ==========

	/** 平分布局失效：收缩布局或标签数超过滚动阈值 */
	const canScroll = computed<boolean>(() => {
		return navItems.value.length > props.swipeThreshold || props.shrink
	})

	/** 轨道模式（animated / swipeable 开启且非 scrollspy） */
	const trackMode = computed<boolean>(() => (props.animated || props.swipeable) && !props.scrollspy)

	// 模式标志同步下发上下文（m-tab 依此决定 pane 布局类与 scrollspy 平铺协议；两个 prop 声明期静态）
	ctx.scrollspy.value = props.scrollspy
	ctx.trackMode.value = trackMode.value

	/** 底部条双实现切换：平分布局独立条（animate 平移），滚动 / 收缩布局标题内嵌条 */
	const freeLineMode = computed<boolean>(() => {
		return props.type == 'line' && !canScroll.value && !props.shrink
	})

	/** 独立底部条是否渲染 */
	const showFreeLine = computed<boolean>(() => freeLineMode.value && activeIndex.value >= 0)

	/** 标题内嵌条是否显示（滚动 / 收缩布局的 line 风格激活项） */
	const showTitleLine = (item: TabItem, index: number): boolean => {
		return props.type == 'line' && !freeLineMode.value && index == activeIndex.value
	}

	/** 轨道容器类：scrollspy 平铺为纵向排布 */
	const trackClass = computed<string>(() => {
		return props.scrollspy ? 'm-tabs__track--scrollspy' : 'm-tabs__track--row'
	})

	// ========== 类名与样式（扁平类，禁后代选择器） ==========

	const rootClass = computed<string>(() => {
		let cls = 'm-tabs'
		if (props.customClass != '') cls += ' ' + props.customClass
		return cls
	})

	const rootStyle = computed<string>(() => {
		if (props.background != '') {
			return 'background-color: ' + props.background + ';'
		}
		return ''
	})

	/** 标签栏变体类：card 卡片壳 / pill 药丸 / line 外边框 */
	const navClass = computed<string>(() => {
		let cls = ''
		if (props.type == 'card') cls = 'm-tabs__nav--card'
		if (props.type == 'pill') cls = 'm-tabs__nav--pill'
		if (props.type == 'line' && props.border) cls += ' m-tabs__nav--border'
		return cls
	})

	/** 标签行布局类：平分等宽（flex:1）或滚动收缩（flex:none） */
	const navRowClass = computed<string>(() => {
		return freeLineMode.value ? 'm-tabs__nav-row--equal' : 'm-tabs__nav-row--scroll'
	})

	/** 标题类名：布局 + 风格 + 状态三段拼接 */
	const titleClass = (item: TabItem, index: number): string => {
		let cls = freeLineMode.value ? 'm-tabs__title--equal' : 'm-tabs__title--scroll'
		if (props.type == 'card') cls += ' m-tabs__title--card'
		if (props.type == 'pill') cls += ' m-tabs__title--pill'
		if (index == activeIndex.value && !item.disabled) cls += ' m-tabs__title--active'
		if (item.disabled) cls += ' m-tabs__title--disabled'
		if (props.type == 'card' && index == activeIndex.value && !item.disabled) cls += ' m-tabs__title--card-active'
		if (props.type == 'pill' && index == activeIndex.value && !item.disabled) cls += ' m-tabs__title--pill-active'
		return cls
	}

	/** 标题 inline 样式：color 派生激活色（card / pill 激活白字走 --filled 类，不在此注入） */
	const titleStyle = (item: TabItem, index: number): string => {
		if (item.disabled) return ''
		if (index == activeIndex.value) {
			if (props.titleActiveColor != '') return 'color: ' + props.titleActiveColor + ';'
			if (props.type == 'line' && props.color != '') return 'color: ' + props.color + ';'
		} else if (props.titleInactiveColor != '') {
			return 'color: ' + props.titleInactiveColor + ';'
		}
		return ''
	}

	/** 标题文字类：激活色 / 省略 / 填充白字（扁平类拼接，禁后代选择器） */
	const titleTextClass = (item: TabItem, index: number): string => {
		let cls = 'm-tabs__title-text'
		const isActive = index == activeIndex.value && !item.disabled
		if (isActive) cls += ' m-tabs__title-text--active'
		if (freeLineMode.value && props.ellipsis) cls += ' m-tabs__title-text--ellipsis'
		if ((props.type == 'card' || props.type == 'pill') && isActive) cls += ' m-tabs__title-text--filled'
		return cls
	}

	/** 底部条 inline 样式：平移位置（独立条）由 lineStyle 计算，颜色派生 color */
	const lineInlineStyle = computed<string>(() => {
		let s = ''
		if (props.color != '') s += 'background-color: ' + props.color + ';'
		if (props.lineWidth != '') s += 'width: ' + addUnit(props.lineWidth) + ';'
		if (props.lineHeight != '') s += 'height: ' + addUnit(props.lineHeight) + ';'
		return s
	})

	/** 独立底部条样式：translateX 定位（平分布局） */
	const lineStyle = computed<string>(() => {
		return lineInlineStyle.value + 'transform: translateX(' + lineLeft.value.toString() + 'px);'
	})

	/** 轨道偏移样式（跟手 / 复位共用） */
	const trackStyle = computed<string>(() => {
		return 'transform: translateX(' + trackOffset.value.toString() + 'px);'
	})

	/**
	 * 按激活标签中心相对视口中心的偏差执行居中滚动（centerActiveTab 的 Web 同步 / 异步双路径共用）
	 *
	 * 目标值基于实际 scrollLeft（rootRef 的 getter 已被 uni-h5 重定义到内部真实滚动层）计算；
	 * 超界目标由 scroll-view 内部钳制（超出 max 的 scroll-left 落在边界，位置经 @scroll 回灌镜像）。
	 *
	 * @param delta 标签中心相对视口中心的偏差（px，正值标签偏右需向右滚）
	 */
	function scrollToTabCenter(delta: number) {
		if (delta == 0) return
		const viewport = navScrollRef.value
		if (viewport == null) return
		navScrollLeft.value = Math.max(viewport.scrollLeft + delta, 0)
	}

	/**
	 * 滚动 / 收缩布局激活标签居中：将激活标签中心对齐标题栏视口中心
	 *
	 * scroll-into-view 只能把元素滚到起始位置（末位标签贴边裁切、无法居中），改为 scroll-left
	 * 程序化滚动；标题项按 id 深度优先查找（Web 端 scroll-view 有编译器内部包装层，不能假设
	 * 直接子节点结构）。Web 端同步测量，App / 小程序端 UniElement 无同步 getBoundingClientRect，
	 * 走 getBoundingClientRectAsync（平台分支对齐 m-sticky / 本组件 scrollspy 同名机制）。
	 */
	function centerActiveTab() {
		if (!canScroll.value) return
		const viewport = navScrollRef.value
		if (viewport == null) return
		const i = activeIndex.value
		if (i < 0 || i >= navItems.value.length) return
		// #ifdef MP
		// 小程序端：按 id 组件实例作用域查询（nav-scroll 视口 + 激活标题）
		queryRectById('m-tabs-nav-scroll', (vrect: DOMRect | null) => {
			if (vrect == null) return
			queryRectById('m-tabs-tab-' + i.toString(), (trect: DOMRect | null) => {
				if (trect == null) return
				scrollToTabCenter(trect.left + trect.width / 2 - vrect.left - vrect.width / 2)
			})
		})
		// #endif
		// #ifndef MP
		const tabEl = findDescendantById(viewport, 'm-tabs-tab-' + i.toString())
		if (tabEl == null) return
		// #ifdef WEB
		const tabRect = tabEl.getBoundingClientRect()
		const viewRect = viewport.getBoundingClientRect()
		scrollToTabCenter(tabRect.left + tabRect.width / 2 - viewRect.left - viewRect.width / 2)
		// #endif
		// #ifndef WEB
		tabEl.getBoundingClientRectAsync()!.then((trect: DOMRect) => {
			viewport.getBoundingClientRectAsync()!.then((vrect: DOMRect) => {
				scrollToTabCenter(trect.left + trect.width / 2 - vrect.left - vrect.width / 2)
			})
		})
		// #endif
		// #endif
	}

	// ========== active 匹配与切换 ==========

	/**
	 * active 值解析为注册序（混用协议）：先按 name 分类型全等匹配，无命中回退索引（clamp）
	 */
	function resolveActive(v: string | number): number {
		const items = navItems.value
		let i = 0
		while (i < items.length) {
			const n = items[i].name
			if (n != null && typeof v == 'string' && typeof n == 'string' && n == v) return i
			if (n != null && typeof v == 'number' && typeof n == 'number' && n == v) return i
			i++
		}
		if (typeof v == 'number') {
			const idx = Math.floor(v)
			if (idx >= 0 && idx < items.length) return idx
		}
		return -1
	}

	/** 激活项标识（name 优先，未指定回退索引） */
	function itemIdent(index: number): string | number {
		const item = navItems.value[index]
		if (item.name != null) return item.name
		return index
	}

	/**
	 * 按目标块与滚动视口顶边的差执行定位（scrollToIndex 的 Web 同步 / 异步双路径共用）
	 *
	 * delta 以滚动容器顶边为基准（视口坐标推导中容器顶偏移自然抵消，与容器在视口中的
	 * 位置无关）；目标位置 = 吸顶标签栏底边，与判定基准线一致——
	 * 定位后 scrollspy 判定二次确认同一项。定位过深（末位块贴底）由容器内部钳制。
	 *
	 * @param delta 目标块顶边相对滚动容器顶边的距离（px，正值向下滚）
	 * @param holder 真实滚动容器（null 时回退 uni.pageScrollTo 页面级定位）
	 * @param navHeight 标签栏高度
	 */
	function scrollByToPane(delta: number, holder: UniElement | null, navHeight: number) {
		const scrollBy = delta - props.offsetTop - navHeight
		if (scrollBy == 0) return
		if (holder != null) {
			holder.scrollTop = holder.scrollTop + scrollBy
		} else {
			// 页面级滚动回退（App 端主路径）；回调风格避免 web 端未处理 rejection
			uni.pageScrollTo({
				scrollTop: props.scrollTop + scrollBy,
				duration: Math.round(props.duration * 1000),
				success: () => {},
				fail: () => {}
			})
		}
	}

	// #ifndef WEB
	/**
	 * 异步测量收敛后执行定位（scrollToIndex 非 Web 分支的 batch 回调）
	 *
	 * @param paneTop 目标块视口顶边距离
	 * @param holderTop 滚动容器视口顶边距离（页面级滚动为 0）
	 * @param navH 标签栏高度
	 */
	function finishScrollToIndex(paneTop: number, holderTop: number, navH: number) {
		if (spyHolder != null) {
			scrollByToPane(paneTop - holderTop, spyHolder, navH)
		} else {
			scrollByToPane(paneTop, null, navH)
		}
	}
	// #endif

	/**
	 * scrollspy 点击定位：目标块顶边对齐吸顶标签栏底边（吸附位 = 滚动视口顶 +
	 * offset-top + 标签栏高，与 applyScrollSpy 判定基准线严格一致）。
	 * 优先定位最近滚动容器（scroll-view 内嵌场景可用）；
	 * 无滚动容器时回退 uni.pageScrollTo 页面级定位（页面级滚动场景）。
	 *
	 * Web 端同步测量；App / 小程序端走异步测量（平台分支对齐 m-sticky）。
	 *
	 * @param target 注册序
	 */
	function scrollToIndex(target: number) {
		if (target < 0 || target >= ctx.items.value.length) return
		const el = ctx.paneEls.get(ctx.items.value[target].key)
		if (el == null) return
		const navEl = navRef.value
		if (navEl == null) return
		// #ifdef MP
		// 小程序端：滚动容器不可探测（holderTop 取 0，页面级滚动语义），按 id 查询
		// 内容块与标签栏矩形；scroll-view 内嵌场景 pageScrollTo 无效为已知降级
		queryRectById('m-tabs-pane-' + target.toString(), (prect: DOMRect | null) => {
			if (prect == null) return
			queryRectById('m-tabs-nav', (nrect: DOMRect | null) => {
				const navH = nrect != null ? nrect.height : 44
				scrollByToPane(prect.top, null, navH)
			})
		})
		// #endif
		// #ifndef MP
		// #ifdef WEB
		const navH = navEl.getBoundingClientRect().height
		ensureSpyHolder()
		if (spyHolder != null) {
			scrollByToPane(el.getBoundingClientRect().top - spyHolder.getBoundingClientRect().top, spyHolder, navH)
		} else {
			scrollByToPane(el.getBoundingClientRect().top, null, navH)
		}
		// #endif
		// #ifndef WEB
		ensureSpyHolder()
		// spyHolder 是被闭包捕获的可变局部变量，Kotlin 禁止对它 smart cast——使用点先读入不可变快照
		const spyHolderSnapshot = spyHolder
		let pending = 3
		let paneTop = 0
		let holderTop = 0
		let navH = 0
		const done = () => {
			pending--
			if (pending == 0) finishScrollToIndex(paneTop, holderTop, navH)
		}
		el.getBoundingClientRectAsync()!.then((rect: DOMRect) => {
			paneTop = rect.top
			done()
		})
		if (spyHolderSnapshot != null) {
			spyHolderSnapshot.getBoundingClientRectAsync()!.then((hrect: DOMRect) => {
				holderTop = hrect.top
				done()
			})
		} else {
			done()
		}
		navEl.getBoundingClientRectAsync()!.then((nrect: DOMRect) => {
			navH = nrect.height
			done()
		})
		// #endif
		// #endif
	}

	/**
	 * 交互路径切换激活项（before-change 拦截在点击处理器完成）
	 */
	const setActive = (index: number) => {
		if (index < 0 || index >= navItems.value.length) return
		if (index == activeIndex.value) return
		activeIndex.value = index
		emit('update:active', itemIdent(index))
		emit('change', navItems.value[index].name, index)
	}

	/** 点击标签：click-tab 恒派发（含禁用）；before-change 拦截；scrollspy 先滚动定位 */
	const onTitleClick = (item: TabItem, index: number) => {
		const event: TabsClickEvent = { index: index, name: item.name, title: item.title, disabled: item.disabled }
		emit('click-tab', event)
		if (item.disabled) return
		if (props.beforeChange != null && !props.beforeChange(item.name, index)) return
		if (props.scrollspy) {
			// 先直接激活（点击即反馈），再尝试滚动定位；页面级滚动下定位后 scrollspy 判定二次确认同一项
			// 注意：必须调用 scrollToIndex——scrollTo 只是 defineExpose 的属性名，裸调用会被 Web 端解析为全局 window.scrollTo（索引被当滚动坐标，页面级滚动场景完全无效）
			setActive(index)
			scrollToIndex(index)
			return
		}
		setActive(index)
	}

	// ========== 渲染协议与动画编排 ==========

	/**
	 * 全量激活集合（lazyRender=false / scrollspy 平铺：所有注册项可渲染）
	 */
	function fillEverSet() {
		const all: number[] = []
		for (let i = 0; i < ctx.items.value.length; i++) all.push(i)
		ctx.everSet.value = all
	}

	/**
	 * 独立底部条落位 / 平移（animateLine 测量结果的应用，Web 同步 / 异步双路径共用）
	 *
	 * @param el 底部条节点
	 * @param to 目标平移位置（px，相对标题行原点）
	 */
	function applyLine(el: UniElement, to: number) {
		if (firstSet || props.duration <= 0) {
			firstSet = false
			lineLeft.value = to
			return
		}
		const from = lineLeft.value
		lineLeft.value = to
		if (from == to) return
		// #ifndef MP
		// 小程序端 UniElement.animate 的 transform keyframes 支持未证实（vendor 实现按 id 桥接
		// 原生节点），保守直接落位（lineStyle 响应式驱动位置正确，仅切换动画降级）
		const keyframes: UniAnimationKeyframe[] = [
			{ transform: 'translateX(' + from.toString() + 'px)', offset: 0 },
			{ transform: 'translateX(' + to.toString() + 'px)', offset: 1 }
		]
		el.animate(keyframes, { duration: Math.round(props.duration * 1000) })
		// #endif
	}

	/**
	 * 独立底部条定位（测量制）：实测激活标题中心相对条定位父级（nav）的偏移 - 条宽一半
	 *
	 * 标题行内 nav-left / nav-right 插槽占位后，均匀槽位公式 (i + 0.5) * selfWidth / n
	 * 与标签真实中心失差（实测插槽实例偏左约半个条宽），改为按 id 深度优先查找激活标题
	 * 元素实测定位（包装层数量不敏感）。line 与 titles 分属 nav 的不同子树（titles 在
	 * scroll-view 内），测量基准统一取 line 的定位父级（el.parentElement，即 nav），
	 * 与渲染原点（left: 0 + translateX）严格一致。首次直接落位；切换走 UniElement.animate 平移。
	 */
	function animateLine(oldIndex: number, newIndex: number) {
		if (!freeLineMode.value) return
		const el = lineRef.value
		if (el == null) return
		const lw = props.lineWidth != '' ? parsePx(props.lineWidth) : 40
		// #ifdef MP
		// 小程序端：按 id 组件实例作用域查询（标签栏原点 + 激活标题；line 不可遍历）
		queryRectById('m-tabs-nav', (navRect: DOMRect | null) => {
			if (navRect == null) return
			queryRectById('m-tabs-tab-' + newIndex.toString(), (trect: DOMRect | null) => {
				if (trect == null) return
				applyLine(el, trect.left + trect.width / 2 - navRect.left - lw / 2)
			})
		})
		// #endif
		// #ifndef MP
		const navEl = el.parentElement
		if (navEl == null) return
		const titleEl = findDescendantById(navEl, 'm-tabs-tab-' + newIndex.toString())
		if (titleEl == null) return
		// #ifdef WEB
		const navRect = navEl.getBoundingClientRect()
		const trect = titleEl.getBoundingClientRect()
		applyLine(el, trect.left + trect.width / 2 - navRect.left - lw / 2)
		// #endif
		// #ifndef WEB
		titleEl.getBoundingClientRectAsync()!.then((trect: DOMRect) => {
			navEl.getBoundingClientRectAsync()!.then((navRect: DOMRect) => {
				applyLine(el, trect.left + trect.width / 2 - navRect.left - lw / 2)
			})
		})
		// #endif
		// #endif
	}

	/**
	 * 内容轨道动画：renderSet 过渡期两可见子项并排，整体平移后收缩为单项
	 */
	function animateTrack(oldIndex: number, newIndex: number) {
		if (!trackMode.value || gesturing.value) return
		if (oldIndex < 0 || oldIndex == newIndex) return
		// 起始帧：渲染集合已含新旧两项，DOM 序 min 在左 max 在右
		nextTick(() => {
			const el = trackRef.value
			if (el == null || selfWidth.value <= 0) return
			const rightward = newIndex > oldIndex
			const from = rightward ? 0 : -selfWidth.value
			const to = rightward ? -selfWidth.value : 0
			if (props.duration <= 0) {
				ctx.renderSet.value = [newIndex]
				trackOffset.value = 0
				return
			}
			const keyframes: UniAnimationKeyframe[] = [
				{ transform: 'translateX(' + from.toString() + 'px)', offset: 0 },
				{ transform: 'translateX(' + to.toString() + 'px)', offset: 1 }
			]
			el.animate(keyframes, { duration: Math.round(props.duration * 1000), easing: 'ease' })
			setTimeout(() => {
				// 动画完成收缩渲染集合（旧项 display none 后轨道自然归零位）
				ctx.renderSet.value = [newIndex]
				trackOffset.value = 0
			}, Math.round(props.duration * 1000))
		})
	}

	// 激活变化编排（flush: post 确保新状态渲染后再测量 / 动画）
	watch(activeIndex, (nv: number, ov: number) => {
		// 渲染协议更新
		if (props.scrollspy) {
			fillEverSet()
		} else if (trackMode.value) {
			const ever = ctx.everSet.value
			if (ever.indexOf(nv) < 0) ever.push(nv)
			ctx.everSet.value = ever
			if (ov >= 0 && ov != nv) {
				ctx.renderSet.value = [ov, nv]
			} else {
				ctx.renderSet.value = [nv]
			}
		} else {
			const ever = ctx.everSet.value
			if (ever.indexOf(nv) < 0) ever.push(nv)
			ctx.everSet.value = ever
			ctx.renderSet.value = [nv]
		}
		animateLine(ov, nv)
		animateTrack(ov, nv)
		centerActiveTab()
	}, { flush: 'post' })

	// ========== swipeable 手势 ==========

	/** 手势起点 x */
	let touchStartX = 0
	/** 手势起点 y（判定滑动方向排除纵向滚动干扰） */
	let touchStartY = 0
	/** 方向已锁定（|dx| 超过判定阈值后锁定横向手势） */
	let touchLocked = false
	/** 手势锁定的切换目标（-1 未定） */
	let gestureTarget = -1

	const onTouchStart = (e: TouchEvent) => {
		if (!props.swipeable || trackMode.value == false) return
		const t = e.touches[0]
		touchStartX = t.clientX
		touchStartY = t.clientY
		touchLocked = false
		gestureTarget = -1
	}

	const onTouchMove = (e: TouchEvent) => {
		if (!props.swipeable || !trackMode.value || activeIndex.value < 0) return
		const t = e.touches[0]
		const dx = t.clientX - touchStartX
		const dy = t.clientY - touchStartY
		if (!touchLocked) {
			if (dy * dy > dx * dx) return
			if (dx * dx < 400) return
			touchLocked = true
			gesturing.value = true
			// 预渲染相邻目标（两侧都入渲染集合，方向由首个 move 决定）
			const cur = activeIndex.value
			const set: number[] = [cur]
			if (cur > 0) set.push(cur - 1)
			if (cur < navItems.value.length - 1) set.push(cur + 1)
			ctx.renderSet.value = set
		}
		// 边界阻尼：无相邻项方向位移减半
		let limit = dx
		const cur = activeIndex.value
		if (dx < 0 && cur >= navItems.value.length - 1) limit = dx / 2
		if (dx > 0 && cur <= 0) limit = dx / 2
		trackOffset.value = limit
	}

	const onTouchEnd = (e: TouchEvent) => {
		if (!touchLocked) return
		touchLocked = false
		const dx = trackOffset.value
		// 跟手阶段结束：先复位标记，动画由 watch 编排或回弹承担
		gesturing.value = false
		const cur = activeIndex.value
		if (dx < 0 && cur < navItems.value.length - 1 && dx * -1 > selfWidth.value / 3) {
			// 向左滑 → 下一项（手势切换不经 before-change）
			gestureTarget = cur + 1
		} else if (dx > 0 && cur > 0 && dx > selfWidth.value / 3) {
			gestureTarget = cur - 1
		} else {
			gestureTarget = -1
		}
		if (gestureTarget >= 0) {
			activeIndex.value = gestureTarget
			emit('update:active', itemIdent(gestureTarget))
			emit('change', navItems.value[gestureTarget].name, gestureTarget)
		} else {
			// 回弹：从当前偏移动画归零，渲染集合收缩回当前项
			const el = trackRef.value
			if (el != null && props.duration > 0) {
				const keyframes: UniAnimationKeyframe[] = [
					{ transform: 'translateX(' + dx.toString() + 'px)', offset: 0 },
					{ transform: 'translateX(0px)', offset: 1 }
				]
				el.animate(keyframes, { duration: Math.round(props.duration * 1000), easing: 'ease' })
			}
			setTimeout(() => {
				ctx.renderSet.value = [cur]
				trackOffset.value = 0
			}, Math.round(props.duration * 1000))
		}
	}

	// ========== sticky / scrollspy ==========

	const onStickyChange = (isFixed: boolean) => {
		emit('sticky-change', isFixed)
	}

	/**
	 * 应用 scrollspy 判定结果（resolveScrollSpy 的 Web 同步 / 异步双路径共用）
	 *
	 * @param tops 注册序 → 内容块视口顶边距离
	 * @param base 判定基准线（标签栏底边的视口位置，吸附态含容器顶偏移）
	 */
	function applyScrollSpy(tops: Map<number, number>, base: number) {
		const items = ctx.items.value
		let cur = 0
		for (let i = 0; i < items.length; i++) {
			const top = tops.get(i)
			if (top == null) continue
			if (top - base <= 4) cur = i
		}
		if (cur != activeIndex.value) {
			activeIndex.value = cur
			emit('update:active', itemIdent(cur))
			emit('change', items[cur].name, cur)
		}
	}

	/**
	 * scrollspy 滚动判定：以「吸顶标签栏底边」为基准线（滚动视口顶 + offset-top +
	 * 标签栏高，吸附态即标签栏 fixed 的底边位置），最后一个顶边越过基准线的内容块
	 * 激活——语义即「基准线落在哪个内容块区间」。
	 *
	 * 注意两点：不能直接用 offset-top 作基准（内容区常处于非零视口偏移的滚动容器中，
	 * 实测 holder 顶边在 44px 页面导航下方，判定会整体错位一个容器偏移）；也不能用
	 * 标签栏实时 rect（scroll 事件触发判定时 m-sticky 可能尚未切换吸附态，标签栏还在
	 * 文档流位置，基准线会随吸附时序漂移）——故用容器顶偏移 + offset-top + 标签栏高
	 * 这组稳定量拼出吸附位，与吸附切换时序解耦。
	 *
	 * Web 端同步测量；App / 小程序端 UniElement 无同步 getBoundingClientRect，
	 * 走 getBoundingClientRectAsync 批量测量后统一判定（平台分支对齐 m-sticky）。
	 */
	function resolveScrollSpy() {
		const items = ctx.items.value
		if (items.length == 0) return
		const navEl = navRef.value
		if (navEl == null) return
		// #ifdef MP
		// 小程序端：滚动容器不可探测（holderTop 取 0，页面级滚动语义），全部按 id 查询
		let pending = 0
		let navH = 0
		const tops = new Map<number, number>()
		const done = () => {
			pending--
			if (pending == 0) applyScrollSpy(tops, props.offsetTop + navH)
		}
		pending++
		queryRectById('m-tabs-nav', (nrect: DOMRect | null) => {
			if (nrect != null) navH = nrect.height
			done()
		})
		for (let i = 0; i < items.length; i++) {
			pending++
			queryRectById('m-tabs-pane-' + items[i].index.toString(), (prect: DOMRect | null) => {
				if (prect != null) tops.set(i, prect.top)
				done()
			})
		}
		// #endif
		// #ifndef MP
		ensureSpyHolder()
		// #ifdef WEB
		const tops = new Map<number, number>()
		for (let i = 0; i < items.length; i++) {
			const el = ctx.paneEls.get(items[i].key)
			if (el != null) tops.set(i, el.getBoundingClientRect().top)
		}
		const navH = navEl.getBoundingClientRect().height
		const holderTop = spyHolder != null ? spyHolder.getBoundingClientRect().top : 0
		applyScrollSpy(tops, holderTop + props.offsetTop + navH)
		// #endif
		// #ifndef WEB
		const tops = new Map<number, number>()
		let pendingAsync = 0
		let navHAsync = 0
		let holderTop = 0
		const doneAsync = () => {
			pendingAsync--
			if (pendingAsync == 0) applyScrollSpy(tops, holderTop + props.offsetTop + navHAsync)
		}
		pendingAsync++
		navEl.getBoundingClientRectAsync()!.then((nrect: DOMRect) => {
			navHAsync = nrect.height
			doneAsync()
		})
		// spyHolder 是被闭包捕获的可变局部变量，Kotlin 禁止对它 smart cast——使用点先读入不可变快照
		const spyHolderSnapshot = spyHolder
		if (spyHolderSnapshot != null) {
			pendingAsync++
			spyHolderSnapshot.getBoundingClientRectAsync()!.then((hrect: DOMRect) => {
				holderTop = hrect.top
				doneAsync()
			})
		}
		for (let i = 0; i < items.length; i++) {
			const el = ctx.paneEls.get(items[i].key)
			if (el == null) continue
			pendingAsync++
			el.getBoundingClientRectAsync()!.then((rect: DOMRect) => {
				tops.set(i, rect.top)
				doneAsync()
			})
		}
		// #endif
		// #endif
	}

	// scroll-top 回灌驱动 scrollspy 判定（页面滚动事件 → scroll-top prop → 此处联动）
	watch((): number => props.scrollTop, (_: number) => {
		if (props.scrollspy) resolveScrollSpy()
	})

	/**
	 * 实测容器宽度（底部条位置与轨道平移距离依据）
	 *
	 * selfWidth 仅被 freeLine 布局（独立底部条平移）与 swipeable（轨道平移 / 手势阈值）消费，
	 * 其余场景跳过测量；Web 端同步测量，App / 小程序端 UniElement 无同步 getBoundingClientRect，
	 * 走 getBoundingClientRectAsync（平台分支对齐 m-sticky 同名机制）。
	 */
	function measureWidth() {
		if (!freeLineMode.value && !props.swipeable) return
		const el = rootRef.value
		if (el == null) return
		// #ifdef WEB
		selfWidth.value = el.getBoundingClientRect().width
		// #endif
		// #ifndef WEB
		el.getBoundingClientRectAsync()!.then((rect: DOMRect) => {
			selfWidth.value = rect.width
		})
		// #endif
	}

	/** 注册项集合变化：激活越界校正 + 全渲染协议补全 + 底部条重测 */
	watch(ctx.items, () => {
		const n = ctx.items.value.length
		if (n == 0) return
		if (props.scrollspy || !props.lazyRender) fillEverSet()
		if (activeIndex.value >= n) activeIndex.value = n - 1
		if (activeIndex.value < 0) activeIndex.value = resolveActive(props.active)
		if (!trackMode.value && ctx.renderSet.value.indexOf(activeIndex.value) < 0) {
			ctx.renderSet.value = [activeIndex.value]
		}
		measureWidth()
		animateLine(activeIndex.value, activeIndex.value)
	}, { flush: 'post' })

	onMounted(() => {
		measureWidth()
		// 初始激活解析与渲染集合初始化
		const init = resolveActive(props.active)
		if (init >= 0) activeIndex.value = init
		if (props.scrollspy || !props.lazyRender) {
			fillEverSet()
			ctx.renderSet.value = [activeIndex.value >= 0 ? activeIndex.value : 0]
		}
		if (activeIndex.value >= 0 && !trackMode.value) {
			ctx.renderSet.value = [activeIndex.value]
		}
		centerActiveTab()
		// 首帧底部条定位：options 形态没有 m-tab 子组件，ctx.items 恒为空，
		// watch(ctx.items) 不会触发 animateLine；初始 activeIndex 与解析结果相同也不会
		// 触发 watch(activeIndex)，需在挂载渲染完成后主动定位一次（firstSet 首次直接落位，无动画）
		nextTick(() => {
			animateLine(activeIndex.value, activeIndex.value)
		})
	})

	defineExpose({
		/**
		 * 滚动定位到指定标签（scrollspy 模式：name 或索引）
		 */
		scrollTo: (target: string | number) => {
			const idx = resolveActive(target)
			scrollToIndex(idx)
		}
	})
</script>

<style lang="scss">
	@import '../../theme/vars.scss';

	/* ========== 根 ========== */
	.m-tabs {
		flex-direction: column;
		background-color: $m-tabs-background;
	}

	/* ========== 标签栏 ========== */
	.m-tabs__nav {
		position: relative;
		flex-direction: row;
		align-items: center;
		height: $m-tabs-tab-height;
		background-color: $m-tabs-background;
	}
	/* card 卡片壳：内缩留白 + 整组圆角边框 */
	.m-tabs__nav--card {
		height: $m-tabs-card-height + 8px;
		padding: 4px 8px;
	}
	.m-tabs__nav--pill {
		height: $m-tabs-pill-height + 8px;
		padding: 4px 8px;
	}
	/* line 外边框（仅 line 风格） */
	.m-tabs__nav--border {
		border-bottom: $m-border-width solid $m-tabs-border-color;
	}
	.m-tabs__nav-extra {
		flex-direction: row;
		align-items: center;
	}
	.m-tabs__nav-scroll {
		flex: 1;
		height: 100%;
	}
	/* #ifdef WEB */
	/* uni-h5 运行时的 show-scrollbar=false 仅在内部滚动层追加 uni-scroll-view-scrollbar-hidden
	   类，隐藏滚动条的 CSS 在运行时样式表里缺失（::-webkit-scrollbar 全库 0 处）——横向滚动时
	   浏览器默认滚动条会显示，组件内兜底隐藏（内部滚动层是非模板包装节点，须后代选择器穿透；
	   仅 Web 端编译，App 端不受 ucss 后代选择器约束） */
	.m-tabs__nav-scroll .uni-scroll-view {
		scrollbar-width: none;
	}
	.m-tabs__nav-scroll .uni-scroll-view::-webkit-scrollbar {
		display: none;
	}
	/* #endif */
	.m-tabs__nav-row--equal {
		flex-direction: row;
		height: 100%;
		/* 独立底部条（.m-tabs__line）的定位基准：行内 nav 插槽占位后行原点 != nav 原点，
		   行自身定位后 translateX 测量制（animateLine）才与渲染原点一致 */
		position: relative;
	}
	.m-tabs__nav-row--scroll {
		flex-direction: row;
		height: 100%;
		position: relative;
		/* view 默认 overflow hidden 会把溢出标题裁在行内，scroll-view 的滚动区域因此看不到
		   溢出内容（scrollWidth == offsetWidth），scroll-left / 触摸滚动全被钳死——放行溢出，
		   裁剪交由 scroll-view（真实滚动层）负责 */
		overflow: visible;
	}

	/* ========== 标题项 ========== */
	.m-tabs__title {
		position: relative;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		height: 100%;
	}
	.m-tabs__title--equal {
		flex: 1;
	}
	.m-tabs__title--scroll {
		flex: none;
		padding: 0 16px;
	}
	.m-tabs__title--card {
		height: $m-tabs-card-height;
		border-radius: $m-tabs-card-radius;
	}
	.m-tabs__title--pill {
		height: $m-tabs-pill-height;
		border-radius: $m-tabs-pill-radius;
	}
	.m-tabs__title--active {
		font-weight: bold;
	}
	.m-tabs__title--card-active {
		background-color: $m-color-primary;
	}
	.m-tabs__title--pill-active {
		background-color: $m-color-primary;
	}
	.m-tabs__title--disabled {
		opacity: $m-disabled-opacity;
	}
	.m-tabs__title-text {
		font-size: $m-tabs-tab-font-size;
		color: $m-tabs-tab-color;
	}
	.m-tabs__title-text--active {
		color: $m-tabs-tab-active-color;
	}
	.m-tabs__title-text--ellipsis {
		lines: 1;
		text-overflow: ellipsis;
	}
	.m-tabs__title-text--filled {
		color: $m-white;
	}
	/* 徽标：右上角悬浮，不挤压标题布局 */
	.m-tabs__title-badge-wrap {
		position: absolute;
		top: 2px;
		right: 6px;
		flex-direction: row;
	}

	/* ========== 底部条 ========== */
	/* 独立条（平分 line 布局）：绝对定位 + translateX 平移（动画走 UniElement.animate） */
	.m-tabs__line {
		position: absolute;
		bottom: 0;
		left: 0;
		width: $m-tabs-line-width;
		height: $m-tabs-line-height;
		border-radius: $m-tabs-line-radius;
		background-color: $m-color-primary;
	}
	/* 内嵌条（滚动 / 收缩布局）：激活标题内底部 */
	.m-tabs__title-line {
		position: absolute;
		bottom: 0;
		left: 50%;
		/* left: 50% 钉的是条左缘，须回退自身半宽居中（translateX 相对自身宽，适配任意 line-width） */
		transform: translateX(-50%);
		width: $m-tabs-line-width;
		height: $m-tabs-line-height;
		border-radius: $m-tabs-line-radius;
		background-color: $m-color-primary;
	}

	/* ========== 内容区 ========== */
	.m-tabs__viewport {
		flex: 1;
		overflow: hidden;
	}
	.m-tabs__track {
		width: 100%;
	}
	.m-tabs__track--row {
		flex-direction: row;
		width: 100%;
	}
	.m-tabs__track--scrollspy {
		flex-direction: column;
		width: 100%;
	}
	/* 轨道子项：等宽占位，平移载体 */
	.m-tabs__pane--track {
		flex: none;
		width: 100%;
		flex-shrink: 0;
	}
	/* scrollspy 平铺子项 */
	.m-tabs__pane--scrollspy {
		width: 100%;
	}
</style>
