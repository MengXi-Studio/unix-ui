<template>
	<view :class="buttonClass" :style="rootStyle" :hover-class="hoverClass" @click="handleClick">
		<!-- 0.5px 细边框层：ucss 无伪元素，用绝对定位 view 承载 1px 边框后 scale(0.5) 实现 -->
		<view v-if="props.hairline" :class="hairlineClass" :style="hairlineStyle"></view>
		<!-- 加载图标：UniElement.animate 旋转（ucss 不支持 @keyframes） -->
		<view v-if="props.loading" ref="loadingIcon" :class="loadingClass" :style="loadingStyle">
			<!-- clock 型：圆环静止，指针子节点绕圆心旋转（circular 型为圆环整体旋转，无子节点） -->
			<view v-if="props.loadingType == 'clock'" ref="loadingHand" :class="loadingHandClass" :style="loadingHandStyle"></view>
			<!-- spinner 型：12 条辐条亮度递减成拖尾，随容器 steps(12) 离散旋转（对齐 Vant 花瓣加载） -->
			<view v-for="i in spokeCount" :key="i" :class="loadingSpokeClass" :style="loadingSpokeStyle(i)"></view>
		</view>
		<!-- 按钮内容：加载中显示 loadingText，否则渲染默认插槽 -->
		<text v-if="props.loading && props.loadingText != ''" :class="textClass">{{ props.loadingText }}</text>
		<text v-else-if="!props.loading" :class="textClass"><slot></slot></text>
	</view>
</template>

<script setup lang="uts">
	/** 按钮类型：default 默认 / primary 主要 / success 成功 / warning 警告 / danger 危险 */
	type ButtonType = 'default' | 'primary' | 'success' | 'warning' | 'danger'
	/** 按钮尺寸：large 大 / normal 常规 / small 小 / mini 迷你 */
	type ButtonSize = 'large' | 'normal' | 'small' | 'mini'
	/** 加载图标类型：circular 圆环（整体旋转）/ clock 时钟指针（圆环静止 + 指针旋转）/ spinner 花瓣（12 条辐条亮度递减拖尾，容器 steps(12) 离散旋转，对齐 Vant Loading） */
	type LoadingType = 'circular' | 'clock' | 'spinner'

	type Props = {
		/** 按钮类型 */
		type?: ButtonType
		/** 按钮尺寸 */
		size?: ButtonSize
		/** 朴素按钮：文字与边框使用主题色，背景为白色 */
		plain?: boolean
		/** 圆形按钮（全圆角） */
		round?: boolean
		/** 方形按钮（无圆角） */
		square?: boolean
		/** 是否禁用：禁用时不触发 click 事件 */
		disabled?: boolean
		/** 是否使用 0.5px 细边框 */
		hairline?: boolean
		/** 是否为块级元素（宽度撑满父容器） */
		block?: boolean
		/** 是否处于加载状态：加载中不触发 click 事件并隐藏插槽内容 */
		loading?: boolean
		/** 加载状态提示文字，为空时仅显示加载图标 */
		loadingText?: string
		/** 加载图标类型 */
		loadingType?: LoadingType
		/** 自定义颜色，支持 #hex 与 linear-gradient 渐变 */
		color?: string
		/** 自定义根节点类名 */
		customClass?: string.ClassString
		/** 自定义根节点内联样式 */
		customStyle?: string
	}

	const props = withDefaults(defineProps<Props>(), {
		type: 'default',
		size: 'normal',
		plain: false,
		round: false,
		square: false,
		disabled: false,
		hairline: false,
		block: false,
		loading: false,
		loadingText: '',
		loadingType: 'circular',
		color: '',
		customClass: '',
		customStyle: ''
	})

	const emit = defineEmits<{ click: [event: MouseEvent] }>()

	/** 加载图标元素引用（用于启动旋转动画） */
	const loadingIcon = ref<UniElement | null>(null)

	/** clock 型指针元素引用（用于启动指针旋转动画） */
	const loadingHand = ref<UniElement | null>(null)

	/** 当前加载动画句柄（切换 loadingType 时取消旧动画，避免旧目标元素永续旋转） */
	let loadingAnimation: Animation | null = null

	/**
	 * 启动加载动画
	 * circular：圆环整体旋转；clock：仅指针旋转、圆环静止；spinner：辐条随容器离散旋转
	 * 通过 UniElement.animate 实现（ucss 禁用 @keyframes，规则要求改用 animate API）
	 */
	function startLoadingAnimation() {
		// 切换动画目标前先取消旧动画（如 loading 期间动态切换 loadingType）
		loadingAnimation?.cancel()
		// clock 型动画目标是子指针，circular / spinner 型是图标容器本身（圆环 / 辐条随容器旋转）
		const el = props.loadingType == 'clock' ? loadingHand.value : loadingIcon.value
		if (el == null) return
		// spinner 型用 steps(12) 离散旋转：配合辐条 30° 均布与亮度拖尾，呈现 Vant 的滴答式彗尾效果（其余类型匀速）
		const easing = props.loadingType == 'spinner' ? 'steps(12)' : 'linear'
		loadingAnimation = el.animate(
			[
				{ transform: 'rotate(0deg)' },
				{ transform: 'rotate(360deg)' }
			],
			{ duration: 800, iterations: Infinity, easing: easing }
		)
	}

	// 初始即为加载状态时启动动画（onMounted 时元素已完成挂载）
	onMounted(() => {
		if (props.loading) startLoadingAnimation()
	})

	// 动态开启加载状态时启动动画（flush: post 确保元素已挂载后再取 ref）
	watch(
		() => props.loading,
		(value: boolean) => {
			if (value) startLoadingAnimation()
		},
		{ flush: 'post' }
	)

	// loading 期间动态切换加载图标类型时重启动画（flush: post 确保指针元素已挂载）
	watch(
		() => props.loadingType,
		(_: LoadingType) => {
			if (props.loading) startLoadingAnimation()
		},
		{ flush: 'post' }
	)

	/**
	 * 点击事件处理
	 * 禁用或加载中不触发
	 */
	function handleClick(event: MouseEvent) {
		if (props.disabled || props.loading) return
		emit('click', event)
	}

	/** 根节点类名：BEM 变体类按 props 状态组合 */
	const buttonClass = computed<string>(() => {
		let cls = 'mxi-button mxi-button--' + props.type
		if (props.size != 'normal') cls += ' mxi-button--' + props.size
		if (props.plain) cls += ' mxi-button--plain'
		if (props.hairline) cls += ' mxi-button--hairline'
		if (props.square) cls += ' mxi-button--square'
		if (props.round) cls += ' mxi-button--round'
		if (props.block) cls += ' mxi-button--block'
		if (props.disabled) cls += ' mxi-button--disabled'
		if (props.loading) cls += ' mxi-button--loading'
		if (props.color != '') cls += ' mxi-button--colored'
		if (props.customClass != '') cls += ' ' + props.customClass
		return cls
	})

	/** 根节点动态样式：customStyle + 自定义颜色时的背景与边框 */
	const rootStyle = computed<string>(() => {
		// 自定义样式补分号，避免与动态样式拼接粘连
		let style = props.customStyle
		if (style != '' && !style.endsWith(';')) style += ';'
		if (props.color == '') return style
		if (props.plain) {
			// 朴素按钮：仅边框使用自定义颜色，背景保持白色
			style += 'border-color: ' + props.color + ';'
		} else if (props.color.indexOf('linear-gradient') == 0) {
			// 渐变色只能作为背景图渲染，边框透明
			style += 'background-image: ' + props.color + '; border-color: transparent;'
		} else {
			style += 'background-color: ' + props.color + '; border-color: ' + props.color + ';'
		}
		return style
	})

	/** 文字类名：字号随尺寸、颜色随类型 / 朴素 / 自定义色切换 */
	const textClass = computed<string>(() => {
		let cls = 'mxi-button__text mxi-button__text--' + props.size
		if (props.color != '') {
			// 自定义颜色：实色为白字，朴素由 textStyle 动态控制颜色
			cls += props.plain ? ' mxi-button__text--colored-plain' : ' mxi-button__text--white'
		} else if (!props.plain && props.type != 'default') {
			// 实色主题按钮为白字
			cls += ' mxi-button__text--white'
		} else {
			// default 类型与朴素按钮使用类型主题色
			cls += ' mxi-button__text--' + props.type
		}
		return cls
	})

	/** 文字动态样式：自定义颜色 + 朴素时文字使用自定义颜色 */
	const textStyle = computed<string>(() => {
		if (props.color != '' && props.plain) return 'color: ' + props.color + ';'
		return ''
	})

	/** 加载图标颜色变体名：与文字颜色逻辑一致（colored-plain 变体颜色走 inline style） */
	const loadingVariant = computed<string>(() => {
		if (props.color != '') return props.plain ? 'colored-plain' : 'white'
		if (!props.plain && props.type != 'default') return 'white'
		return props.type
	})

	/** 加载图标类名：circular 为带顶部高亮的旋转圆环；clock 为均匀轨道的静止圆环；spinner 无圆环轨道（颜色由辐条承载） */
	const loadingClass = computed<string>(() => {
		if (props.loadingType == 'clock') return 'mxi-button__loading mxi-button__loading-clock--' + loadingVariant.value
		if (props.loadingType == 'spinner') return 'mxi-button__loading mxi-button__loading-spinner'
		return 'mxi-button__loading mxi-button__loading--' + loadingVariant.value
	})

	/** clock 型指针类名：颜色与圆环变体保持一致 */
	const loadingHandClass = computed<string>(() => {
		return 'mxi-button__loading-hand mxi-button__loading-hand--' + loadingVariant.value
	})

	/** 加载图标动态样式：自定义颜色 + 朴素时边框使用自定义颜色 */
	const loadingStyle = computed<string>(() => {
		if (props.color != '' && props.plain) return 'border-color: ' + props.color + ';'
		return ''
	})

	/** clock 型指针动态样式：自定义颜色 + 朴素时指针使用自定义颜色 */
	const loadingHandStyle = computed<string>(() => {
		if (props.color != '' && props.plain) return 'background-color: ' + props.color + ';'
		return ''
	})

	/** spinner 型辐条渲染数量：仅 spinner 型渲染 12 条，其余类型为 0（不产生节点） */
	const spokeCount = computed<number>(() => props.loadingType == 'spinner' ? 12 : 0)

	/** spinner 型辐条类名：颜色与圆环变体保持一致（colored-plain 变体颜色走 inline style） */
	const loadingSpokeClass = computed<string>(() => {
		return 'mxi-button__loading-spoke mxi-button__loading-spoke--' + loadingVariant.value
	})

	/**
	 * spinner 型辐条动态样式：每 30° 一条绕圆心均匀分布，亮度按 Vant 规则递减形成拖尾
	 * （第 i 条 opacity = 1 - 0.0625 × (i - 1)，首条 1.0 递减至末条 0.3125）；自定义颜色 + 朴素时颜色走 inline
	 */
	function loadingSpokeStyle(index: number): string {
		let style = 'transform: rotate(' + ((index - 1) * 30) + 'deg);'
		style += ' opacity: ' + (1 - 0.0625 * (index - 1)) + ';'
		if (props.color != '' && props.plain) style += ' background-color: ' + props.color + ';'
		return style
	}

	/** 细边框层类名：圆角随 square / round、颜色随类型切换 */
	const hairlineClass = computed<string>(() => {
		let cls = 'mxi-button__hairline'
		if (props.square) cls += ' mxi-button__hairline--square'
		else if (props.round) cls += ' mxi-button__hairline--round'
		if (props.color != '') return cls + ' mxi-button__hairline--colored'
		return cls + ' mxi-button__hairline--' + props.type
	})

	/** 细边框层动态样式：自定义颜色时边框使用自定义颜色 */
	const hairlineStyle = computed<string>(() => {
		if (props.color == '') return ''
		return 'border-color: ' + props.color + ';'
	})

	/** 按压态类名：由 view 的 hover-class 在按压期间挂载；禁用或加载中不出现点击态（"none" 为官方约定的无点击态值） */
	const hoverClass = computed<string>(() => {
		if (props.disabled || props.loading) return 'none'
		return 'mxi-button--active'
	})
</script>

<style lang="scss">
	/*
	 * 主题变量说明（默认主题内置 + 变量覆盖）：
	 * 组件内顶层引入 theme/vars.scss（全部 !default），用户零配置即有默认主题；
	 * 覆盖方式：项目根 uni.scss 直接定义 $mxi-* 变量（禁止 @import vars.scss——
	 * uni.scss 会注入每个组件样式，与组件内引入同一文件将触发循环导入）。
	 * !default 语义保证用户定义值优先于默认值，与注入先后顺序无关。
	 */
	@import '../../theme/vars.scss';

	/* ========== 根节点 ========== */
	.mxi-button {
		position: relative;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		align-self: flex-start;
		height: $mxi-button-normal-height;
		padding: $mxi-button-normal-padding;
		border-width: $mxi-border-width;
		border-style: solid;
		border-radius: $mxi-button-radius;
		overflow: hidden;
		/* #ifdef WEB */
		cursor: pointer;
		/* #endif */
	}

	/* ========== 尺寸 ========== */
	.mxi-button--mini {
		height: $mxi-button-mini-height;
		padding: $mxi-button-mini-padding;
	}
	.mxi-button--small {
		height: $mxi-button-small-height;
		padding: $mxi-button-small-padding;
	}
	.mxi-button--large {
		height: $mxi-button-large-height;
		padding: $mxi-button-large-padding;
	}

	/* ========== 类型（背景与边框同色，视觉上无边框） ========== */
	.mxi-button--default {
		background-color: $mxi-color-default-bg;
		border-color: $mxi-color-default-border;
	}
	.mxi-button--primary {
		background-color: $mxi-color-primary;
		border-color: $mxi-color-primary;
	}
	.mxi-button--success {
		background-color: $mxi-color-success;
		border-color: $mxi-color-success;
	}
	.mxi-button--warning {
		background-color: $mxi-color-warning;
		border-color: $mxi-color-warning;
	}
	.mxi-button--danger {
		background-color: $mxi-color-danger;
		border-color: $mxi-color-danger;
	}

	/* ========== 形态变体 ========== */
	.mxi-button--plain {
		background-color: $mxi-white;
	}
	.mxi-button--hairline {
		/* 0.5px 边框由 __hairline 层承载，根节点 1px 边框清零，避免叠加出双线 */
		border-width: 0;
	}
	.mxi-button--square {
		border-radius: 0;
	}
	.mxi-button--round {
		border-radius: $mxi-radius-max;
	}
	.mxi-button--block {
		align-self: stretch;
	}
	.mxi-button--disabled {
		opacity: $mxi-disabled-opacity;
	}

	/* ========== 按压态（hover-class 按压期间挂载） ========== */
	.mxi-button--active {
		opacity: $mxi-button-active-opacity;
	}

	/* ========== 文字 ========== */
	.mxi-button__text {
		font-weight: 500;
		line-height: 1.2;
	}
	.mxi-button__text--mini {
		font-size: $mxi-button-mini-font-size;
	}
	.mxi-button__text--small {
		font-size: $mxi-button-small-font-size;
	}
	.mxi-button__text--normal {
		font-size: $mxi-button-normal-font-size;
	}
	.mxi-button__text--large {
		font-size: $mxi-button-large-font-size;
	}
	.mxi-button__text--white {
		color: $mxi-white;
	}
	.mxi-button__text--default {
		color: $mxi-text-color;
	}
	.mxi-button__text--primary {
		color: $mxi-color-primary;
	}
	.mxi-button__text--success {
		color: $mxi-color-success;
	}
	.mxi-button__text--warning {
		color: $mxi-color-warning;
	}
	.mxi-button__text--danger {
		color: $mxi-color-danger;
	}

	/* ========== 加载图标 ========== */
	.mxi-button__loading {
		width: $mxi-button-icon-size;
		height: $mxi-button-icon-size;
		border-width: 2px;
		border-style: solid;
		border-radius: $mxi-radius-max;
		margin-right: 6px;
	}
	/* 半透明描边用 rgba($var, alpha) 从主题色派生，保证主题覆盖后加载图标跟随变化 */
	.mxi-button__loading--white {
		border-color: rgba($mxi-white, 0.35);
		border-top-color: $mxi-white;
	}
	.mxi-button__loading--default {
		border-color: rgba($mxi-text-color, 0.25);
		border-top-color: $mxi-text-color;
	}
	.mxi-button__loading--primary {
		border-color: rgba($mxi-color-primary, 0.25);
		border-top-color: $mxi-color-primary;
	}
	.mxi-button__loading--success {
		border-color: rgba($mxi-color-success, 0.25);
		border-top-color: $mxi-color-success;
	}
	.mxi-button__loading--warning {
		border-color: rgba($mxi-color-warning, 0.25);
		border-top-color: $mxi-color-warning;
	}
	.mxi-button__loading--danger {
		border-color: rgba($mxi-color-danger, 0.25);
		border-top-color: $mxi-color-danger;
	}

	/* ========== clock 型加载（圆环静止 + 指针旋转） ========== */
	/* clock 圆环为均匀半透明轨道（无顶部高亮），颜色变体与 circular 一一对应 */
	.mxi-button__loading-clock--white {
		border-color: rgba($mxi-white, 0.35);
	}
	.mxi-button__loading-clock--default {
		border-color: rgba($mxi-text-color, 0.25);
	}
	.mxi-button__loading-clock--primary {
		border-color: rgba($mxi-color-primary, 0.25);
	}
	.mxi-button__loading-clock--success {
		border-color: rgba($mxi-color-success, 0.25);
	}
	.mxi-button__loading-clock--warning {
		border-color: rgba($mxi-color-warning, 0.25);
	}
	.mxi-button__loading-clock--danger {
		border-color: rgba($mxi-color-danger, 0.25);
	}
	/* 指针：absolute 定位从圆心指向内缘，尺寸取百分比随图标尺寸等比缩放，绕自身底部（圆心）旋转 */
	.mxi-button__loading-hand {
		position: absolute;
		top: 5%;
		left: 45%;
		width: 10%;
		height: 45%;
		border-radius: 2px;
		transform-origin: 50% 100%;
	}
	.mxi-button__loading-hand--white {
		background-color: $mxi-white;
	}
	.mxi-button__loading-hand--default {
		background-color: $mxi-text-color;
	}
	.mxi-button__loading-hand--primary {
		background-color: $mxi-color-primary;
	}
	.mxi-button__loading-hand--success {
		background-color: $mxi-color-success;
	}
	.mxi-button__loading-hand--warning {
		background-color: $mxi-color-warning;
	}
	.mxi-button__loading-hand--danger {
		background-color: $mxi-color-danger;
	}

	/* ========== spinner 型加载（12 条花瓣辐条亮度拖尾，容器 steps(12) 离散旋转，对齐 Vant） ========== */
	/* 容器无圆环轨道（清零基础类边框），颜色由辐条承载 */
	.mxi-button__loading-spinner {
		border-width: 0;
	}
	/* 辐条：2px 固定宽（Vant 同款不随图标缩放）、40% 百分比圆角，水平居中于圆心正上方，
	   绕自身高度 200% 处（恰为容器中心）旋转分布；亮度拖尾 opacity 由运行时 inline style 按序号递减 */
	.mxi-button__loading-spoke {
		position: absolute;
		top: 0;
		left: 50%;
		width: 2px;
		height: 25%;
		margin-left: -1px;
		border-radius: 40%;
		transform-origin: 50% 200%;
	}
	.mxi-button__loading-spoke--white {
		background-color: $mxi-white;
	}
	.mxi-button__loading-spoke--default {
		background-color: $mxi-text-color;
	}
	.mxi-button__loading-spoke--primary {
		background-color: $mxi-color-primary;
	}
	.mxi-button__loading-spoke--success {
		background-color: $mxi-color-success;
	}
	.mxi-button__loading-spoke--warning {
		background-color: $mxi-color-warning;
	}
	.mxi-button__loading-spoke--danger {
		background-color: $mxi-color-danger;
	}

	/* ========== 0.5px 细边框层 ========== */
	.mxi-button__hairline {
		position: absolute;
		top: 0;
		left: 0;
		/* 尺寸取父容器 200%，以左上角为原点 scale(0.5) 后恰好铺满父容器，1px 边框视觉减半 */
		width: 200%;
		height: 200%;
		border-width: $mxi-border-width;
		border-style: solid;
		/* 元素为父容器两倍大，圆角需同步两倍（缩放后与根节点圆角对齐） */
		border-radius: $mxi-button-radius * 2;
		transform: scale(0.5);
		/* 默认中心原点缩放会偏移半个按钮，必须以左上角为原点 */
		transform-origin: 0 0;
	}
	.mxi-button__hairline--square {
		border-radius: 0;
	}
	.mxi-button__hairline--round {
		border-radius: $mxi-radius-max;
	}
	.mxi-button__hairline--default {
		border-color: $mxi-color-default-border;
	}
	.mxi-button__hairline--primary {
		border-color: $mxi-color-primary;
	}
	.mxi-button__hairline--success {
		border-color: $mxi-color-success;
	}
	.mxi-button__hairline--warning {
		border-color: $mxi-color-warning;
	}
	.mxi-button__hairline--danger {
		border-color: $mxi-color-danger;
	}
</style>
