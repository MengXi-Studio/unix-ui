<template>
	<view :class="rootClass" :style="rootStyle">
		<!-- 图标容器：仅承载尺寸与旋转动画；icon 插槽可替换默认图标，替换后旋转节奏不变 -->
		<view ref="spinnerRef" class="mxi-loading__spinner" :style="spinnerStyle">
			<slot name="icon">
				<!-- circular：弧段圆环（顶部单色弧 + 透明轨道），随容器匀速旋转 -->
				<view v-if="props.type == 'circular'" class="mxi-loading__ring" :style="ringStyle"></view>
				<!-- spinner：12 条辐条亮度递减成拖尾，随容器 steps(12) 离散旋转 -->
				<view v-for="i in spokeCount" :key="i" class="mxi-loading__spoke" :style="spokeStyle(i)"></view>
			</slot>
		</view>
		<!-- 加载文案：传入默认插槽内容时渲染，避免空文案节点产生多余间距 -->
		<text v-if="hasText" :class="textClass" :style="textStyle"><slot></slot></text>
	</view>
</template>

<script setup lang="uts">
	/** 加载类型：circular 弧段圆环（匀速旋转）/ spinner 花瓣（12 条辐条亮度拖尾，离散旋转） */
	type LoadingType = 'circular' | 'spinner'

	type Props = {
		/** 加载类型 */
		type?: LoadingType
		/** 加载图标颜色 */
		color?: string
		/** 加载图标大小，支持纯数字（自动补 px）或带单位字符串 */
		size?: string
		/** 是否垂直排列图标与文字 */
		vertical?: boolean
		/** 加载文案字号，支持纯数字（自动补 px）或带单位字符串 */
		textSize?: string
		/** 加载文案颜色 */
		textColor?: string
		/** 自定义根节点类名 */
		customClass?: string.ClassString
		/** 自定义根节点内联样式 */
		customStyle?: string
	}

	const props = withDefaults(defineProps<Props>(), {
		type: 'circular',
		color: '',
		size: '',
		vertical: false,
		textSize: '',
		textColor: '',
		customClass: '',
		customStyle: ''
	})

	const slots = useSlots()

	/** 图标容器元素引用（旋转动画作用目标） */
	const spinnerRef = ref<UniElement | null>(null)

	/** 当前旋转动画句柄（切换 type 时先取消旧动画再重启） */
	let animation: Animation | null = null

	/** spinner 型辐条数量：仅 spinner 型渲染 12 条，其余类型为 0（不产生节点） */
	const spokeCount = computed<number>(() => props.type == 'spinner' ? 12 : 0)

	/** 是否传入默认插槽内容（决定文案节点是否渲染） */
	const hasText = computed<boolean>(() => slots.default != null)

	/** 根节点类名：纵向排列与自定义类名按 props 拼接 */
	const rootClass = computed<string>(() => {
		let cls = 'mxi-loading'
		if (props.vertical) cls += ' mxi-loading--vertical'
		if (props.customClass != '') cls += ' ' + props.customClass
		return cls
	})

	/** 根节点动态样式：customStyle 补分号后拼接 */
	const rootStyle = computed<string>(() => {
		let style = props.customStyle
		if (style != '' && !style.endsWith(';')) style += ';'
		return style
	})

	/** 图标容器动态样式：size 非空时定宽高（纯数字自动补 px），为空时走主题默认尺寸 */
	const spinnerStyle = computed<string>(() => {
		if (props.size == '') return ''
		const side = addUnit(props.size)
		return 'width: ' + side + '; height: ' + side + ';'
	})

	/** 弧段圆环动态样式：自定义颜色时弧段（顶部边框）使用自定义颜色 */
	const ringStyle = computed<string>(() => {
		if (props.color == '') return ''
		return 'border-top-color: ' + props.color + ';'
	})

	/**
	 * spinner 型辐条动态样式：每 30° 一条绕圆心均匀分布，亮度按序号递减形成拖尾
	 * （第 i 条 opacity = 1 - 0.0625 × (i - 1)，首条 1.0 递减至末条 0.3125）；自定义颜色时颜色走 inline
	 */
	function spokeStyle(index: number): string {
		let style = 'transform: rotate(' + ((index - 1) * 30) + 'deg);'
		style += ' opacity: ' + (1 - 0.0625 * (index - 1)) + ';'
		if (props.color != '') style += ' background-color: ' + props.color + ';'
		return style
	}

	/** 文案类名：纵向排列时间距从图标右侧换到上方 */
	const textClass = computed<string>(() => {
		let cls = 'mxi-loading__text'
		if (props.vertical) cls += ' mxi-loading__text--vertical'
		return cls
	})

	/** 文案动态样式：text-size / text-color 非空时 inline 覆盖（text-size 纯数字自动补 px） */
	const textStyle = computed<string>(() => {
		let style = ''
		if (props.textSize != '') style += 'font-size: ' + addUnit(props.textSize) + ';'
		if (props.textColor != '') style += ' color: ' + props.textColor + ';'
		return style
	})

	/**
	 * 数字或纯数字字符串补 px 单位（如 "24" → "24px"），带单位字符串原样返回
	 */
	function addUnit(value: string): string {
		if (value == '') return ''
		const pattern = new RegExp('^-?\\d+(\\.\\d+)?$')
		return pattern.test(value) ? value + 'px' : value
	}

	/**
	 * 启动旋转动画
	 * circular：2s 匀速（弧段追逐感）；spinner：0.8s steps(12) 离散旋转（滴答式拖尾）
	 * 通过 UniElement.animate 实现（ucss 禁用 @keyframes，动画一律走 animate API）
	 */
	function startAnimation() {
		// 切换动画前先取消旧动画（如动态切换 type）
		animation?.cancel()
		if (spinnerRef.value == null) return
		const easing = props.type == 'spinner' ? 'steps(12)' : 'linear'
		const duration = props.type == 'spinner' ? 800 : 2000
		animation = spinnerRef.value.animate(
			[
				{ transform: 'rotate(0deg)' },
				{ transform: 'rotate(360deg)' }
			],
			{ duration: duration, iterations: Infinity, easing: easing }
		)
	}

	// 组件挂载即进入常驻加载动画（加载组件本身就是加载状态的表达，无开关 prop）
	onMounted(() => {
		startAnimation()
	})

	// 动态切换加载类型时重启动画（flush: post 确保切换后的节点已渲染再取 ref）
	watch(
		() => props.type,
		(_: LoadingType) => {
			startAnimation()
		},
		{ flush: 'post' }
	)
</script>

<style lang="scss">
	/*
	 * 主题变量说明（默认主题内置 + 变量覆盖）：
	 * 组件内顶层引入 theme/vars.scss（全部 !default），零配置即有默认主题；
	 * 覆盖方式：项目根 uni.scss 直接定义 $mxi-* 变量（禁止 @import vars.scss，
	 * uni.scss 注入机制与组件内引入同一文件会触发循环导入）。
	 */
	@import '../../theme/vars.scss';

	/* ========== 根节点 ========== */
	.mxi-loading {
		flex-direction: row;
		align-items: center;
		/* 收缩宽度贴内容，避免块级默认撑满父容器 */
		align-self: flex-start;
	}
	/* 纵向排列：图标在上文字在下，整体水平居中 */
	.mxi-loading--vertical {
		flex-direction: column;
		align-items: center;
	}

	/* ========== 图标容器（尺寸与动画承载） ========== */
	.mxi-loading__spinner {
		position: relative;
		width: $mxi-loading-spinner-size;
		height: $mxi-loading-spinner-size;
	}

	/* ========== circular 弧段圆环 ========== */
	/* 单色弧段 + 透明轨道：直径取容器 80%（inset 10%），2px 弧线宽 */
	.mxi-loading__ring {
		position: absolute;
		top: 10%;
		left: 10%;
		width: 80%;
		height: 80%;
		border-width: 2px;
		border-style: solid;
		border-color: transparent;
		border-top-color: $mxi-loading-spinner-color;
		border-radius: $mxi-radius-max;
	}

	/* ========== spinner 花瓣辐条 ========== */
	/* 2px 固定宽（不随图标尺寸缩放）、40% 百分比圆角，水平居中于圆心正上方，
	   绕自身高度 200% 处（恰为容器中心）旋转分布；亮度拖尾 opacity 由运行时 inline style 按序号递减 */
	.mxi-loading__spoke {
		position: absolute;
		top: 0;
		left: 50%;
		width: 2px;
		height: 25%;
		margin-left: -1px;
		border-radius: 40%;
		background-color: $mxi-loading-spinner-color;
		transform-origin: 50% 200%;
	}

	/* ========== 文案 ========== */
	.mxi-loading__text {
		margin-left: $mxi-loading-text-gap;
		color: $mxi-loading-text-color;
		font-size: $mxi-loading-text-font-size;
		line-height: 1.2;
	}
	.mxi-loading__text--vertical {
		margin-left: 0;
		margin-top: $mxi-loading-text-gap;
	}
</style>
