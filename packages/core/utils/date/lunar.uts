/**
 * 日期工具集 · 农历（1900-2100）
 *
 * 职责：公历转农历、农历转公历、闰月 / 月长 / 年长查询、干支 / 生肖 / 月名 / 日名 / 时辰名。
 * 口径：农历月份 1 起，闰月以负数表示（如 -6 表示闰六月）；数据覆盖农历 1900-2100 年。
 * 约束：不使用位运算（原生端 number 为 Double），压缩表按 2 的幂除取余还原各月大小。
 */

import { DAY_MS } from './core.uts'

/** 农历数据表起始年 */
const LUNAR_START_YEAR: number = 1900

/** 农历数据表结束年 */
const LUNAR_END_YEAR: number = 2100

/** 基准公历日：1900-01-31 为农历 1900 年正月初一 */
const LUNAR_BASE_SOLAR: Date = new Date(1900, 0, 31)

/**
 * 1900-2100 农历压缩表（每年一项）
 *
 * 编码：低 4 位为闰月月份（0 表示无闰月）；bit16 为闰月天数（1 = 30 天，0 = 29 天）；
 * bit15-bit4 依次为正月到腊月的大小月（1 = 30 天，0 = 29 天）。
 */
const LUNAR_INFO: number[] = [
	0x04bd8, 0x04ae0, 0x0a570, 0x054d5, 0x0d260, 0x0d950, 0x16554, 0x056a0, 0x09ad0, 0x055d2, // 1900-1909
	0x04ae0, 0x0a5b6, 0x0a4d0, 0x0d250, 0x1d255, 0x0b540, 0x0d6a0, 0x0ada2, 0x095b0, 0x14977, // 1910-1919
	0x04970, 0x0a4b0, 0x0b4b5, 0x06a50, 0x06d40, 0x1ab54, 0x02b60, 0x09570, 0x052f2, 0x04970, // 1920-1929
	0x06566, 0x0d4a0, 0x0ea50, 0x06e95, 0x05ad0, 0x02b60, 0x186e3, 0x092e0, 0x1c8d7, 0x0c950, // 1930-1939
	0x0d4a0, 0x1d8a6, 0x0b550, 0x056a0, 0x1a5b4, 0x025d0, 0x092d0, 0x0d2b2, 0x0a950, 0x0b557, // 1940-1949
	0x06ca0, 0x0b550, 0x15355, 0x04da0, 0x0a5b0, 0x14573, 0x052b0, 0x0a9a8, 0x0e950, 0x06aa0, // 1950-1959
	0x0aea6, 0x0ab50, 0x04b60, 0x0aae4, 0x0a570, 0x05260, 0x0f263, 0x0d950, 0x05b57, 0x056a0, // 1960-1969
	0x096d0, 0x04dd5, 0x04ad0, 0x0a4d0, 0x0d4d4, 0x0d250, 0x0d558, 0x0b540, 0x0b6a0, 0x195a6, // 1970-1979
	0x095b0, 0x049b0, 0x0a974, 0x0a4b0, 0x0b27a, 0x06a50, 0x06d40, 0x0af46, 0x0ab60, 0x09570, // 1980-1989
	0x04af5, 0x04970, 0x064b0, 0x074a3, 0x0ea50, 0x06b58, 0x055c0, 0x0ab60, 0x096d5, 0x092e0, // 1990-1999
	0x0c960, 0x0d954, 0x0d4a0, 0x0da50, 0x07552, 0x056a0, 0x0abb7, 0x025d0, 0x092d0, 0x0cab5, // 2000-2009
	0x0a950, 0x0b4a0, 0x0baa4, 0x0ad50, 0x055d9, 0x04ba0, 0x0a5b0, 0x15176, 0x052b0, 0x0a930, // 2010-2019
	0x07954, 0x06aa0, 0x0ad50, 0x05b52, 0x04b60, 0x0a6e6, 0x0a4e0, 0x0d260, 0x0ea65, 0x0d530, // 2020-2029
	0x05aa0, 0x076a3, 0x096d0, 0x04afb, 0x04ad0, 0x0a4d0, 0x1d0b6, 0x0d250, 0x0d520, 0x0dd45, // 2030-2039
	0x0b5a0, 0x056d0, 0x055b2, 0x049b0, 0x0a577, 0x0a4b0, 0x0aa50, 0x1b255, 0x06d20, 0x0ada0, // 2040-2049
	0x14b63, 0x09370, 0x049f8, 0x04970, 0x064b0, 0x168a6, 0x0ea50, 0x06b20, 0x1a6c4, 0x0aae0, // 2050-2059
	0x0a2e0, 0x0d2e3, 0x0c960, 0x0d557, 0x0d4a0, 0x0da50, 0x05d55, 0x056a0, 0x0a6d0, 0x055d4, // 2060-2069
	0x052d0, 0x0a9b8, 0x0a950, 0x0b4a0, 0x0b6a6, 0x0ad50, 0x055a0, 0x0aba4, 0x0a5b0, 0x052b0, // 2070-2079
	0x0b273, 0x06930, 0x07337, 0x06aa0, 0x0ad50, 0x14b55, 0x04b60, 0x0a570, 0x054e4, 0x0d160, // 2080-2089
	0x0e968, 0x0d520, 0x0daa0, 0x16aa6, 0x056d0, 0x04ae0, 0x0a9d4, 0x0a2d0, 0x0d150, 0x0f252, // 2090-2099
	0x0d520 // 2100
]

/** 天干表 */
const HEAVENLY_STEMS: string[] = ['甲', '乙', '丙', '丁', '戊', '己', '庚', '辛', '壬', '癸']

/** 地支表（与生肖一一对应） */
const EARTHLY_BRANCHES: string[] = ['子', '丑', '寅', '卯', '辰', '巳', '午', '未', '申', '酉', '戌', '亥']

/** 生肖表 */
const ZODIACS: string[] = ['鼠', '牛', '虎', '兔', '龙', '蛇', '马', '羊', '猴', '鸡', '狗', '猪']

/** 农历月份名（1-12，闰月前缀「闰」） */
const LUNAR_MONTH_NAMES: string[] = ['正', '二', '三', '四', '五', '六', '七', '八', '九', '十', '冬', '腊']

/** 农历日名数字表（初一至初十） */
const DAY_NUMBERS: string[] = ['一', '二', '三', '四', '五', '六', '七', '八', '九', '十']

/** 2 的幂查表（bitAt 用；避免原生端 Math.pow 的重复开销） */
const BIT_VALUES: number[] = [1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768, 65536]

/** 公历转农历结果（月份 1 起，闰月为负） */
export type LunarResult = {	/** 农历年 */
	year: number
	/** 农历月 1-12；闰月为负（如 -6 = 闰六月） */
	month: number
	/** 农历日 1-30 */
	day: number
}

/** 农历转公历结果（月份 0 起，对齐 JS Date） */
export type SolarResult = {
	/** 公历年 */
	year: number
	/** 公历月 0-11 */
	month: number
	/** 公历日 1-31 */
	day: number
}

/**
 * 取压缩表指定位的值（规避 Double 位运算差异）
 *
 * @param info 压缩表项
 * @param position 位序号（0 起）
 * @returns 0 或 1
 */
function bitAt(info: number, position: number): number {
	return Math.floor(info / BIT_VALUES[position]) % 2
}

/**
 * 归一取模到非负区间（年序索引用）
 *
 * @param value 原始值
 * @param modulo 模数
 * @returns 0..modulo-1
 */
function positiveMod(value: number, modulo: number): number {
	let result = Math.floor(value) % modulo
	if (result < 0) {
		result += modulo
	}
	return result
}

/**
 * 取农历年的压缩表项
 *
 * @param year 农历年
 * @returns 压缩表项；越界返回 0
 */
function lunarInfoOf(year: number): number {
	if (year < LUNAR_START_YEAR || year > LUNAR_END_YEAR) {
		return 0
	}
	return LUNAR_INFO[year - LUNAR_START_YEAR]
}

/**
 * 取农历某年的闰月月份
 *
 * @param year 农历年
 * @returns 闰月月份 0-12（0 表示无闰月）
 */
export function getLunarLeapMonth(year: number): number {
	return Math.floor(lunarInfoOf(year) % 16)
}

/**
 * 取农历某年闰月的天数
 *
 * @param year 农历年
 * @returns 闰月天数（29 / 30）；无闰月返回 0
 */
export function getLunarLeapMonthDays(year: number): number {
	if (getLunarLeapMonth(year) == 0) {
		return 0
	}
	return bitAt(lunarInfoOf(year), 16) == 1 ? 30 : 29
}

/**
 * 取农历某年某月（非闰月）的天数
 *
 * @param year 农历年
 * @param month 农历月 1-12
 * @returns 当月天数（29 / 30）；参数越界返回 0
 */
export function getLunarMonthDays(year: number, month: number): number {
	if (month < 1 || month > 12) {
		return 0
	}
	return bitAt(lunarInfoOf(year), 16 - month) == 1 ? 30 : 29
}

/**
 * 取农历某年的总天数（含闰月）
 *
 * @param year 农历年
 * @returns 年总天数（353-385）；越界返回 0
 */
export function getLunarYearDays(year: number): number {
	if (year < LUNAR_START_YEAR || year > LUNAR_END_YEAR) {
		return 0
	}
	let total = 0
	for (let month = 1; month <= 12; month++) {
		total += getLunarMonthDays(year, month)
	}
	return total + getLunarLeapMonthDays(year)
}

/**
 * 构建农历年的月序（正月到腊月，闰月紧随其后并以负值表示）
 *
 * @param year 农历年
 * @returns 月序数组（如 [1, 2, -2, 3, ...]）
 */
function buildLunarMonthSequence(year: number): number[] {
	const sequence: number[] = []
	const leap = getLunarLeapMonth(year)
	for (let month = 1; month <= 12; month++) {
		sequence.push(month)
		if (leap == month) {
			sequence.push(-month)
		}
	}
	return sequence
}

/**
 * 计算两个公历日期之间的自然日差（按本地零点）
 *
 * @param year 目标年
 * @param month 目标月 1-12
 * @param day 目标日
 * @returns 相对 1900-01-31 的天数（可负）
 */
function daysFromBase(year: number, month: number, day: number): number {
	const target = new Date(year, month - 1, day)
	return Math.round((target.getTime() - LUNAR_BASE_SOLAR.getTime()) / DAY_MS)
}

/**
 * 公历转农历
 *
 * @param year 公历年
 * @param month 公历月 0-11
 * @param day 公历日 1-31
 * @returns 农历结果（闰月为负月份）；越界或非法公历日期返回 null
 */
export function solarToLunar(year: number, month: number, day: number): LunarResult | null {
	if (month < 0 || month > 11 || day < 1 || day > 31) {
		return null
	}
	const solar = new Date(year, month, day)
	if (solar.getFullYear() != year || solar.getMonth() != month || solar.getDate() != day) {
		return null
	}
	let offset = daysFromBase(year, month + 1, day)
	if (offset < 0) {
		return null
	}
	let lunarYear = LUNAR_START_YEAR
	while (lunarYear <= LUNAR_END_YEAR) {
		const yearDays = getLunarYearDays(lunarYear)
		if (offset < yearDays) {
			break
		}
		offset -= yearDays
		lunarYear++
	}
	if (lunarYear > LUNAR_END_YEAR) {
		return null
	}
	const sequence = buildLunarMonthSequence(lunarYear)
	for (let i = 0; i < sequence.length; i++) {
		const monthValue = sequence[i]
		const monthDays = monthValue > 0 ? getLunarMonthDays(lunarYear, monthValue) : getLunarLeapMonthDays(lunarYear)
		if (offset < monthDays) {
			const result: LunarResult = { year: lunarYear, month: monthValue, day: offset + 1 }
			return result
		}
		offset -= monthDays
	}
	return null
}

/**
 * 农历转公历
 *
 * @param year 农历年
 * @param month 农历月 1-12（闰月传负数，如 -6）
 * @param day 农历日 1-30
 * @returns 公历结果（月份 0 起）；越界、非法闰月或日序号超界返回 null
 */
export function lunarToSolar(year: number, month: number, day: number): SolarResult | null {
	if (year < LUNAR_START_YEAR || year > LUNAR_END_YEAR) {
		return null
	}
	if (month == 0 || month < -12 || month > 12) {
		return null
	}
	const sequence = buildLunarMonthSequence(year)
	let index = -1
	for (let i = 0; i < sequence.length; i++) {
		if (sequence[i] == month) {
			index = i
			break
		}
	}
	if (index < 0) {
		return null
	}
	const absMonth = month < 0 ? -month : month
	const monthDays = month > 0 ? getLunarMonthDays(year, absMonth) : getLunarLeapMonthDays(year)
	if (day < 1 || day > monthDays) {
		return null
	}
	let offset = 0
	for (let y = LUNAR_START_YEAR; y < year; y++) {
		offset += getLunarYearDays(y)
	}
	for (let i = 0; i < index; i++) {
		const monthValue = sequence[i]
		offset += monthValue > 0 ? getLunarMonthDays(year, monthValue) : getLunarLeapMonthDays(year)
	}
	offset += day - 1
	const solar = new Date(LUNAR_BASE_SOLAR.getFullYear(), LUNAR_BASE_SOLAR.getMonth(), LUNAR_BASE_SOLAR.getDate() + offset)
	const result: SolarResult = { year: solar.getFullYear(), month: solar.getMonth(), day: solar.getDate() }
	return result
}

/**
 * 取农历年的干支名称
 *
 * @param year 农历年
 * @returns 形如 '甲辰' 的干支文本
 */
export function getLunarYearName(year: number): string {
	const stem = positiveMod(year - 4, 10)
	const branch = positiveMod(year - 4, 12)
	return HEAVENLY_STEMS[stem] + EARTHLY_BRANCHES[branch]
}

/**
 * 取农历年的生肖
 *
 * @param year 农历年
 * @returns 生肖单字（如 '龙'）
 */
export function getZodiac(year: number): string {
	return ZODIACS[positiveMod(year - 4, 12)]
}

/**
 * 取农历月名称
 *
 * @param month 农历月 1-12；闰月传负数（如 -6）
 * @returns 形如 '正月' / '闰六月' 的文本；越界返回空串
 */
export function getLunarMonthName(month: number): string {
	const absMonth = month < 0 ? -month : month
	if (absMonth < 1 || absMonth > 12) {
		return ''
	}
	const name = LUNAR_MONTH_NAMES[absMonth - 1] + '月'
	return month < 0 ? '闰' + name : name
}

/**
 * 取农历日名称
 *
 * @param day 农历日 1-30
 * @returns 形如 '初八' / '廿三' / '三十' 的文本；越界返回空串
 */
export function getLunarDayName(day: number): string {
	if (day < 1 || day > 30) {
		return ''
	}
	if (day <= 10) {
		return '初' + DAY_NUMBERS[day - 1]
	}
	if (day < 20) {
		return '十' + DAY_NUMBERS[day - 11]
	}
	if (day == 20) {
		return '二十'
	}
	if (day < 30) {
		return '廿' + DAY_NUMBERS[day - 21]
	}
	return '三十'
}

/**
 * 取时辰名称（子时 23:00-00:59，依此类推；初 / 正表示时辰前后半段）
 *
 * @param hour 小时 0-23
 * @returns 形如 '子初' / '子正' 的文本；越界返回空串
 */
export function getLunarHourName(hour: number): string {
	if (hour < 0 || hour > 23) {
		return ''
	}
	const branch = Math.floor(((hour + 1) % 24) / 2)
	return EARTHLY_BRANCHES[branch] + (hour % 2 == 1 ? '初' : '正')
}

/**
 * 组合农历日期文案（月名 + 日名，闰月带「闰」前缀）
 *
 * @param year 农历年
 * @param month 农历月 1-12；闰月传负数
 * @param day 农历日 1-30
 * @returns 形如 '腊月初八' 的文本；参数越界返回空串
 */
export function getLunarDateText(year: number, month: number, day: number): string {
	if (year < LUNAR_START_YEAR || year > LUNAR_END_YEAR) {
		return ''
	}
	const monthName = getLunarMonthName(month)
	const dayName = getLunarDayName(day)
	if (monthName == '' || dayName == '') {
		return ''
	}
	return monthName + dayName
}
