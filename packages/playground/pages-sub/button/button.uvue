<template>
	<view class="page">
		<demo-navbar title="按钮" subtitle="Button" />
		<demo-bridge />
		<scroll-view class="page-body" :scroll-y="true">
		<view class="container">
			<text class="section" id="type">按钮类型</text>
			<view class="card">
				<view class="row">
					<view class="row-gap">
						<m-button type="primary" @click="onButtonClick('primary')">主要按钮</m-button>
					</view>
					<view class="row-gap">
						<m-button type="success" @click="onButtonClick('success')">成功按钮</m-button>
					</view>
					<view class="row-gap">
						<m-button type="danger" @click="onButtonClick('danger')">危险按钮</m-button>
					</view>
					<view class="row-gap">
						<m-button type="warning" @click="onButtonClick('warning')">警告按钮</m-button>
					</view>
					<view class="row-gap">
						<m-button type="default" @click="onButtonClick('default')">默认按钮</m-button>
					</view>
				</view>
			</view>

			<text class="section" id="size">按钮尺寸</text>
			<view class="card">
				<view class="row">
					<view class="row-gap">
						<m-button type="primary" size="large" @click="onButtonClick('large')">大号按钮</m-button>
					</view>
					<view class="row-gap">
						<m-button type="primary" size="normal" @click="onButtonClick('normal')">普通按钮</m-button>
					</view>
					<view class="row-gap">
						<m-button type="primary" size="small" @click="onButtonClick('small')">小型按钮</m-button>
					</view>
					<view class="row-gap">
						<m-button type="primary" size="mini" @click="onButtonClick('mini')">迷你按钮</m-button>
					</view>
				</view>
			</view>

			<text class="section" id="plain">朴素 / 圆角 / 方形</text>
			<view class="card">
				<view class="row">
					<view class="row-gap">
						<m-button type="primary" :plain="true" @click="onButtonClick('plain')">朴素按钮</m-button>
					</view>
					<view class="row-gap">
						<m-button type="success" :plain="true" @click="onButtonClick('plain-success')">朴素成功</m-button>
					</view>
					<view class="row-gap">
						<m-button type="primary" :round="true" @click="onButtonClick('round')">圆形按钮</m-button>
					</view>
					<view class="row-gap">
						<m-button type="primary" :square="true" @click="onButtonClick('square')">方形按钮</m-button>
					</view>
					<view class="row-gap">
						<m-button type="danger" :plain="true" :hairline="true" @click="onButtonClick('plain-hairline')">朴素细边框</m-button>
					</view>
					<view class="row-gap">
						<m-button type="primary" :plain="true" :hairline="true" :round="true" @click="onButtonClick('plain-hairline-round')">细边框圆角</m-button>
					</view>
				</view>
			</view>

			<text class="section" id="block">块级元素</text>
			<view class="card">
				<view class="block-gap">
					<m-button type="primary" :block="true" @click="onButtonClick('block')">块级按钮</m-button>
				</view>
				<view class="block-gap">
					<m-button type="danger" :block="true" :round="true" @click="onButtonClick('block-round')">块级圆角按钮</m-button>
				</view>
			</view>

			<text class="section" id="disabled">禁用状态</text>
			<view class="card">
				<view class="row">
					<view class="row-gap">
						<m-button type="primary" :disabled="true" @click="onButtonClick('disabled')">禁用状态</m-button>
					</view>
					<view class="row-gap">
						<m-button type="primary" :plain="true" :disabled="true" @click="onButtonClick('disabled-plain')">禁用朴素</m-button>
					</view>
				</view>
			</view>

			<text class="section" id="loading">加载状态</text>
			<view class="card">
				<view class="row">
					<view class="row-gap">
						<m-button type="primary" :loading="true" @click="onButtonClick('loading')">加载中</m-button>
					</view>
					<view class="row-gap">
						<m-button type="primary" :loading="true" loading-text="加载中..." @click="onButtonClick('loading-text')">加载文字</m-button>
					</view>
					<view class="row-gap">
						<m-button type="primary" :loading="true" loading-type="circular" @click="onButtonClick('loading-circular')">圆环加载</m-button>
					</view>
					<view class="row-gap">
						<m-button type="primary" :loading="true" loading-type="spinner" @click="onButtonClick('loading-spinner')">花瓣加载</m-button>
					</view>
					<view class="row-gap">
						<m-button type="primary" :loading="demoLoading" @click="toggleLoading">点击模拟加载</m-button>
					</view>
				</view>
			</view>

			<text class="section" id="color">自定义颜色</text>
			<view class="card">
				<view class="row">
					<view class="row-gap">
						<m-button color="#7232dd" @click="onButtonClick('color')">单色按钮</m-button>
					</view>
					<view class="row-gap">
						<m-button color="linear-gradient(to right, #ff6034, #ee0a24)" @click="onButtonClick('color-gradient')">渐变按钮</m-button>
					</view>
					<view class="row-gap">
						<m-button color="#7232dd" :plain="true" @click="onButtonClick('color-plain')">彩色朴素</m-button>
					</view>
				</view>
			</view>

			<view class="logs">
				<view class="logs-head">
					<text class="logs-title">事件日志（禁用 / 加载中的按钮点击不触发）</text>
				</view>
				<text v-for="(log, index) in logs" :key="index" class="log">{{ log }}</text>
			</view>
		</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	/** 事件日志（最新的显示在最前） */
	const logs = ref<string[]>([])

	/** 点击行为标记（用于演示 loading 动态切换） */
	const demoLoading = ref(false)

	/**
	 * 追加一条点击事件日志
	 * 最多保留 20 条，超出后丢弃最早的记录
	 */
	function onButtonClick(name: string) {
		logs.value.unshift('click: ' + name)
		if (logs.value.length > 20) logs.value.pop()
	}

	/** 模拟异步操作：开启加载状态 2 秒后恢复 */
	function toggleLoading() {
		if (demoLoading.value) return
		demoLoading.value = true
		onButtonClick('toggle-loading-on')
		setTimeout(() => {
			demoLoading.value = false
			onButtonClick('toggle-loading-off')
		}, 2000)
	}
</script>

<style>
	.block-gap {
		margin-bottom: 16rpx;
	}
</style>
