<template>
	<view class="page">
		<demo-navbar title="日期范围选择" subtitle="DateRangePicker" />
		<demo-bridge />
		<scroll-view class="page-body" :scroll-y="true">
		<view class="container">

			<text class="section" id="basic">基础用法</text>
			<view class="card">
				<m-date-range-picker v-model:value="basicValue" @change="onBasicChange" @confirm="onBasicConfirm" />
				<view class="event-log">
					<text class="event-text">当前值：{{ formatValues(basicValue) }}；最近事件：{{ basicLog }}</text>
				</view>
				<text class="caption">默认「开始日期 / 结束日期」两段标题，切换编辑端；确认时若起点晚于终点自动交换为升序；未选任何一端时 value 为 null</text>
			</view>

			<text class="section" id="tabs">自定义标题</text>
			<view class="card">
				<m-date-range-picker v-model:value="hotelValue" :tabs="hotelTabs" @confirm="onHotelConfirm" />
				<view class="event-log">
					<text class="event-text">当前值：{{ formatValues(hotelValue) }}</text>
				</view>
				<text class="caption">tabs 自定义两段标题，本例为「入住 / 离店」</text>
			</view>

			<text class="section" id="columns">列组合与区间</text>
			<view class="card">
				<m-date-range-picker
					v-model:value="monthValue"
					:columns-type="yearMonthColumns"
					:min-date="rangeMin"
					:max-date="rangeMax"
					:tabs="monthTabs"
					@confirm="onMonthConfirm"
				/>
				<view class="event-log">
					<text class="event-text">当前值：{{ formatValues(monthValue) }}</text>
				</view>
				<text class="caption">columns-type=['year','month'] 只选年月（日归一为 1 号）；min/max 限定 2026-03 ~ 2026-09</text>
			</view>

			<text class="section" id="slots">插槽</text>
			<view class="card">
				<m-date-range-picker v-model:value="slotValue" :tabs="hotelTabs" @confirm="onSlotConfirm">
					<template #header>
						<view class="demo-shortcuts">
							<text class="demo-shortcut" @click="setLastWeek">近一周</text>
							<text class="demo-shortcut" @click="setLastMonth">近一月</text>
							<text class="demo-shortcut" @click="clearSlot">清空</text>
						</view>
					</template>
					<template #title="{ tabs, activeIndex }">
						<view class="demo-custom-title">
							<text class="demo-custom-title-text">自定义标题：{{ slotTabText(tabs, activeIndex) }}</text>
						</view>
					</template>
					<template #confirm>
						<text class="demo-slot-confirm">完成</text>
					</template>
					<template #cancel>
						<text class="demo-slot-cancel">返回</text>
					</template>
				</m-date-range-picker>
				<view class="event-log">
					<text class="event-text">当前值：{{ formatValues(slotValue) }}；最近确认：{{ slotLog }}</text>
				</view>
				<text class="caption">header（快捷区）/ title（整体替换两段标题，作用域 tabs + activeIndex）/ confirm / cancel / footer 插槽</text>
			</view>

			<text class="section" id="states">只读与加载态</text>
			<view class="card">
				<m-date-range-picker :value="statesValue" readonly :tabs="hotelTabs" />
				<view class="demo-btn-row">
					<m-button size="small" @click="toggleLoading">{{ loading ? '关闭加载' : '开启加载' }}</m-button>
				</view>
				<m-date-range-picker :value="statesValue" :tabs="hotelTabs" :loading="loading" custom-style="margin-top: 12px;" />
				<text class="caption">readonly 滚轮回弹到当前值；loading 覆盖滚轮区并阻止交互</text>
			</view>

			<text class="section" id="methods">实例方法</text>
			<view class="card">
				<m-date-range-picker ref="methodPicker" :tabs="hotelTabs" />
				<view class="demo-btn-row">
					<m-button size="small" @click="callGet">getSelectedValue</m-button>
					<m-button size="small" custom-style="margin-left: 8px;" @click="callConfirm">confirm</m-button>
				</view>
				<view class="event-log">
					<text class="event-text">最近调用：{{ methodLog }}</text>
				</view>
				<text class="caption">getSelectedValue 读取升序两端值；confirm 程序化确认</text>
			</view>

		</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	// 页面声明宏：构建期由 routeGen 插件剥离，是 pages.json 条目与路由表的事实源
	defineUniPage({ title: '日期范围选择 DateRangePicker', name: 'date-range-picker' })
	import { DatePickerColumnType } from '@/uni_modules/m-ui-x/components/m-date-picker/date-picker.uts'

	/** 日期转 YYYY-M-D 文本（演示日志用） */
	function fmtDate(d: Date): string {
		return d.getFullYear().toString() + '-' + (d.getMonth() + 1).toString() + '-' + d.getDate().toString()
	}

	/** 两端值转文本 */
	function formatValues(value: Date[] | null): string {
		if (value == null || value.length == 0) {
			return 'null（未选）'
		}
		const parts: string[] = []
		for (let i = 0; i < value.length; i++) {
			parts.push(fmtDate(value[i]))
		}
		return parts.join(' ~ ')
	}

	// ========== 1 基础用法 ==========
	const basicValue = ref<Date[] | null>(null)
	const basicLog = ref<string>('（切换标题并滚动试试）')

	/** change 记录 */
	const onBasicChange = (value: Date[], activeIndex: number) => {
		basicLog.value = 'change → ' + formatValues(value) + '（第 ' + (activeIndex + 1).toString() + ' 段）'
	}

	/** confirm 记录（两端自动升序） */
	const onBasicConfirm = (value: Date[]) => {
		basicLog.value = 'confirm → ' + formatValues(value)
	}

	// ========== 2 自定义标题 ==========
	const hotelTabs: string[] = ['入住', '离店']
	const hotelValue = ref<Date[] | null>(null)

	/** 自定义标题 confirm 记录 */
	const onHotelConfirm = (value: Date[]) => {
		hotelValue.value = value
	}

	// ========== 3 列组合与区间 ==========
	const yearMonthColumns: DatePickerColumnType[] = ['year', 'month']
	const monthTabs: string[] = ['开始月份', '结束月份']
	const rangeMin = new Date(2026, 2, 1)
	const rangeMax = new Date(2026, 8, 30)
	const monthValue = ref<Date[] | null>(null)

	/** 年月范围 confirm 记录 */
	const onMonthConfirm = (value: Date[]) => {
		monthValue.value = value
	}

	// ========== 4 插槽 ==========
	const slotValue = ref<Date[] | null>(null)
	const slotLog = ref<string>('（未确认）')

	/** title 插槽取值：作用域参数在 VDOM 生成 Kotlin 中为 Any?，须本地桥接后强转 */
	const slotTabText = (tabs: any | null, activeIndex: any | null): string => {
		if (tabs == null || activeIndex == null) {
			return ''
		}
		const list = tabs as string[]
		const index = activeIndex as number
		if (index < 0 || index >= list.length) {
			return ''
		}
		return list[index]
	}

	/** 近一周快捷设置 */
	const setLastWeek = () => {
		const end = new Date()
		const start = new Date()
		start.setDate(start.getDate() - 7)
		slotValue.value = [start, end]
	}

	/** 近一月快捷设置 */
	const setLastMonth = () => {
		const end = new Date()
		const start = new Date()
		start.setMonth(start.getMonth() - 1)
		slotValue.value = [start, end]
	}

	/** 清空快捷按钮 */
	const clearSlot = () => {
		slotValue.value = null
	}

	/** 插槽演示 confirm 记录 */
	const onSlotConfirm = (value: Date[]) => {
		slotValue.value = value
		slotLog.value = formatValues(value)
	}

	// ========== 5 只读与加载态 ==========
	const statesValue: Date[] = [new Date(2026, 9, 1), new Date(2026, 9, 15)]
	const loading = ref<boolean>(false)

	/** 切换加载态 */
	const toggleLoading = () => {
		loading.value = !loading.value
	}

	// ========== 6 实例方法 ==========
	const methodPicker = ref<ComponentPublicInstance | null>(null)
	const methodLog = ref<string>('（点击按钮调用实例方法）')

	/** getSelectedValue：读取升序两端值 */
	const callGet = () => {
		const inst = methodPicker.value
		if (inst == null) {
			methodLog.value = '实例未就绪'
			return
		}
		const r = inst.$callMethod('getSelectedValue')
		if (r != null) {
			methodLog.value = 'getSelectedValue → ' + formatValues(r as Date[])
		} else {
			methodLog.value = 'getSelectedValue → 无'
		}
	}

	/** confirm：程序化确认 */
	const callConfirm = () => {
		const inst = methodPicker.value
		if (inst == null) {
			methodLog.value = '实例未就绪'
			return
		}
		inst.$callMethod('confirm')
		methodLog.value = 'confirm 已调用'
	}
</script>

<style lang="scss">
	/* 事件日志展示行 */
	.event-log {
		margin-top: 12px;
	}
	.event-text {
		font-size: 12px;
		color: #1989fa;
	}
	.caption {
		font-size: 12px;
		color: #969799;
		margin-top: 8px;
	}
	/* 快捷区演示 */
	.demo-shortcuts {
		flex-direction: row;
		justify-content: center;
		padding: 6px 0;
	}
	.demo-shortcut {
		font-size: 12px;
		color: #1989fa;
		margin: 0 8px;
	}
	/* 自定义标题演示 */
	.demo-custom-title {
		flex-direction: row;
		justify-content: center;
		align-items: center;
		height: 44px;
	}
	.demo-custom-title-text {
		font-size: 14px;
		color: #07c160;
		font-weight: bold;
	}
	.demo-slot-confirm {
		font-size: 14px;
		color: #ee0a24;
	}
	.demo-slot-cancel {
		font-size: 14px;
		color: #969799;
	}
	.demo-btn-row {
		flex-direction: row;
		align-items: center;
		margin-top: 12px;
	}
</style>
