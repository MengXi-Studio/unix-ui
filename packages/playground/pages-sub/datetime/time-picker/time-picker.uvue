<template>
	<view class="page">
		<demo-navbar title="时间选择" subtitle="TimePicker" />
		<demo-bridge />
		<scroll-view class="page-body" :scroll-y="true">
		<view class="container">

			<text class="section" id="basic">基础用法</text>
			<view class="card">
				<m-time-picker v-model:value="basicValue" @change="onBasicChange" @confirm="onBasicConfirm" />
				<view class="event-log">
					<text class="event-text">当前值：{{ formatTime(basicValue) }}；最近事件：{{ basicLog }}</text>
				</view>
				<text class="caption">默认「时 : 分」两列，确认后回写 'HH:mm'；未传 value 时从当前时间开始</text>
			</view>

			<text class="section" id="columns">时分秒</text>
			<view class="card">
				<m-time-picker v-model:value="secondValue" :columns-type="hmsColumns" @confirm="onSecondConfirm" />
				<view class="event-log">
					<text class="event-text">当前值：{{ formatTime(secondValue) }}</text>
				</view>
				<text class="caption">columns-type=['hour','minute','second'] 输出 'HH:mm:ss'</text>
			</view>

			<text class="section" id="step">步长与区间</text>
			<view class="card">
				<m-time-picker
					v-model:value="stepValue"
					:minute-step="15"
					min-time="09:00"
					max-time="18:00"
					title="工作时间"
					@confirm="onStepConfirm"
				/>
				<view class="event-log">
					<text class="event-text">当前值：{{ formatTime(stepValue) }}</text>
				</view>
				<text class="caption">minute-step=15 只保留 00/15/30/45；min-time / max-time 把时列收敛到 09-18，边界小时再收敛分列</text>
			</view>

			<text class="section" id="cycle">12 小时制</text>
			<view class="card">
				<m-time-picker v-model:value="cycleValue" :hour-cycle="12" @confirm="onCycleConfirm" />
				<view class="event-log">
					<text class="event-text">当前值：{{ formatTime(cycleValue) }}</text>
				</view>
				<text class="caption">hour-cycle=12 时在时列前附加「上午 / 下午」列，值仍以 24 小时制 'HH:mm' 输出</text>
			</view>

			<text class="section" id="slots">插槽</text>
			<view class="card">
				<m-time-picker v-model:value="slotValue" title="自定义">
					<template #confirm>
						<text class="demo-slot-confirm">完成</text>
					</template>
					<template #cancel>
						<text class="demo-slot-cancel">返回</text>
					</template>
					<!-- #ifdef WEB -->
					<template #option="{ option }">
						<text class="demo-slot-option">{{ option.text }} 时</text>
					</template>
					<!-- #endif -->
				</m-time-picker>
				<view class="event-log">
					<text class="event-text">当前值：{{ formatTime(slotValue) }}</text>
				</view>
				<text class="caption">toolbar（整体替换）/ title / confirm / cancel / option 插槽；option 会作用于时、分、秒与上午下午列</text>
			</view>

			<text class="section" id="states">只读与加载态</text>
			<view class="card">
				<m-time-picker :value="'10:30'" readonly />
				<view class="demo-btn-row">
					<m-button size="small" @click="toggleLoading">{{ loading ? '关闭加载' : '开启加载' }}</m-button>
				</view>
				<m-time-picker :value="'10:30'" :loading="loading" custom-style="margin-top: 12px;" />
				<text class="caption">readonly 滚轮回弹到当前值；loading 覆盖滚轮区并阻止交互</text>
			</view>

			<text class="section" id="methods">实例方法</text>
			<view class="card">
				<m-time-picker ref="methodPicker" :columns-type="hmsColumns" />
				<view class="demo-btn-row">
					<m-button size="small" @click="callGet">getSelectedValue</m-button>
					<m-button size="small" custom-style="margin-left: 8px;" @click="callConfirm">confirm</m-button>
				</view>
				<view class="event-log">
					<text class="event-text">最近调用：{{ methodLog }}</text>
				</view>
				<text class="caption">getSelectedValue 读取当前时间字符串；confirm 程序化确认</text>
			</view>

		</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	// 页面声明宏：构建期由 routeGen 插件剥离，是 pages.json 条目与路由表的事实源
	defineUniPage({ title: '时间选择 TimePicker', name: 'time-picker' })
	import { TimePickerColumnType } from '@/uni_modules/m-ui-x/components/m-time-picker/time-picker.uts'

	const hmsColumns: TimePickerColumnType[] = ['hour', 'minute', 'second']

	/** 空值兜底文本（模板内避免可空表达式） */
	function formatTime(value: string | null): string {
		return value == null ? 'null' : value
	}

	// ========== 1 基础用法 ==========
	const basicValue = ref<string | null>(null)
	const basicLog = ref<string>('（滚动或确认试试）')

	/** change 记录 */
	const onBasicChange = (value: string, columnIndex: number) => {
		basicLog.value = 'change → ' + value + '（第 ' + (columnIndex + 1).toString() + ' 列）'
	}

	/** confirm 记录 */
	const onBasicConfirm = (value: string) => {
		basicLog.value = 'confirm → ' + value
	}

	// ========== 2 时分秒 ==========
	const secondValue = ref<string | null>(null)

	/** 时分秒 confirm 记录 */
	const onSecondConfirm = (value: string) => {
		secondValue.value = value
	}

	// ========== 3 步长与区间 ==========
	const stepValue = ref<string | null>(null)

	/** 步长 / 区间 confirm 记录 */
	const onStepConfirm = (value: string) => {
		stepValue.value = value
	}

	// ========== 4 12 小时制 ==========
	const cycleValue = ref<string | null>(null)

	/** 12 制 confirm 记录 */
	const onCycleConfirm = (value: string) => {
		cycleValue.value = value
	}

	// ========== 5 插槽 ==========
	const slotValue = ref<string | null>(null)

	// ========== 6 只读与加载态 ==========
	const loading = ref<boolean>(false)

	/** 切换加载态 */
	const toggleLoading = () => {
		loading.value = !loading.value
	}

	// ========== 7 实例方法 ==========
	const methodPicker = ref<ComponentPublicInstance | null>(null)
	const methodLog = ref<string>('（点击按钮调用实例方法）')

	/** getSelectedValue：读取当前时间字符串 */
	const callGet = () => {
		const inst = methodPicker.value
		if (inst == null) {
			methodLog.value = '实例未就绪'
			return
		}
		const r = inst.$callMethod('getSelectedValue')
		methodLog.value = 'getSelectedValue → ' + (r == null ? 'null' : r.toString())
	}

	/** confirm：程序化确认 */
	const callConfirm = () => {
		const inst = methodPicker.value
		if (inst == null) {
			methodLog.value = '实例未就绪'
			return
		}
		inst.$callMethod('confirm')
		methodLog.value = 'confirm 已调用'
	}
</script>

<style lang="scss">
	/* 事件日志展示行 */
	.event-log {
		margin-top: 12px;
	}
	.event-text {
		font-size: 12px;
		color: #1989fa;
	}
	.caption {
		font-size: 12px;
		color: #969799;
		margin-top: 8px;
	}
	/* 插槽演示 */
	.demo-slot-confirm {
		font-size: 14px;
		color: #ee0a24;
	}
	.demo-slot-cancel {
		font-size: 14px;
		color: #969799;
	}
	.demo-slot-option {
		font-size: 16px;
		color: #07c160;
	}
	.demo-btn-row {
		flex-direction: row;
		align-items: center;
		margin-top: 12px;
	}
</style>
