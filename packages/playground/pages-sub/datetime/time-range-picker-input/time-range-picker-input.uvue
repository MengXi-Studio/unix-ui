<template>
	<view class="page">
		<demo-navbar title="时间范围输入框" subtitle="TimeRangePickerInput" />
		<demo-bridge />
		<scroll-view class="page-body" :scroll-y="true">
		<view class="container">

			<text class="section" id="basic">基础用法</text>
			<view class="card">
				<m-time-range-picker-input
					v-model:value="basicValue"
					@confirm="onBasicConfirm"
					@clear="onBasicClear"
				/>
				<view class="event-log">
					<text class="event-text">当前值：{{ formatValues(basicValue) }}；最近事件：{{ basicLog }}</text>
				</view>
				<view class="demo-btn-row">
					<m-button size="small" @click="fillWorkTime">填入 09:00 - 18:00</m-button>
				</view>
				<text class="caption">点击输入区打开弹层，确认后以「起 - 止」回填；清空按钮回写 null 并派发 clear</text>
			</view>

			<text class="section" id="columns">时分秒与自定义标题</text>
			<view class="card">
				<m-time-range-picker-input
					v-model:value="secondValue"
					:columns-type="hmsColumns"
					:tabs="workTabs"
					placeholder="请选择上下班时间"
				/>
				<view class="event-log">
					<text class="event-text">当前值：{{ formatValues(secondValue) }}</text>
				</view>
				<text class="caption">columns-type 含 second 时展示 'HH:mm:ss - HH:mm:ss'；tabs 自定义两段标题</text>
			</view>

			<text class="section" id="constraints">步长、区间与 12 小时制</text>
			<view class="card">
				<m-time-range-picker-input
					v-model:value="stepValue"
					:minute-step="15"
					min-time="09:00"
					max-time="18:00"
					placeholder="09:00 - 18:00（15 分钟步长）"
				/>
				<view class="event-log">
					<text class="event-text">当前值：{{ formatValues(stepValue) }}</text>
				</view>
				<m-time-range-picker-input
					v-model:value="cycleValue"
					:hour-cycle="12"
					placeholder="12 小时制"
					custom-style="margin-top: 16px;"
				/>
				<view class="event-log">
					<text class="event-text">当前值：{{ formatValues(cycleValue) }}</text>
				</view>
				<text class="caption">步长 / 区间 / 制式参数全部透传到弹层范围面板</text>
			</view>

			<text class="section" id="disabled">禁用与不可清空</text>
			<view class="card">
				<m-time-range-picker-input :value="fixedValue" disabled placeholder="禁用态" />
				<view class="event-log">
					<text class="event-text">禁用态不可点击、不显示清空按钮</text>
				</view>
				<m-time-range-picker-input
					v-model:value="noClearValue"
					:clearable="false"
					placeholder="不可清空"
					custom-style="margin-top: 16px;"
				/>
				<text class="caption">disabled 关闭触发层；clearable=false 只隐藏清空按钮</text>
			</view>

		</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	// 页面声明宏：构建期由 routeGen 插件剥离，是 pages.json 条目与路由表的事实源
	defineUniPage({ title: '时间范围输入框 TimeRangePickerInput', name: 'time-range-picker-input' })
	import { TimePickerColumnType } from '@/uni_modules/m-ui-x/components/m-time-picker/time-picker.uts'

	const hmsColumns: TimePickerColumnType[] = ['hour', 'minute', 'second']
	const workTabs: string[] = ['上班', '下班']

	/** 两端值转文本 */
	function formatValues(value: string[] | null): string {
		if (value == null || value.length == 0) {
			return 'null（未选）'
		}
		return value.join(' ~ ')
	}

	// ========== 1 基础用法 ==========
	const basicValue = ref<string[] | null>(null)
	const basicLog = ref<string>('（点击输入框选择）')

	/** 确认记录 */
	const onBasicConfirm = (value: string[]) => {
		basicLog.value = 'confirm → ' + formatValues(value)
	}

	/** 清空记录 */
	const onBasicClear = () => {
		basicLog.value = 'clear'
	}

	/** 填入工作时间（演示有值状态与清空） */
	const fillWorkTime = () => {
		basicValue.value = ['09:00', '18:00']
		basicLog.value = 'fill → 09:00 ~ 18:00'
	}

	// ========== 2 时分秒与自定义标题 ==========
	const secondValue = ref<string[] | null>(null)

	// ========== 3 步长、区间与 12 小时制 ==========
	const stepValue = ref<string[] | null>(null)
	const cycleValue = ref<string[] | null>(null)

	// ========== 4 禁用与不可清空 ==========
	const fixedValue: string[] = ['09:00', '18:00']
	const noClearValue = ref<string[] | null>(null)
</script>

<style lang="scss">
	/* 事件日志展示行 */
	.event-log {
		margin-top: 12px;
	}
	.event-text {
		font-size: 12px;
		color: #1989fa;
	}
	.caption {
		font-size: 12px;
		color: #969799;
		margin-top: 8px;
	}
	.demo-btn-row {
		flex-direction: row;
		align-items: center;
		margin-top: 12px;
	}
</style>
