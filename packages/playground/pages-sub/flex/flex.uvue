					<m-flex-item><m-button type="primary">small</m-button></m-flex-item>
				</m-flex>
				<text class="caption">gap small → $m-flex-gap-sm 4px</text>
				<m-flex gap="medium">
					<m-flex-item><m-button type="primary">medium</m-button></m-flex-item>
					<m-flex-item><m-button type="primary">medium</m-button></m-flex-item>
					<m-flex-item><m-button type="primary">medium</m-button></m-flex-item>
				</m-flex>
				<text class="caption">gap medium（默认）→ $m-flex-gap 8px</text>
				<m-flex gap="large">
					<m-flex-item><m-button type="primary">large</m-button></m-flex-item>
					<m-flex-item><m-button type="primary">large</m-button></m-flex-item>
					<m-flex-item><m-button type="primary">large</m-button></m-flex-item>
				</m-flex>
				<text class="caption">gap large → $m-flex-gap-lg 12px</text>
			</view>

			<text class="section" id="custom">自定义间距</text>
			<view class="card">
				<m-flex :gap="20">
					<m-flex-item><m-button type="primary">按钮</m-button></m-flex-item>
					<m-flex-item><m-button type="primary">按钮</m-button></m-flex-item>
					<m-flex-item><m-button type="primary">按钮</m-button></m-flex-item>
				</m-flex>
