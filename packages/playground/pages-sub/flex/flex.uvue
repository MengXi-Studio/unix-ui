			</view>

			<text class="section" id="column">垂直布局</text>
			<view class="card">
				<m-flex direction="column" gap="medium">
					<m-flex-item><m-button type="primary" block>按钮一</m-button></m-flex-item>
					<m-flex-item><m-button type="primary" block>按钮二</m-button></m-flex-item>
					<m-flex-item><m-button type="primary" block>按钮三</m-button></m-flex-item>
				</m-flex>
				<text class="caption">direction column：主轴间距为子项 margin-top（首项无间距）</text>
			</view>

			<text class="section" id="reverse">反向排列</text>
			<view class="card">
				<m-flex direction="row-reverse" gap="medium">
