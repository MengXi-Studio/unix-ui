					<m-flex-item><m-button type="primary" block>按钮一</m-button></m-flex-item>
					<m-flex-item><m-button type="primary" block>按钮二</m-button></m-flex-item>
					<m-flex-item><m-button type="primary" block>按钮三</m-button></m-flex-item>
				</m-flex>
				<text class="caption">column-reverse：渲染顺序反转，间距由非末项 margin-bottom 实现</text>
			</view>

			<text class="section" id="justify">主轴对齐</text>
			<view class="card">
				<m-flex justify="start">
					<m-flex-item><m-button size="small" type="primary">start</m-button></m-flex-item>
