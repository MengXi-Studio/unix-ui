				</m-flex>
				<text class="caption">justify end</text>
				<m-flex justify="between">
					<m-flex-item><m-button size="small" type="primary">between</m-button></m-flex-item>
					<m-flex-item><m-button size="small" type="primary">按钮</m-button></m-flex-item>
				</m-flex>
				<text class="caption">justify between</text>
				<m-flex justify="around">
					<m-flex-item><m-button size="small" type="primary">around</m-button></m-flex-item>
					<m-flex-item><m-button size="small" type="primary">按钮</m-button></m-flex-item>
				</m-flex>
				<text class="caption">justify around</text>
				<m-flex justify="evenly">
					<m-flex-item><m-button size="small" type="primary">evenly</m-button></m-flex-item>
