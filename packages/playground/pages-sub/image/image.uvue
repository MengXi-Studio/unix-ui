<template>
	<view class="page">
		<demo-navbar title="图片" subtitle="Image" />
		<demo-bridge />
		<scroll-view class="page-body" :scroll-y="true">
		<view class="container">
			<text class="section" id="basic">基础用法</text>
			<view class="card">
				<view class="row-gap">
					<m-image :src="demoBase + 'demo-cat.jpg'" width="160px" height="160px" />
					<m-image :src="demoBase + 'demo-fruit.jpg'" :width="120" :height="120" custom-class="row-gap-item" />
				</view>
				<text class="caption">width / height 支持 '160px' 字符串与 120 数字（自动补 px）</text>
				<m-image :src="demoBase + 'demo-mountain.jpg'" />
				<text class="caption">未传尺寸默认 width 100% / height 240px</text>
			</view>

			<text class="section" id="mode">图片模式 mode</text>
			<view class="card">
				<view class="mode-grid">
					<view class="mode-item">
						<m-image :src="demoBase + 'demo-forest.jpg'" width="110px" height="110px" mode="scaleToFill" />
						<text class="caption">scaleToFill</text>
					</view>
					<view class="mode-item">
						<m-image :src="demoBase + 'demo-forest.jpg'" width="110px" height="110px" mode="aspectFit" />
						<text class="caption">aspectFit</text>
					</view>
					<view class="mode-item">
						<m-image :src="demoBase + 'demo-forest.jpg'" width="110px" height="110px" mode="aspectFill" />
						<text class="caption">aspectFill</text>
					</view>
					<view class="mode-item">
						<m-image :src="demoBase + 'demo-forest.jpg'" width="110px" height="110px" mode="widthFix" />
						<text class="caption">widthFix</text>
					</view>
					<view class="mode-item">
						<m-image :src="demoBase + 'demo-forest.jpg'" width="110px" height="110px" mode="heightFix" />
						<text class="caption">heightFix</text>
					</view>
					<view class="mode-item">
						<m-image :src="demoBase + 'demo-forest.jpg'" width="110px" height="110px" mode="top" />
						<text class="caption">top</text>
					</view>
					<view class="mode-item">
						<m-image :src="demoBase + 'demo-forest.jpg'" width="110px" height="110px" mode="bottom" />
						<text class="caption">bottom</text>
					</view>
					<view class="mode-item">
						<m-image :src="demoBase + 'demo-forest.jpg'" width="110px" height="110px" mode="center" />
						<text class="caption">center</text>
					</view>
					<view class="mode-item">
						<m-image :src="demoBase + 'demo-forest.jpg'" width="110px" height="110px" mode="left" />
						<text class="caption">left</text>
					</view>
					<view class="mode-item">
						<m-image :src="demoBase + 'demo-forest.jpg'" width="110px" height="110px" mode="right" />
						<text class="caption">right</text>
					</view>
					<view class="mode-item">
						<m-image :src="demoBase + 'demo-forest.jpg'" width="110px" height="110px" mode="top left" />
						<text class="caption">top left</text>
					</view>
					<view class="mode-item">
						<m-image :src="demoBase + 'demo-forest.jpg'" width="110px" height="110px" mode="top right" />
						<text class="caption">top right</text>
					</view>
					<view class="mode-item">
						<m-image :src="demoBase + 'demo-forest.jpg'" width="110px" height="110px" mode="bottom left" />
						<text class="caption">bottom left</text>
					</view>
					<view class="mode-item">
						<m-image :src="demoBase + 'demo-forest.jpg'" width="110px" height="110px" mode="bottom right" />
						<text class="caption">bottom right</text>
					</view>
				</view>
				<text class="caption">mode 与原生 image 同名直通；widthFix / heightFix 在定高容器下的表现以平台实现为准</text>
			</view>

			<text class="section" id="radius">圆角与圆形</text>
			<view class="card">
				<view class="row-gap">
					<m-image :src="demoBase + 'demo-cat.jpg'" width="80px" height="80px" round />
					<m-image :src="demoBase + 'demo-cat.jpg'" width="80px" height="80px" radius="8" custom-class="row-gap-item" />
					<m-image :src="demoBase + 'demo-cat.jpg'" width="80px" height="80px" radius="16" custom-class="row-gap-item" />
				</view>
				<text class="caption">round 圆形（优先于 radius）/ radius 8 / radius 16</text>
			</view>

			<text class="section" id="lazy">懒加载</text>
			<view class="card">
				<view class="mode-grid">
					<view class="mode-item" v-for="(item, index) in lazySrcs" :key="index">
						<m-image :src="item" width="110px" height="110px" lazy-load />
						<text class="caption">第 {{ index + 1 }} 张</text>
					</view>
				</view>
				<text class="caption">lazy-load 透传原生属性，限 page 与 scroll-view 下生效；加载时机以 network 面板为准</text>
			</view>

			<text class="section" id="loading">加载中提示</text>
			<view class="card">
				<view class="mode-grid">
					<view class="mode-item">
						<m-image :src="loadingSrc" width="110px" height="110px" />
						<text class="caption">默认图标</text>
					</view>
					<view class="mode-item">
						<m-image :src="loadingSrc" width="110px" height="110px" loading-icon="photo-o" />
						<text class="caption">自定义图标</text>
					</view>
					<view class="mode-item">
						<m-image :src="loadingSrc" width="110px" height="110px">
							<template #loading>
								<text class="slot-text">加载中...</text>
							</template>
						</m-image>
						<text class="caption">loading 插槽</text>
					</view>
					<view class="mode-item">
						<m-image :src="loadingSrc" width="110px" height="110px" :show-loading="false" />
						<text class="caption">show-loading false</text>
					</view>
				</view>
				<view class="reload-btn" @click="reloadLoading">
					<text class="reload-btn-text">重新加载（破缓存观察占位）</text>
				</view>
			</view>

			<text class="section">加载失败提示</text>
			<view class="card">
				<view class="mode-grid">
					<view class="mode-item">
						<m-image :src="demoBase + 'nonexistent.jpg'" width="110px" height="110px" />
						<text class="caption">默认图标</text>
					</view>
					<view class="mode-item">
						<m-image :src="demoBase + 'nonexistent.jpg'" width="110px" height="110px" error-icon="photo-o" />
						<text class="caption">自定义图标</text>
					</view>
					<view class="mode-item">
						<m-image :src="demoBase + 'nonexistent.jpg'" width="110px" height="110px">
							<template #error>
								<text class="slot-text">加载失败</text>
							</template>
						</m-image>
						<text class="caption">error 插槽</text>
					</view>
					<view class="mode-item">
						<m-image :src="demoBase + 'nonexistent.jpg'" width="110px" height="110px" :show-error="false" />
						<text class="caption">show-error false</text>
					</view>
				</view>
			</view>

			<text class="section">淡入动画</text>
			<view class="card">
				<view class="row-gap">
					<m-image :src="fadeSrc" width="130px" height="130px" />
					<m-image :src="fadeSrc" width="130px" height="130px" :fade="false" custom-class="row-gap-item" />
				</view>
				<text class="caption">左 fade 默认（加载完成 300ms 淡入）/ 右 fade false（直接显示）</text>
				<view class="reload-btn" @click="reloadFade">
					<text class="reload-btn-text">重新加载（对比淡入差异）</text>
				</view>
			</view>

			<text class="section">点击事件</text>
			<view class="card">
				<m-image :src="demoBase + 'demo-forest.jpg'" width="160px" height="120px" @click="onImageClick" />
				<text class="caption">点击图片查看 console 输出</text>
			</view>

			<text class="section" id="preview">点击预览</text>
			<view class="card">
				<view class="row-gap">
					<m-image :src="demoBase + 'demo-cat.jpg'" width="110px" height="110px" preview />
					<m-image :src="demoBase + 'demo-fruit.jpg'" width="110px" height="110px" preview custom-class="row-gap-item" />
				</view>
				<text class="caption">preview 单图预览：未传 preview-list 时使用自身 src</text>
				<view class="row-gap" style="margin-top: 12px;">
					<m-image
						v-for="(item, index) in previewSrcs"
						:key="index"
						:src="item"
						width="80px"
						height="80px"
						preview
						:preview-list="previewSrcs"
						custom-class="preview-item"
					/>
				</view>
				<text class="caption">preview-list 多图预览：4 张一组，起始索引自动取当前 src 在列表中的位置</text>
				<view class="row-gap" style="margin-top: 12px;">
					<m-image :src="demoBase + 'demo-mountain.jpg'" width="110px" height="110px" preview :preview-list="previewSrcs" :preview-current="2" @click="onPreviewClick" />
				</view>
				<text class="caption">preview-current 显式指定起始索引（点击固定从第 3 张开始）；click 事件与预览并存（console 输出）</text>
			</view>
		</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	// 页面声明宏：构建期由 routeGen 插件剥离，是 pages.json 条目与路由表的事实源
	defineUniPage({ title: '图片 Image', name: 'image' })
	/**
	 * 演示图基址：仓库 packages/playground/static/demo 目录的 GitHub raw 地址
	 * （图片随仓库维护，分支为 master；更换分支或目录时需同步修改）
	 */
	const demoBase = 'https://raw.githubusercontent.com/MengXi-Studio/unix-ui/master/packages/playground/static/demo/'

	/** 懒加载轮换图名（与 static/demo 下文件名一一对应） */
	const demoNames = ['cat', 'fruit', 'mountain', 'forest']

	/**
	 * 懒加载演示图列表：4 张演示图循环取 10 张
	 */
	const lazySrcs = ref<string[]>([])
	for (let i = 1; i <= 10; i++) {
		lazySrcs.value.push(demoBase + 'demo-' + demoNames[(i - 1) % 4] + '.jpg')
	}

	/** 加载中演示图时间戳（破缓存，点击重新加载后必然重新请求触发 loading 态） */
	const loadingTs = ref<number>(0)

	/** 加载中演示图地址（带时间戳 query） */
	const loadingSrc = computed<string>(() => {
		return demoBase + 'demo-fruit.jpg?v=' + loadingTs.value.toString()
	})

	/**
	 * 重新加载加载中演示图：时间戳更新使 src 变化，组件 watch 重置 loading 后重新请求
	 */
	function reloadLoading() {
		loadingTs.value = Date.now()
	}

	/** 淡入演示图时间戳 */
	const fadeTs = ref<number>(0)

	/** 淡入演示图地址（带时间戳 query） */
	const fadeSrc = computed<string>(() => {
		return demoBase + 'demo-mountain.jpg?v=' + fadeTs.value.toString()
	})

	/**
	 * 重新加载淡入演示图
	 */
	function reloadFade() {
		fadeTs.value = Date.now()
	}

	/**
	 * 点击事件演示：真实点击触发组件 click 透传
	 */
	function onImageClick(e: MouseEvent) {
		console.log('[image demo] image clicked')
	}

	/** 多图预览演示列表：4 张演示图各一张 */
	const previewSrcs = ref<string[]>([])
	for (let i = 0; i < demoNames.length; i++) {
		previewSrcs.value.push(demoBase + 'demo-' + demoNames[i] + '.jpg')
	}

	/**
	 * 预览与 click 并存演示：preview 开启时 click 仍透传（既弹预览又触发监听）
	 */
	function onPreviewClick(e: MouseEvent) {
		console.log('[image demo] preview image clicked (preview opens too)')
	}
</script>

<style lang="scss">
	/* mode 全值对照网格：两列等宽换行 */
	.mode-grid {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
	}
	.mode-item {
		width: 50%;
		align-items: center;
		margin-bottom: 12px;
	}
	/* 预览图组间距：v-for 项统一右间距（无子级选择器区分首项，间隔用 margin-right 实现） */
	.preview-item {
		margin-right: 8px;
	}
	/* 插槽文字（加载中 / 失败自定义内容） */
	.slot-text {
		font-size: 12px;
		color: #969799;
	}
	/* 演示页重载按钮 */
	.reload-btn {
		align-self: flex-start;
		margin-top: 4px;
		padding: 7px 14px;
		background-color: #1989fa;
		border-radius: 4px;
	}
	.reload-btn-text {
		font-size: 13px;
		color: #ffffff;
	}
	/* 图组间距（首个子项不加类，其余经 row-gap-item 加左间距——App 端 ucss 不支持 gap 且无子级选择器） */
	.row-gap {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		margin-bottom: 8px;
	}
	.row-gap-item {
		margin-left: 12px;
	}
	.caption {
		font-size: 12px;
		color: #969799;
		margin-top: 4px;
	}
</style>
