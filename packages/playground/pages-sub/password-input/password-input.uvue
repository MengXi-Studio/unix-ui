<template>
	<view class="page">
		<demo-navbar title="密码输入格子" subtitle="PasswordInput" />
		<demo-bridge />
		<scroll-view class="page-body" :scroll-y="true">
		<view class="container">

			<text class="section" id="bordered">方框风格（默认，可交互）</text>
			<view class="card">
				<m-password-input
					:value="v1"
					:length="6"
					:gap="8"
					:focused="kb1Show"
					@focus="kb1Show = true"
				/>
				<text class="caption">点击格子唤起键盘，输入 / 删除实时生效；填满 6 位后数字键自动禁用</text>
				<m-number-keyboard
					v-if="kb1Show"
					:disabled-key="kb1DisabledKey"
					@input="onKb1Input"
					@delete="onKb1Delete"
					@close="kb1Show = false"
				/>
			</view>

			<text class="section" id="underlined">下划线风格</text>
			<view class="card">
				<m-password-input
					:value="v2"
					type="underlined"
					:length="6"
					:gap="10"
					:focused="true"
				/>
				<text class="caption">只画底线，聚焦位底线变主题色</text>
			</view>

			<text class="section" id="gap">大间距</text>
			<view class="card">
				<m-password-input
					:value="v3"
					:length="6"
					:gap="20"
					:focused="true"
				/>
			</view>

			<text class="section" id="plaintext">明文显示（验证码场景）</text>
			<view class="card">
				<m-password-input
					value="8865"
					:length="6"
					:mask="false"
					:focused="true"
				/>
				<text class="caption">mask=false 或 plainText=true 均显示原字符</text>
			</view>

			<text class="section" id="dot">mask 圆点（已填 3 位）</text>
			<view class="card">
				<m-password-input
					value="123"
					:length="6"
					:mask="true"
					:focused="true"
				/>
			</view>

			<text class="section" id="disabled">禁用态</text>
			<view class="card">
				<m-password-input
					value="456"
					:length="6"
					disabled
					:focused="true"
				/>
				<text class="caption">整行灰显，点击不派发 focus</text>
			</view>

			<text class="section" id="readonly">只读态</text>
			<view class="card">
				<m-password-input
					value="7890"
					:length="6"
					readonly
					:focused="true"
				/>
				<text class="caption">视觉正常但点击不派发 focus</text>
			</view>

			<text class="section" id="info">下方提示文字</text>
			<view class="card">
				<m-password-input
					value="12345"
					:length="6"
					:focused="true"
					info="密码为 6 位数字"
					error-info=""
				/>
				<view style="margin-top: 16px"></view>
				<m-password-input
					value="12345"
					:length="6"
					:focused="true"
					info="密码为 6 位数字"
					error-info="密码错误，请重新输入"
				/>
				<text class="caption">error-info 优先于 info（第二行）</text>
			</view>

		</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	// 页面声明宏：routeGen 自动生成 pages.json 条目与路由表
	defineUniPage({ title: '密码输入格子 PasswordInput', name: 'password-input' })

	/** 各变体演示 value（手动预填，focused=true 显示光标） */
	const v1 = ref('')
	const v2 = ref('')
	const v3 = ref('')

	/** 卡 1 交互键盘显隐 */
	const kb1Show = ref(false)

	/**
	 * 卡 1 键盘按键禁用：填满 6 位后数字键全部禁用
	 * @param key 按键文本
	 * @returns 是否禁用
	 */
	function kb1DisabledKey(key: string): boolean {
		if (key == '' || key == 'delete' || key == 'close') return false
		return v1.value.length >= 6
	}

	/**
	 * 卡 1 键盘输入：收敛 maxlength=6
	 * @param key 按键文本
	 */
	function onKb1Input(key: string) {
		if (v1.value.length < 6) {
			v1.value += key
		}
	}

	/** 卡 1 键盘删除 */
	function onKb1Delete() {
		v1.value = v1.value.substring(0, v1.value.length - 1)
	}
</script>

<style>
	/* 演示页内联样式——页面级通用 */
	.caption {
		margin-top: 8px;
		font-size: 12px;
		color: #969799;
	}
</style>
