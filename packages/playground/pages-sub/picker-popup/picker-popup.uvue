<template>
	<view class="page">
		<demo-navbar title="选择器弹出框" subtitle="PickerPopup" />
		<demo-bridge />
		<scroll-view class="page-body" :scroll-y="true">
		<view class="container">

			<text class="section" id="basic">基础弹层</text>
			<view class="card">
				<m-button block @click="openBasic">打开选择器</m-button>
				<m-picker-popup
					v-model:show="basicShow"
					:columns="lineOptions"
					title="选择产线"
					@change="onBasicChange"
					@confirm="onBasicConfirm"
					@cancel="onBasicCancel"
					@opened="onBasicOpened"
					@closed="onBasicClosed"
				/>
				<view class="event-log">
					<text class="event-text">最近事件：{{ basicLog }}</text>
				</view>
				<text class="caption">默认底部弹出 + 圆角 + 遮罩可关；确认 / 取消后自动关闭并派发 update:show</text>
			</view>

			<text class="section" id="controlled">受控选中值</text>
			<view class="card">
				<m-button block @click="openControlled">打开（受控回显「包装五线」）</m-button>
				<view class="demo-btn-gap">
					<m-button block @click="clearControlled">清空受控值</m-button>
				</view>
				<m-picker-popup v-model:show="controlledShow" v-model:value="controlledValue" :columns="lineOptions" title="选择产线" />
				<view class="event-log">
					<text class="event-text">受控值：{{ formatValue(controlledValue) }}</text>
				</view>
				<text class="caption">v-model:value 受控：确认后回写；外部赋值后打开弹层滚轮选中态跟随</text>
			</view>

			<text class="section" id="columns">多列与级联</text>
			<view class="card">
				<m-button block @click="openMulti">打开（多列年月日）</m-button>
				<view class="demo-btn-gap">
					<m-button block @click="openCascade">打开（级联地区）</m-button>
				</view>
				<m-picker-popup v-model:show="multiShow" v-model:value="multiValue" :columns="yearMonthDay" title="年月日" />
				<m-picker-popup v-model:show="cascadeShow" v-model:value="cascadeValue" :columns="regionTree" title="选择地区" />
				<view class="event-log">
					<text class="event-text">多列：{{ formatValue(multiValue) }}</text>
				</view>
				<view class="event-log">
					<text class="event-text">级联：{{ formatValue(cascadeValue) }}</text>
				</view>
				<text class="caption">多列各列独立滚动；级联切换上层后下层重建并回到首项</text>
			</view>

			<text class="section" id="slots">插槽与状态</text>
			<view class="card">
				<m-button block @click="openSlots">打开（自定义确认 + columns-top）</m-button>
				<m-picker-popup v-model:show="slotsShow" :columns="lineOptions" title="产线">
					<template #columns-top>
						<view class="demo-hint"><text class="demo-hint-text">提示：上下滑动选择</text></view>
					</template>
					<template #confirm>
						<text class="demo-slot-confirm">完成</text>
					</template>
				</m-picker-popup>
				<view class="demo-btn-gap">
					<m-button block @click="openStates">打开（只读 + 加载中）</m-button>
				</view>
				<m-picker-popup v-model:show="statesShow" :columns="lineOptions" :value="'注塑二线'" readonly loading />
				<text class="caption">toolbar / title / confirm / cancel / option / columns-top / columns-bottom 插槽透传到面板</text>
			</view>

		</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	// 页面声明宏：构建期由 routeGen 插件剥离，是 pages.json 条目与路由表的事实源
	defineUniPage({ title: '选择器弹出框 PickerPopup', name: 'picker-popup' })
	import { PickerOption, PickerValue } from '@/uni_modules/m-ui-x/components/m-picker/picker.uts'

	/** 值转展示文本 */
	function formatValue(value: PickerValue | null): string {
		if (value == null) {
			return 'null'
		}
		if (Array.isArray(value)) {
			const list = value as (string | number)[]
			const parts: string[] = []
			for (let i = 0; i < list.length; i++) {
				parts.push(list[i].toString())
			}
			return parts.join(' / ')
		}
		return (value as string | number).toString()
	}

	const lineOptions: PickerOption[] = [
		{ label: '机加工一线', value: '机加工一线' } as PickerOption,
		{ label: '注塑二线', value: '注塑二线' } as PickerOption,
		{ label: '压铸四线', value: '压铸四线' } as PickerOption,
		{ label: '包装五线', value: '包装五线' } as PickerOption
	]

	const yearMonthDay: PickerOption[][] = [
		[
			{ label: '2024', value: 2024 } as PickerOption,
			{ label: '2025', value: 2025 } as PickerOption,
			{ label: '2026', value: 2026 } as PickerOption
		],
		[
			{ label: '1 月', value: 1 } as PickerOption,
			{ label: '2 月', value: 2 } as PickerOption,
			{ label: '3 月', value: 3 } as PickerOption
		],
		[
			{ label: '1 日', value: 1 } as PickerOption,
			{ label: '15 日', value: 15 } as PickerOption,
			{ label: '28 日', value: 28 } as PickerOption
		]
	]

	const regionTree: PickerOption[] = [
		{
			label: '华东厂区',
			value: 1000,
			children: [
				{
					label: '机加车间',
					value: 1100,
					children: [
						{ label: '机加工一线', value: 1110 } as PickerOption,
						{ label: '机加工二线', value: 1111 } as PickerOption
					]
				}
			]
		} as PickerOption,
		{
			label: '华南厂区',
			value: 2000,
			children: [
				{
					label: '注塑车间',
					value: 2100,
					children: [
						{ label: '注塑二线', value: 2110 } as PickerOption
					]
				} as PickerOption
			]
		} as PickerOption
	]

	// ========== 1 基础弹层 ==========
	const basicShow = ref<boolean>(false)
	const basicLog = ref<string>('（等待交互）')

	/** 打开弹层 */
	const openBasic = () => {
		basicShow.value = true
	}

	/** change 记录 */
	const onBasicChange = (value: PickerValue | null, selectedOptions: PickerOption[], indexes: number[]) => {
		basicLog.value = 'change → ' + formatValue(value)
	}

	/** confirm 记录 */
	const onBasicConfirm = (value: PickerValue | null, selectedOptions: PickerOption[], indexes: number[]) => {
		basicLog.value = 'confirm → ' + formatValue(value)
	}

	/** cancel 记录 */
	const onBasicCancel = () => {
		basicLog.value = 'cancel'
	}

	const onBasicOpened = () => {
		basicLog.value = 'opened'
	}

	const onBasicClosed = () => {
		if (basicLog.value == 'cancel' || basicLog.value.indexOf('confirm') == 0) {
			return
		}
		basicLog.value = 'closed'
	}

	// ========== 2 受控选中值 ==========
	const controlledShow = ref<boolean>(false)
	const controlledValue = ref<PickerValue | null>('包装五线')

	/** 打开受控弹层 */
	const openControlled = () => {
		controlledShow.value = true
	}

	/** 清空受控值 */
	const clearControlled = () => {
		controlledValue.value = null
	}

	// ========== 3 多列与级联 ==========
	const multiShow = ref<boolean>(false)
	const cascadeShow = ref<boolean>(false)
	const multiValue = ref<PickerValue | null>(null)
	const cascadeValue = ref<PickerValue | null>(null)

	/** 打开多列弹层 */
	const openMulti = () => {
		multiShow.value = true
	}

	/** 打开级联弹层 */
	const openCascade = () => {
		cascadeShow.value = true
	}

	// ========== 4 插槽与状态 ==========
	const slotsShow = ref<boolean>(false)
	const statesShow = ref<boolean>(false)

	/** 打开插槽演示弹层 */
	const openSlots = () => {
		slotsShow.value = true
	}

	/** 打开只读 / 加载弹层 */
	const openStates = () => {
		statesShow.value = true
	}
</script>

<style lang="scss">
	/* 事件日志展示行 */
	.event-log {
		margin-top: 12px;
	}
	.event-text {
		font-size: 12px;
		color: #1989fa;
	}
	.caption {
		font-size: 12px;
		color: #969799;
		margin-top: 8px;
	}
	.demo-btn-gap {
		margin-top: 12px;
	}
	.demo-hint {
		padding: 4px 0;
		justify-content: center;
		align-items: center;
	}
	.demo-hint-text {
		font-size: 11px;
		color: #969799;
	}
	.demo-slot-confirm {
		font-size: 14px;
		color: #ee0a24;
	}
</style>
