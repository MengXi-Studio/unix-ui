<template>
	<view class="page">
		<demo-navbar title="时间范围弹出框" subtitle="TimeRangePickerPopup" />
		<demo-bridge />
		<scroll-view class="page-body" :scroll-y="true">
		<view class="container">

			<text class="section" id="basic">基础弹层</text>
			<view class="card">
				<m-button block @click="openBasic">打开时间范围选择</m-button>
				<m-time-range-picker-popup
					v-model:show="basicShow"
					@change="onBasicChange"
					@confirm="onBasicConfirm"
					@cancel="onBasicCancel"
					@opened="onBasicOpened"
					@closed="onBasicClosed"
				/>
				<view class="event-log">
					<text class="event-text">最近事件：{{ basicLog }}</text>
				</view>
				<text class="caption">默认底部弹出 + 圆角 + 遮罩可关；确认 / 取消后自动关闭并派发 update:show</text>
			</view>

			<text class="section" id="controlled">受控选中值</text>
			<view class="card">
				<m-button block @click="openControlled">打开（受控回显 09:00 - 18:00）</m-button>
				<view class="demo-btn-gap">
					<m-button block @click="clearControlled">清空受控值</m-button>
				</view>
				<m-time-range-picker-popup v-model:show="controlledShow" v-model:value="controlledValue" :tabs="workTabs" />
				<view class="event-log">
					<text class="event-text">受控值：{{ formatValues(controlledValue) }}</text>
				</view>
				<text class="caption">v-model:value 受控：确认后回写两端值（升序）；外部赋值后打开弹层滚轮选中态跟随</text>
			</view>

			<text class="section" id="columns">步长、区间与 12 小时制</text>
			<view class="card">
				<m-button block @click="openStep">打开（15 分钟步长 + 09:00-18:00）</m-button>
				<view class="demo-btn-gap">
					<m-button block @click="openCycle">打开（12 小时制 + 时分秒）</m-button>
				</view>
				<m-time-range-picker-popup
					v-model:show="stepShow"
					:tabs="workTabs"
					:minute-step="15"
					min-time="09:00"
					max-time="18:00"
					@confirm="onStepConfirm"
				/>
				<m-time-range-picker-popup
					v-model:show="cycleShow"
					:columns-type="hmsColumns"
					:hour-cycle="12"
					@confirm="onCycleConfirm"
				/>
				<view class="event-log">
					<text class="event-text">最近确认：{{ lastLog }}</text>
				</view>
				<text class="caption">范围两端共用步长 / 区间 / 制式配置</text>
			</view>

			<text class="section" id="slots">插槽与状态</text>
			<view class="card">
				<m-button block @click="openSlots">打开（快捷选项 + 自定义确认）</m-button>
				<m-time-range-picker-popup v-model:show="slotsShow" v-model:value="slotsValue" :tabs="workTabs">
					<template #header>
						<view class="demo-shortcuts">
							<text class="demo-shortcut" @click="setMorning">上午</text>
							<text class="demo-shortcut" @click="setWorkTime">工作时间</text>
						</view>
					</template>
					<template #confirm>
						<text class="demo-slot-confirm">完成</text>
					</template>
				</m-time-range-picker-popup>
				<view class="event-log">
					<text class="event-text">当前值：{{ formatValues(slotsValue) }}</text>
				</view>
				<view class="demo-btn-gap">
					<m-button block @click="openStates">打开（只读 + 加载中）</m-button>
				</view>
				<m-time-range-picker-popup v-model:show="statesShow" :tabs="workTabs" :value="fixedValue" readonly loading />
				<text class="caption">header / title / footer / confirm / cancel 插槽透传到内部面板</text>
			</view>

		</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	// 页面声明宏：构建期由 routeGen 插件剥离，是 pages.json 条目与路由表的事实源
	defineUniPage({ title: '时间范围弹出框 TimeRangePickerPopup', name: 'time-range-picker-popup' })
	import { TimePickerColumnType } from '@/uni_modules/m-ui-x/components/m-time-picker/time-picker.uts'

	const hmsColumns: TimePickerColumnType[] = ['hour', 'minute', 'second']
	const workTabs: string[] = ['上班', '下班']

	/** 两端值转文本 */
	function formatValues(value: string[] | null): string {
		if (value == null || value.length == 0) {
			return 'null（未选）'
		}
		return value.join(' ~ ')
	}

	// ========== 1 基础弹层 ==========
	const basicShow = ref<boolean>(false)
	const basicLog = ref<string>('（等待交互）')

	/** 打开弹层 */
	const openBasic = () => {
		basicShow.value = true
	}

	/** change 记录 */
	const onBasicChange = (value: string[], activeIndex: number) => {
		basicLog.value = 'change → ' + formatValues(value)
	}

	/** confirm 记录 */
	const onBasicConfirm = (value: string[]) => {
		basicLog.value = 'confirm → ' + formatValues(value)
	}

	/** cancel 记录 */
	const onBasicCancel = () => {
		basicLog.value = 'cancel'
	}

	const onBasicOpened = () => {
		basicLog.value = 'opened'
	}

	const onBasicClosed = () => {
		if (basicLog.value == 'cancel' || basicLog.value.indexOf('confirm') == 0) {
			return
		}
		basicLog.value = 'closed'
	}

	// ========== 2 受控选中值 ==========
	const controlledShow = ref<boolean>(false)
	const controlledValue = ref<string[] | null>(['09:00', '18:00'])

	/** 打开受控弹层 */
	const openControlled = () => {
		controlledShow.value = true
	}

	/** 清空受控值 */
	const clearControlled = () => {
		controlledValue.value = null
	}

	// ========== 3 步长、区间与 12 小时制 ==========
	const stepShow = ref<boolean>(false)
	const cycleShow = ref<boolean>(false)
	const lastLog = ref<string>('（未确认）')

	/** 打开步长 / 区间弹层 */
	const openStep = () => {
		stepShow.value = true
	}

	/** 打开 12 制弹层 */
	const openCycle = () => {
		cycleShow.value = true
	}

	/** 步长 / 区间 confirm 记录 */
	const onStepConfirm = (value: string[]) => {
		lastLog.value = '步长区间 → ' + formatValues(value)
	}

	/** 12 制 confirm 记录 */
	const onCycleConfirm = (value: string[]) => {
		lastLog.value = '12 制 → ' + formatValues(value)
	}

	// ========== 4 插槽与状态 ==========
	const slotsShow = ref<boolean>(false)
	const slotsValue = ref<string[] | null>(null)
	const statesShow = ref<boolean>(false)
	/** 只读 / 加载演示固定值 */
	const fixedValue: string[] = ['09:00', '18:00']

	/** 打开插槽演示弹层 */
	const openSlots = () => {
		slotsShow.value = true
	}

	/** 上午快捷设置 */
	const setMorning = () => {
		slotsValue.value = ['08:00', '12:00']
	}

	/** 工作时间快捷设置 */
	const setWorkTime = () => {
		slotsValue.value = ['09:00', '18:00']
	}

	/** 打开只读 / 加载弹层 */
	const openStates = () => {
		statesShow.value = true
	}
</script>

<style lang="scss">
	/* 事件日志展示行 */
	.event-log {
		margin-top: 12px;
	}
	.event-text {
		font-size: 12px;
		color: #1989fa;
	}
	.caption {
		font-size: 12px;
		color: #969799;
		margin-top: 8px;
	}
	.demo-btn-gap {
		margin-top: 12px;
	}
	/* 快捷区演示 */
	.demo-shortcuts {
		flex-direction: row;
		justify-content: center;
		padding: 6px 0;
	}
	.demo-shortcut {
		font-size: 12px;
		color: #1989fa;
		margin: 0 8px;
	}
	.demo-slot-confirm {
		font-size: 14px;
		color: #ee0a24;
	}
</style>
