<template>
	<view class="page">
		<demo-navbar title="时间范围选择" subtitle="TimeRangePicker" />
		<demo-bridge />
		<scroll-view class="page-body" :scroll-y="true">
		<view class="container">

			<text class="section" id="basic">基础用法</text>
			<view class="card">
				<m-time-range-picker v-model:value="basicValue" @change="onBasicChange" @confirm="onBasicConfirm" />
				<view class="event-log">
					<text class="event-text">当前值：{{ formatValues(basicValue) }}；最近事件：{{ basicLog }}</text>
				</view>
				<text class="caption">默认「开始时间 / 结束时间」两段标题，切换编辑端；确认时若起点晚于终点自动交换为升序</text>
			</view>

			<text class="section" id="tabs">自定义标题与步长</text>
			<view class="card">
				<m-time-range-picker
					v-model:value="workValue"
					:tabs="workTabs"
					:minute-step="15"
					min-time="09:00"
					max-time="18:00"
					@confirm="onWorkConfirm"
				/>
				<view class="event-log">
					<text class="event-text">当前值：{{ formatValues(workValue) }}</text>
				</view>
				<text class="caption">tabs 自定义为「上班 / 下班」；15 分钟步长 + 09:00-18:00 区间</text>
			</view>

			<text class="section" id="cycle">12 小时制与时分秒</text>
			<view class="card">
				<m-time-range-picker
					v-model:value="cycleValue"
					:columns-type="hmsColumns"
					:hour-cycle="12"
					@confirm="onCycleConfirm"
				/>
				<view class="event-log">
					<text class="event-text">当前值：{{ formatValues(cycleValue) }}</text>
				</view>
				<text class="caption">columns-type['hour','minute','second'] + hour-cycle=12：两端均带「上午 / 下午」列</text>
			</view>

			<text class="section" id="slots">插槽</text>
			<view class="card">
				<m-time-range-picker v-model:value="slotValue" :tabs="workTabs" @confirm="onSlotConfirm">
					<template #header>
						<view class="demo-shortcuts">
							<text class="demo-shortcut" @click="setMorning">上午</text>
							<text class="demo-shortcut" @click="setWorkTime">工作时间</text>
							<text class="demo-shortcut" @click="clearSlot">清空</text>
						</view>
					</template>
					<template #title="{ tabs, activeIndex }">
						<view class="demo-custom-title">
							<text class="demo-custom-title-text">当前编辑：{{ slotTabText(tabs, activeIndex) }}</text>
						</view>
					</template>
					<template #confirm>
						<text class="demo-slot-confirm">完成</text>
					</template>
					<template #cancel>
						<text class="demo-slot-cancel">返回</text>
					</template>
				</m-time-range-picker>
				<view class="event-log">
					<text class="event-text">当前值：{{ formatValues(slotValue) }}</text>
				</view>
				<text class="caption">header 快捷按钮写入两端值；title 作用域含 tabs 与 activeIndex</text>
			</view>

			<text class="section" id="states">只读、加载与实例方法</text>
			<view class="card">
				<m-time-range-picker :value="fixedValue" readonly :tabs="workTabs" />
				<view class="demo-btn-row">
					<m-button size="small" @click="toggleLoading">{{ loading ? '关闭加载' : '开启加载' }}</m-button>
				</view>
				<m-time-range-picker :value="fixedValue" :loading="loading" :tabs="workTabs" custom-style="margin-top: 12px;" />
				<view class="demo-btn-row">
					<m-time-range-picker ref="methodPicker" :tabs="workTabs" />
				</view>
				<view class="demo-btn-row">
					<m-button size="small" @click="callGet">getSelectedValue</m-button>
				</view>
				<view class="event-log">
					<text class="event-text">最近调用：{{ methodLog }}</text>
				</view>
				<text class="caption">readonly 滚轮回弹；loading 覆盖滚轮区；getSelectedValue 读取升序两端值</text>
			</view>

		</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	// 页面声明宏：构建期由 routeGen 插件剥离，是 pages.json 条目与路由表的事实源
	defineUniPage({ title: '时间范围选择 TimeRangePicker', name: 'time-range-picker' })
	import { TimePickerColumnType } from '@/uni_modules/m-ui-x/components/m-time-picker/time-picker.uts'

	const hmsColumns: TimePickerColumnType[] = ['hour', 'minute', 'second']
	const workTabs: string[] = ['上班', '下班']

	/** 两端值转文本 */
	function formatValues(value: string[] | null): string {
		if (value == null || value.length == 0) {
			return 'null（未选）'
		}
		return value.join(' ~ ')
	}

	// ========== 1 基础用法 ==========
	const basicValue = ref<string[] | null>(null)
	const basicLog = ref<string>('（切换标题并滚动试试）')

	/** change 记录 */
	const onBasicChange = (value: string[], activeIndex: number) => {
		basicLog.value = 'change → ' + formatValues(value) + '（第 ' + (activeIndex + 1).toString() + ' 段）'
	}

	/** confirm 记录（两端自动升序） */
	const onBasicConfirm = (value: string[]) => {
		basicLog.value = 'confirm → ' + formatValues(value)
	}

	// ========== 2 自定义标题与步长 ==========
	const workValue = ref<string[] | null>(null)

	/** 工作时间 confirm 记录 */
	const onWorkConfirm = (value: string[]) => {
		workValue.value = value
	}

	// ========== 3 12 小时制与时分秒 ==========
	const cycleValue = ref<string[] | null>(null)

	/** 12 制 confirm 记录 */
	const onCycleConfirm = (value: string[]) => {
		cycleValue.value = value
	}

	// ========== 4 插槽 ==========
	const slotValue = ref<string[] | null>(null)

	/** title 插槽取值：作用域参数在 VDOM 生成 Kotlin 中为 Any?，须本地桥接后强转 */
	const slotTabText = (tabs: any | null, activeIndex: any | null): string => {
		if (tabs == null || activeIndex == null) {
			return ''
		}
		const list = tabs as string[]
		const index = activeIndex as number
		if (index < 0 || index >= list.length) {
			return ''
		}
		return list[index]
	}

	/** 上午快捷设置 */
	const setMorning = () => {
		slotValue.value = ['08:00', '12:00']
	}

	/** 工作时间快捷设置 */
	const setWorkTime = () => {
		slotValue.value = ['09:00', '18:00']
	}

	/** 清空快捷按钮 */
	const clearSlot = () => {
		slotValue.value = null
	}

	/** 插槽演示 confirm 记录 */
	const onSlotConfirm = (value: string[]) => {
		slotValue.value = value
	}

	// ========== 5 只读、加载与实例方法 ==========
	const fixedValue: string[] = ['09:00', '18:00']
	const loading = ref<boolean>(false)

	/** 切换加载态 */
	const toggleLoading = () => {
		loading.value = !loading.value
	}

	const methodPicker = ref<ComponentPublicInstance | null>(null)
	const methodLog = ref<string>('（点击按钮调用实例方法）')

	/** getSelectedValue：读取升序两端值 */
	const callGet = () => {
		const inst = methodPicker.value
		if (inst == null) {
			methodLog.value = '实例未就绪'
			return
		}
		const r = inst.$callMethod('getSelectedValue')
		if (r == null) {
			methodLog.value = 'getSelectedValue → 无'
		} else {
			methodLog.value = 'getSelectedValue → ' + formatValues(r as string[])
		}
	}
</script>

<style lang="scss">
	/* 事件日志展示行 */
	.event-log {
		margin-top: 12px;
	}
	.event-text {
		font-size: 12px;
		color: #1989fa;
	}
	.caption {
		font-size: 12px;
		color: #969799;
		margin-top: 8px;
	}
	/* 快捷区演示 */
	.demo-shortcuts {
		flex-direction: row;
		justify-content: center;
		padding: 6px 0;
	}
	.demo-shortcut {
		font-size: 12px;
		color: #1989fa;
		margin: 0 8px;
	}
	/* 自定义标题演示 */
	.demo-custom-title {
		flex-direction: row;
		justify-content: center;
		align-items: center;
		height: 44px;
	}
	.demo-custom-title-text {
		font-size: 14px;
		color: #07c160;
		font-weight: bold;
	}
	.demo-slot-confirm {
		font-size: 14px;
		color: #ee0a24;
	}
	.demo-slot-cancel {
		font-size: 14px;
		color: #969799;
	}
	.demo-btn-row {
		flex-direction: row;
		align-items: center;
		margin-top: 12px;
	}
</style>
