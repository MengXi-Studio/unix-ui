<template>
	<view class="page">
		<demo-navbar title="瀑布流" subtitle="Waterfall" />
		<demo-bridge />
		<scroll-view class="page-body" :scroll-y="true">
			<view class="container">
				<text class="section" id="basic">基础使用</text>
				<view class="card">
					<m-waterfall @loadstart="onBasicLoadStart" @load="onBasicLoad">
						<m-waterfall-item v-for="item in basicList" :key="item.id" #default="{ onLoad }">
							<view class="wf-item">
								<image class="wf-img" mode="widthFix" :src="item.url" @load="onLoad" @error="onLoad" />
								<text class="wf-title">{{ item.title }}</text>
							</view>
						</m-waterfall-item>
					</m-waterfall>
					<text class="caption">2 列默认布局；项内容需放在 m-waterfall-item 内，图片 @load / @error 调用插槽的 onLoad 以触发高度重测</text>
				</view>

				<text class="section" id="columns">列数与间距</text>
				<view class="card">
					<m-waterfall :columns="3" :column-gap="8" :row-gap="8" @loadstart="onBasicLoadStart" @load="onBasicLoad">
						<m-waterfall-item v-for="item in threeList" :key="item.id" #default="{ onLoad }">
							<view class="wf-item">
								<image class="wf-img" mode="widthFix" :src="item.url" @load="onLoad" @error="onLoad" />
								<text class="wf-title wf-title--small">{{ item.title }}</text>
							</view>
						</m-waterfall-item>
					</m-waterfall>
					<text class="caption">columns=3、column-gap=8、row-gap=8；列宽随容器宽度等分计算</text>
				</view>

				<text class="section" id="known">已知宽高</text>
				<view class="card">
					<m-waterfall :columns="2" :column-gap="8" :row-gap="8" @loadstart="onBasicLoadStart" @load="onBasicLoad">
						<m-waterfall-item v-for="item in knownList" :key="item.id" #default="{ onLoad }">
							<view class="wf-item">
								<m-waterfall-load
									:width="item.width"
									:height="item.height"
									:max-wait="300"
									@load="onLoad"
									#default="{ onLoad: onImageLoad, overtime }"
								>
									<image class="wf-img wf-img--fill" mode="aspectFill" :src="item.url" @load="(e) => onImageLoad(e)" @error="() => onImageLoad(null)" />
									<text v-if="overtime" class="wf-overtime">超时</text>
								</m-waterfall-load>
								<text class="wf-title">{{ item.title }}</text>
							</view>
						</m-waterfall-item>
					</m-waterfall>
					<text class="caption">width / height 只用于计算比例；max-wait=300ms 超时后按自定义比例排版</text>
				</view>

				<text class="section" id="dynamic">动态增删与 reflow</text>
				<view class="card">
					<view class="wf-actions">
						<m-button size="small" type="primary" @click="addItems">添加 2 项</m-button>
						<m-button size="small" plain type="primary" custom-style="margin-left: 8px;" @click="removeItems">移除 2 项</m-button>
						<m-button size="small" plain custom-style="margin-left: 8px;" @click="callReflow">reflow()</m-button>
					</view>
					<m-waterfall ref="waterfallRef" :columns="2" @loadstart="onBasicLoadStart" @load="onDynamicLoad">
						<m-waterfall-item v-for="item in dynamicList" :key="item.id" #default="{ onLoad }">
							<view class="wf-item">
								<image class="wf-img" mode="widthFix" :src="item.url" @load="onLoad" @error="onLoad" />
								<text class="wf-title">{{ item.title }}</text>
							</view>
						</m-waterfall-item>
					</m-waterfall>
					<text class="caption">变更项数据后自动重排；实例方法 reflow() 用于强制重测（如内容尺寸在框架外发生变化）</text>
				</view>

				<text class="section" id="events">事件与方法</text>
				<view class="card">
					<text class="wf-log">最近事件：{{ loadLog }}</text>
					<text class="wf-log">loadstart 次数：{{ loadstartCount }} / load 次数：{{ loadCount }}</text>
					<m-button size="small" plain custom-style="margin-top: 8px;" @click="callOnLoad">注册 onLoad 回调</m-button>
					<text class="caption">loadstart 在新一轮加载开始时触发，load 在全部项加载完成时触发；onLoad(handler) 会在空闲时下一帧立即回调</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	/** 瀑布流演示数据类型（id 用于 v-for key 与动态增删） */
	type WaterfallDemoItem = {
		id: number
		title: string
		url: string
		width: number
		height: number
	}

	/**
	 * 演示图基址：仓库 packages/playground/static/demo 目录的 GitHub raw 地址
	 * （与 image 演示页保持一致，更换分支或目录时需同步修改）
	 */
	const demoBase = 'https://raw.githubusercontent.com/MengXi-Studio/unix-ui/master/packages/playground/static/demo/'
	/** 演示图名（与 static/demo 下文件名一一对应） */
	const demoNames = ['cat', 'fruit', 'mountain', 'forest']
	/** 演示标题（长度不一，用于观察高度差异） */
	const demoTitles = ['猫咪写真', '水果拼盘与夏日冰饮的组合，一张会让人心情变好的图片', '山野日出', '森林徒步途中的光影记录，适合作为长时间阅读的配图']

	/**
	 * 生成演示数据
	 *
	 * @param start 起始 id
	 * @param count 数量
	 * @returns 演示项数组
	 */
	function buildItems(start: number, count: number): WaterfallDemoItem[] {
		const list: WaterfallDemoItem[] = []
		let i = 0
		while (i < count) {
			list.push({
				id: start + i,
				title: demoTitles[i % 4],
				url: demoBase + 'demo-' + demoNames[i % 4] + '.jpg',
				width: 300,
				height: 220 + (i % 3) * 60
			})
			i++
		}
		return list
	}

	/** 基础演示数据（2 列） */
	const basicList = ref<WaterfallDemoItem[]>(buildItems(1, 6))
	/** 自定义列数演示数据（3 列） */
	const threeList = ref<WaterfallDemoItem[]>(buildItems(7, 9))
	/** 已知宽高演示数据 */
	const knownList = ref<WaterfallDemoItem[]>(buildItems(16, 6))
	/** 动态增删演示数据 */
	const dynamicList = ref<WaterfallDemoItem[]>(buildItems(22, 4))
	/** 动态增删时的下一个 id */
	const dynamicSeed = ref(26)
	/** 事件日志 */
	const loadLog = ref('等待加载')
	/** loadstart 次数 */
	const loadstartCount = ref(0)
	/** load 次数 */
	const loadCount = ref(0)
	/** 动态演示容器实例（调用 reflow / onLoad 实例方法） */
	const waterfallRef = ref<ComponentPublicInstance | null>(null)

	/** loadstart：新一轮加载开始 */
	function onBasicLoadStart() {
		loadstartCount.value++
		loadLog.value = 'loadstart'
	}

	/** load：当前全部项加载完成 */
	function onBasicLoad() {
		loadCount.value++
		loadLog.value = 'load'
	}

	/** 动态演示的 load：记录项数 */
	function onDynamicLoad() {
		loadCount.value++
		loadLog.value = 'load（动态 ' + dynamicList.value.length.toString() + ' 项）'
	}

	/** 添加 2 项：v-for 注册新项后自动排版 */
	function addItems() {
		const next = buildItems(dynamicSeed.value, 2)
		let i = 0
		while (i < next.length) {
			dynamicList.value.push(next[i])
			i++
		}
		dynamicSeed.value += 2
	}

	/** 移除末尾 2 项：注销后自动重排 */
	function removeItems() {
		let i = 0
		while (i < 2 && dynamicList.value.length > 1) {
			dynamicList.value.pop()
			i++
		}
	}

	/** 调用实例方法 reflow：重测容器宽度与全部项高度 */
	function callReflow() {
		const inst = waterfallRef.value
		if (inst == null) {
			loadLog.value = '实例未就绪'
			return
		}
		inst.$callMethod('reflow')
		loadLog.value = 'reflow 已调用'
	}

	/** 调用实例方法 onLoad：空闲时下一帧回调 */
	function callOnLoad() {
		const inst = waterfallRef.value
		if (inst == null) {
			loadLog.value = '实例未就绪'
			return
		}
		inst.$callMethod('onLoad', () => {
			loadLog.value = 'onLoad 回调执行（全部项已加载）'
		})
	}
</script>

<style lang="scss">
	/* 项内容：白底卡片，图片顶部圆角 */
	.wf-item {
		flex-direction: column;
		background-color: #ffffff;
		border-radius: 8px;
		overflow: hidden;
	}
	/* 图片：宽度铺满列宽，高度由 widthFix 按比例撑开 */
	.wf-img {
		width: 100%;
	}
	/* 图片：比例盒内铺满（aspectFill 裁剪） */
	.wf-img--fill {
		height: 100%;
	}
	/* 标题 */
	.wf-title {
		font-size: 13px;
		color: #323233;
		padding: 8px;
	}
	/* 小号标题（3 列演示） */
	.wf-title--small {
		font-size: 11px;
		padding: 6px;
	}
	/* 超时角标 */
	.wf-overtime {
		position: absolute;
		left: 0;
		top: 0;
		font-size: 10px;
		color: #ffffff;
		background-color: #ee0a24;
		padding: 2px 6px;
	}
	/* 操作按钮行 */
	.wf-actions {
		flex-direction: row;
		margin-bottom: 12px;
	}
	/* 事件日志行 */
	.wf-log {
		font-size: 12px;
		color: #323233;
		margin-bottom: 4px;
	}
	/* 说明文案 */
	.caption {
		font-size: 12px;
		color: #969799;
		margin-top: 8px;
	}
</style>
