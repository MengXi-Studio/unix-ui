/**
 * 组件演示条目数据表（首页分组导航的唯一数据源）
 *
 * 新增组件时在对应分组的 components 中登记一条即可，
 * 首页分组列表与搜索过滤自动生效；演示页路由无需手工登记——
 * 在页面 defineUniPage 宏声明 name / title，pages.json 与路由表由 routeGen 插件生成。
 */

/** 组件演示条目 */
export type DemoComponent = {
	/** 路由名（router.push 按名导航，须与页面 defineUniPage 宏的 name 一致） */
	name: string
	/** 中文名 */
	zhName: string
	/** 英文标识（与组件目录名一致） */
	enName: string
	/** 一句话简介 */
	desc: string
}

/** 演示分组 */
export type DemoGroup = {
	/** 分组标题 */
	title: string
	/** 组内组件条目 */
	components: DemoComponent[]
}

/**
 * 组件演示分组表（标准 UI 库分类体系：基础 / 布局 / 数据录入 / 选择器 / 日期时间 / 反馈 / 数据展示 / 导航，组内按字母序）
 *
 * 新增组件时在对应分组的 components 中登记一条即可，
 * 首页分组列表与搜索过滤自动生效；演示页路由无需手工登记——
 * 在页面 defineUniPage 宏声明 name / title，pages.json 与路由表由 routeGen 插件生成。
 */
