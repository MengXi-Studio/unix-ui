import type { RouteConfig } from '@/uni_modules/ux-router/utssdk/index.uts'
import { routes as generatedRoutes } from './routes.gen.uts'

/**
 * 应用路由表（playground 示例工程）
 *
 * 主体来自构建期 routeGen 插件的生成产物 routes.gen.uts——页面路径 / name / title
 * 的事实源在各页面的 defineUniPage 宏声明（新增 / 改名页面只需改宏，pages.json 与
 * 路由表由插件自动同步）。本文件仅承担生成器无法表达的显式扩展：同一 path 挂多条
 * 命名路由的别名条目。meta.title 供 afterEach 守卫更新 Web 端 document.title。
 */
// 级联三组件共用一个演示页（cascader 页内穷举 popup / input 区块），两条命名路由指向同一 path
const cascaderAliases: RouteConfig[] = [
	{ path: 'pages-sub/cascader/cascader', name: 'cascader-popup', meta: { title: '级联弹出框 CascaderPopup' } },
	{ path: 'pages-sub/cascader/cascader', name: 'cascader-input', meta: { title: '级联输入框 CascaderInput' } }
]

export const routes: RouteConfig[] = generatedRoutes.concat(cascaderAliases)
