<template>
	<!-- 级联输入框：m-input（只读展示）+ m-cascader-popup 组合（三组件拆分后的表单触发组件）。
	     触发器点击整区打开弹层，finish 后经 v-model:value 回写叶子值并展示路径文字；
	     清空为自绘按钮（m-input 内置 clearable 的图标位于触发层之下会被挡住） -->
	<!-- 开启逻辑挂在触发层而非根节点：弹层遮罩点击会沿 DOM 冒泡经过本组件根，
	     若根监听 @click 会在遮罩关闭的同一事件派发内把 show 置回 true（关闭即重开） -->
	<view :class="rootClass" :style="customStyle">
		<m-input
			:model-value="displayText"
			:placeholder="placeholder"
			:disabled="disabled"
			:border="border"
			:inlaid="inlaid"
			:custom-style="inputStyle"
		/>
		<!-- 透明触发层：m-input 的 readonly 以原生 disabled 模拟，原生 disabled 控件吞点击事件，
		     覆盖层接住整区点击打开弹层（disabled 态不渲染） -->
		<view v-if="!disabled" class="m-cascader-input__trigger" @click="onTriggerClick"></view>
		<view v-if="showClear" class="m-cascader-input__clear" @click.stop="onClearClick">
			<m-icon name="clear" custom-class="m-cascader-input__clear-icon" />
		</view>
		<!-- z-index 3 高于触发层(1)/清空钮(2)：弹层遮罩须盖住本组件浮层，见 vars.scss 层叠注释 -->
		<m-cascader-popup
			v-model:show="popupShow"
			:value="value"
			:options="options"
			:title="title"
			:placeholder="placeholder"
			:active-color="activeColor"
			:field-names="fieldNames"
			:options-height="optionsHeight"
			:swipeable="swipeable"
			:position="position"
			:round="round"
			:z-index="3"
			@change="onCascChange"
			@finish="onCascFinish"
		/>
	</view>
</template>

<script setup lang="uts">
	/**
	 * m-cascader-input 级联输入框：m-input + m-cascader-popup 组合组件。
	 * 值单向受控：外部 value（v-model:value）同步弹层级联面板选中态，
	 * finish 后经 update:value 回写叶子值；展示文本由 value 在选项树中
	 * 查找路径后派生（各级文字以「/」连接，未找到时回退 value 字符串）。
	 */
	import {
		CascaderValue,
		CascaderFieldNames,
		CascaderChangeEvent,
		DEFAULT_CASCADER_FIELD_NAMES,
		cascaderOptionText,
		cascaderOptionValueString,
		findCascaderPath
	} from '../m-cascader/cascader.uts'

	/** 弹出方位（与 m-popup 的 position 取值一致） */
	type CascaderPopupPosition = 'top' | 'bottom' | 'left' | 'right' | 'center'

	type Props = {
		/** 选中值（v-model:value；叶子 value，null 未选） */
		value?: CascaderValue
		/** 级联选项树（动态类型：UTSJSONObject[]） */
		options?: UTSJSONObject[]
		/** 占位符 */
		placeholder?: string
		/** 是否禁用 */
		disabled?: boolean
		/** 是否显示清空按钮（有值且非 disabled 时可见） */
		clearable?: boolean
		/** 触发器是否显示边框容器（透传 m-input） */
		border?: boolean
		/** 触发器嵌入式形态（透传 m-input） */
		inlaid?: boolean
		/** 弹层常规标题 */
		title?: string
		/** 主题色（选中项文字与对勾、tab 下划线） */
		activeColor?: string
		/** 自定义选项字段名（null 用默认 text / value / children） */
		fieldNames?: CascaderFieldNames
		/** 选项区高度 px（0 用主题变量 $m-cascader-options-height） */
		optionsHeight?: number
		/** 是否支持手势滑动切换层级 */
		swipeable?: boolean
		/** 弹出方位（透传 m-popup，默认底部） */
		position?: CascaderPopupPosition
		/** 弹层圆角（透传 m-popup） */
		round?: boolean
		/** 自定义根节点类名 */
		customClass?: string.ClassString
		/** 自定义根节点内联样式 */
		customStyle?: string
	}

	const props = withDefaults(defineProps<Props>(), {
		value: null,
		options: null,
		placeholder: '请选择',
		disabled: false,
		clearable: true,
		border: true,
		inlaid: false,
		title: '',
		activeColor: '',
		fieldNames: null,
		optionsHeight: 0,
		swipeable: true,
		position: 'bottom',
		round: true,
		customClass: '',
		customStyle: ''
	})

	const emit = defineEmits<{
		/** finish 后回写选中值（叶子 value，清空回写 null） */
		'update:value': [value: CascaderValue | null]
		/** 点击选项后触发（透传弹层级联面板） */
		change: [event: CascaderChangeEvent]
		/** 选完最后一级后触发（弹层同步自动关闭） */
		finish: [event: CascaderChangeEvent]
		/** 点击清空按钮后触发 */
		clear: []
	}>()

	/** 弹层显隐（内部状态；finish 后由 m-cascader-popup 派发 update:show 关闭） */
	const popupShow = ref<boolean>(false)

	/** 根类名：基础类 + customClass 透传（对齐 m-input 拼接惯例） */
	const rootClass = computed<string>(() => {
		let cls = 'm-cascader-input'
		if (props.customClass != '') cls += ' ' + props.customClass
		return cls
	})

	/** 字段名映射（null 用默认） */
	const fields = computed<CascaderFieldNames>(() => {
		const f = props.fieldNames
		if (f != null) {
			return f
		}
		return DEFAULT_CASCADER_FIELD_NAMES
	})

	/** 是否有值 */
	const hasValue = computed<boolean>(() => {
		return props.value != null
	})

	/** 清空按钮可见性 */
	const showClear = computed<boolean>(() => {
		return props.clearable && !props.disabled && hasValue.value
	})

	/** 展示文本：路径各级文字「/」连接；未找到回退 value 字符串 */
	const displayText = computed<string>(() => {
		const v = props.value
		if (v == null) {
			return ''
		}
		const o = props.options
		if (o != null) {
			const path = findCascaderPath(o, v.toString(), fields.value)
			if (path != null) {
				const parts: string[] = []
				for (let i = 0; i < path.length; i++) {
					parts.push(cascaderOptionText(path[i], fields.value))
				}
				return parts.join('/')
			}
		}
		return v.toString()
	})

	/** 触发器内联样式：清空按钮显示时为输入区右侧预留按钮宽度（与 $m-cascader-input-clear-width 同步） */
	const inputStyle = computed<string>(() => {
		if (showClear.value) {
			return 'padding-right: 40px;'
		}
		return ''
	})

	/** 触发器点击：disabled 不响应，其余打开弹层 */
	function onTriggerClick() {
		if (props.disabled) {
			return
		}
		popupShow.value = true
	}

	/** 级联 change 透传（模板绑定的组件事件处理函数须 const 箭头函数，function 声明在 VDOM Kotlin 中报 Function invocation expected） */
	const onCascChange = (event: CascaderChangeEvent) => {
		emit('change', event)
	}

	/** finish 回写：值经 v-model 回写外部，弹层关闭由 m-cascader-popup 内部完成 */
	const onCascFinish = (event: CascaderChangeEvent) => {
		emit('update:value', event.value)
		emit('finish', event)
	}

	/** 清空：回写 null 并派发 clear（.stop 阻止冒泡到根触发器） */
	function onClearClick(e: MouseEvent) {
		emit('update:value', null)
		emit('clear')
	}
</script>

<style lang="scss">
	/*
	 * 主题变量说明（默认主题内置 + 变量覆盖）：
	 * 组件内顶层引入 theme/vars.scss（全部 !default），零配置即有默认主题；
	 * 覆盖方式：项目根 uni.scss 直接定义 $m-* 变量（禁止 @import vars.scss，
	 * uni.scss 注入机制与组件内引入同一文件会触发循环导入）。
	 */
	@import '../../theme/vars.scss';

	/* ========== 根（触发区，承载触发层与清空按钮的定位包含块） ========== */
	.m-cascader-input {
		position: relative;
	}

	/* ========== 透明触发层（覆盖整区接住点击，disabled 态不渲染） ========== */
	.m-cascader-input__trigger {
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		left: 0;
		z-index: $m-cascader-input-trigger-z-index;
	}

	/* ========== 清空按钮（触发层之上，右侧定宽纵向居中） ========== */
	.m-cascader-input__clear {
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		width: $m-cascader-input-clear-width;
		z-index: $m-cascader-input-clear-z-index;
		justify-content: center;
		align-items: center;
	}
	.m-cascader-input__clear-icon {
		font-size: $m-cascader-input-clear-icon-size;
		color: $m-cascader-input-clear-color;
	}
</style>
