<template>
	<!-- 滚轮列（不注册 easycom，仅供 m-date-picker.uvue 相对路径导入）：
	     原生 scroll-view 承载滚动，顶部 / 底部占位使选中项停在视口中心；
	     滚动停止后吸附到最近选项并上抛 change，自身不持有选中值（受控于 model-value 下标）。
	     渐隐靠每个选项的透明度类实现——uvue 无 pointer-events，覆盖式渐变遮罩会拦截滚动手势。 -->
	<scroll-view
		class="m-date-picker__column"
		:scroll-y="true"
		:scroll-top="scrollTopRequest"
		:show-scrollbar="false"
		:style="columnStyle"
		@scroll="onScroll"
	>
		<view :style="spacerStyle"></view>
		<view
			v-for="(option, index) in optionList"
			:key="index"
			:class="optionClass(index)"
			:style="optionStyle"
			@click="onOptionClick(index)"
		>
			<!-- #ifndef MP -->
			<slot name="option" :option="option" :index="index">
				<text :class="textClass(index)">{{ option.text }}</text>
			</slot>
			<!-- #endif -->
			<!-- #ifdef MP -->
			<!-- 小程序端同一实例内同名插槽仅第一个生效，v-for 内不使用插槽（LESSONS #17），回退内置文本 -->
			<text :class="textClass(index)">{{ option.text }}</text>
			<!-- #endif -->
		</view>
		<view :style="spacerStyle"></view>
	</scroll-view>
</template>

<script setup lang="uts">
	/**
	 * 日期选择滚轮列：受控渲染选项并吸附滚动。
	 * 交互约定：用户滚动 / 点击非选中项 → 吸附后派发 change(columnIndex, index)；
	 * readonly 时任何滚动都会回弹到 model-value 对应位置且不上抛。
	 */
	import { DatePickerOption } from './date-picker.uts'

	type Props = {
		/** 列选项（已由面板应用 filter / formatter；null 按空列渲染） */
		options?: DatePickerOption[]
		/** 选中项下标（受控，0 起） */
		modelValue: number
		/** 列在面板中的下标（事件回传用） */
		columnIndex: number
		/** 选项行高 px */
		optionHeight: number
		/** 可见选项个数（奇偶均可，偶数时上下半格） */
		visibleOptionNum: number
		/** 滚动停止判定时长 ms：停止滚动后延迟该时长吸附（对齐 Vant swipe-duration 的可调惯性意图） */
		swipeDuration: number
		/** 只读：不响应滚动切换 */
		readonly: boolean
		/** 禁用项标记（按索引对齐 options；null 表示无禁用；通用 Picker 使用，日期 / 时间不传） */
		disabledOptions?: boolean[]
		/** 重新定位令牌：宿主每次自增即触发按受控下标重新定位（弹层打开后滚动视口才真正可滚动） */
		positionToken?: number
	}

	const props = withDefaults(defineProps<Props>(), {
		options: null,
		modelValue: 0,
		columnIndex: 0,
		optionHeight: 44,
		visibleOptionNum: 6,
		swipeDuration: 200,
		readonly: false,
		disabledOptions: null,
		positionToken: 0
	})

	const emit = defineEmits<{
		/** 吸附完成且选中项变化（columnIndex 列下标，index 选项下标） */
		change: [columnIndex: number, index: number]
	}>()

	/** 绑定给 scroll-view 的滚动目标值（仅程序化定位时变更） */
	const scrollTopRequest = ref<number>(0)
	/** 实际滚动位置镜像（仅由 @scroll 回灌 SDK 真实位置，吸附判定与定位校验基准） */
	const actualTop = ref<number>(0)
	/** 视觉激活下标（滚动过程中实时更新，驱动透明度渐隐） */
	const activeIndex = ref<number>(0)
	/** 吸附判定定时器 id（-1 无） */
	let snapTimer = -1
	/** 程序化滚动标记：自身定位触发的 scroll 不再参与吸附 */
	let programmatic = false
	/** 程序化标记复位定时器 id */
	let programmaticTimer = -1
	/** 偏移 1px 后归位的定时器 id（-1 无） */
	let resetTimer = -1
	/** 定位校验定时器 id（-1 无） */
	let verifyTimer = -1
	/** 本次定位请求后是否发生过用户滚动（用户手势优先，取消校验重发） */
	let touchedAfterRequest = false

	/** 选项列表（props.options 为 null 时按空列渲染，避免首帧空指针） */
	const optionList = computed<DatePickerOption[]>(() => {
		const list = props.options
		if (list != null) {
			return list
		}
		const empty: DatePickerOption[] = []
		return empty
	})

	/** 列高度：行高 × 可见个数 */
	const columnStyle = computed<string>(() => {
		return 'height: ' + (props.optionHeight * props.visibleOptionNum).toString() + 'px;'
	})

	/** 上下占位高度：(可见个数 - 1) / 2 × 行高（偶数时半格，保证选中项居于视口中心） */
	const spacerStyle = computed<string>(() => {
		const pad = (props.visibleOptionNum - 1) / 2 * props.optionHeight
		return 'height: ' + pad.toString() + 'px;'
	})

	/** 选项行高 */
	const optionStyle = computed<string>(() => {
		return 'height: ' + props.optionHeight.toString() + 'px;'
	})

	/**
	 * 选项是否禁用（disabledOptions 未传时一律可用）
	 */
	function isDisabled(index: number): boolean {
		const flags = props.disabledOptions
		if (flags == null || index < 0 || index >= flags.length) {
			return false
		}
		return flags[index]
	}

	/**
	 * 从目标下标出发寻找最近可用项：先向下，再向上，全禁用时回退原下标
	 */
	function nearestEnabledIndex(index: number): number {
		const count = optionList.value.length
		if (count == 0) {
			return 0
		}
		let target = index
		if (target < 0) {
			target = 0
		}
		if (target > count - 1) {
			target = count - 1
		}
		if (!isDisabled(target)) {
			return target
		}
		for (let i = target + 1; i < count; i++) {
			if (!isDisabled(i)) {
				return i
			}
		}
		for (let i = target - 1; i >= 0; i--) {
			if (!isDisabled(i)) {
				return i
			}
		}
		return target
	}

	/**
	 * 选项容器类名：按与激活项的间距分三档透明度（远处淡出，替代无法使用的覆盖遮罩）；
	 * 禁用项追加禁用类（灰显）
	 */
	function optionClass(index: number): string {
		const distance = Math.abs(index - activeIndex.value)
		let cls = 'm-date-picker__option'
		if (distance == 0) {
			cls += ' m-date-picker__option--active'
		} else if (distance == 1) {
			cls += ' m-date-picker__option--near'
		} else {
			cls += ' m-date-picker__option--far'
		}
		if (isDisabled(index)) {
			cls += ' m-date-picker__option--disabled'
		}
		return cls
	}

	/**
	 * 选项文本类名：激活项高亮，其余常规
	 */
	function textClass(index: number): string {
		if (index == activeIndex.value) {
			return 'm-date-picker__option-text m-date-picker__option-text--active'
		}
		return 'm-date-picker__option-text'
	}

	/**
	 * 程序化滚动到指定下标：同值时属性更新不会重发，先偏移 1px 再归位强制生效；
	 * 归位用定时器而非 nextTick —— 小程序端相邻两次 setData 会合帧，同帧内先加后减等效于未变化。
	 * 不在此处回写 actualTop：镜像只认 @scroll 回灌的真实滚动位置。弹层首帧挂载时滚动视口高度为 0，
	 * scroll-top 会被忽略，若提前写入镜像，后续定位会误判「已到位」而直接跳过（issue #25）。
	 */
	function requestScroll(index: number, allowVerify: boolean = true) {
		const target = index * props.optionHeight
		programmatic = true
		touchedAfterRequest = false
		if (programmaticTimer != -1) {
			clearTimeout(programmaticTimer)
		}
		programmaticTimer = setTimeout(() => {
			programmatic = false
			programmaticTimer = -1
		}, 120)
		if (scrollTopRequest.value == target) {
			scrollTopRequest.value = target + 1
			if (resetTimer != -1) {
				clearTimeout(resetTimer)
			}
			resetTimer = setTimeout(() => {
				resetTimer = -1
				scrollTopRequest.value = target
			}, 50)
		} else {
			scrollTopRequest.value = target
		}
		if (allowVerify) {
			scheduleVerify(index)
		}
	}

	/**
	 * 定位校验：首帧挂载 / 弹层复开时滚动视口可能尚未布局完成，scroll-top 被忽略且不产生 @scroll；
	 * 延迟一帧按镜像判断是否到位，未到位则强制重发一次（只重试一层，避免隐藏态无限轮询）
	 */
	function scheduleVerify(index: number) {
		if (verifyTimer != -1) {
			clearTimeout(verifyTimer)
		}
		verifyTimer = setTimeout(() => {
			verifyTimer = -1
			// 用户已接管滚动时以手势为准，不拉回
			if (touchedAfterRequest) {
				return
			}
			const target = index * props.optionHeight
			if (Math.abs(actualTop.value - target) >= 1) {
				requestScroll(index, false)
			}
		}, 120)
	}

	/**
	 * 重新定位到受控下标：供宿主在弹层打开 / 布局变化后调用（此时滚动视口才真正可滚动）
	 */
	function reposition() {
		activeIndex.value = props.modelValue
		const target = props.modelValue * props.optionHeight
		if (Math.abs(actualTop.value - target) < 1) {
			return
		}
		requestScroll(props.modelValue)
	}

	/**
	 * 滚动停止：吸附到最近选项；readonly 回弹到受控下标；选中项变化时上抛 change
	 */
	function onScrollSettle() {
		const count = optionList.value.length
		if (count == 0) {
			return
		}
		if (props.readonly) {
			requestScroll(props.modelValue)
			return
		}
		let index = Math.round(actualTop.value / props.optionHeight)
		if (index < 0) {
			index = 0
		}
		if (index > count - 1) {
			index = count - 1
		}
		// 落在禁用项上时吸附到最近可用项
		index = nearestEnabledIndex(index)
		requestScroll(index)
		activeIndex.value = index
		if (index != props.modelValue) {
			emit('change', props.columnIndex, index)
		}
	}

	/**
	 * 滚动事件：同步镜像位置与视觉激活下标；非程序化滚动按 swipeDuration 延迟判定停止
	 */
	function onScroll(e: UniScrollEvent) {
		const top = e.detail.scrollTop
		actualTop.value = top
		const count = optionList.value.length
		if (count > 0) {
			let index = Math.round(top / props.optionHeight)
			if (index < 0) {
				index = 0
			}
			if (index > count - 1) {
				index = count - 1
			}
			if (index != activeIndex.value) {
				activeIndex.value = index
			}
		}
		if (programmatic) {
			return
		}
		touchedAfterRequest = true
		if (snapTimer != -1) {
			clearTimeout(snapTimer)
		}
		snapTimer = setTimeout(() => {
			snapTimer = -1
			onScrollSettle()
		}, props.swipeDuration)
	}

	/**
	 * 点击选项：只读或禁用项忽略；已选中项仅回正不派发
	 */
	function onOptionClick(index: number) {
		if (props.readonly || isDisabled(index)) {
			return
		}
		if (index == props.modelValue) {
			requestScroll(index)
			return
		}
		activeIndex.value = index
		requestScroll(index)
		emit('change', props.columnIndex, index)
	}

	// 受控下标变化（含父组件因选项数量收缩后的回写）→ 定位到对应项
	watch((): number => props.modelValue, (index: number) => {
		activeIndex.value = index
		const target = index * props.optionHeight
		// 已处于目标位置时跳过，避免父组件回写触发无意义的强制偏移
		if (Math.abs(actualTop.value - target) < 1) {
			return
		}
		requestScroll(index)
	}, { flush: 'post' })

	// 选项数量变化（年份切换导致月份 / 天数收缩）→ 重新对齐到受控下标
	watch((): number => optionList.value.length, (_: number) => {
		nextTick(() => {
			requestScroll(props.modelValue)
		})
	}, { flush: 'post' })

	// 宿主重新定位令牌变化（弹层打开后滚动视口才真正可滚动）→ 再次对齐受控下标
	watch((): number => props.positionToken, (_: number) => {
		reposition()
	}, { flush: 'post' })

	onMounted(() => {
		activeIndex.value = props.modelValue
		nextTick(() => {
			requestScroll(props.modelValue)
		})
	})

	onUnmounted(() => {
		if (snapTimer != -1) {
			clearTimeout(snapTimer)
			snapTimer = -1
		}
		if (programmaticTimer != -1) {
			clearTimeout(programmaticTimer)
			programmaticTimer = -1
		}
		if (resetTimer != -1) {
			clearTimeout(resetTimer)
			resetTimer = -1
		}
		if (verifyTimer != -1) {
			clearTimeout(verifyTimer)
			verifyTimer = -1
		}
	})
</script>

<style lang="scss">
	@import '../../theme/vars.scss';

	/* ========== 列（滚动视口） ========== */
	.m-date-picker__column {
		flex: 1;
		height: 100%;
	}

	/* ========== 选项（行容器：纵向居中，高度由 inline 样式下发） ========== */
	.m-date-picker__option {
		justify-content: center;
		align-items: center;
	}

	/* 渐隐分档：距激活项越远越淡（无覆盖遮罩的替代方案） */
	.m-date-picker__option--active {
		opacity: 1;
	}
	.m-date-picker__option--near {
		opacity: 0.6;
	}
	.m-date-picker__option--far {
		opacity: 0.3;
	}

	/* 禁用项：进一步淡出 + 文字置灰（仅通用 Picker 传入 disabledOptions 时生效） */
	.m-date-picker__option--disabled {
		opacity: 0.2;
	}

	/* ========== 选项文本 ========== */
	.m-date-picker__option-text {
		font-size: $m-date-picker-option-font-size;
		color: $m-date-picker-option-color;
	}
	.m-date-picker__option-text--active {
		color: $m-date-picker-option-selected-color;
		font-weight: bold;
	}
</style>
