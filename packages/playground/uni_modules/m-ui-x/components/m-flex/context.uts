/**
 * m-flex 与 m-flex-item 的间距上下文（跨组件共享，独立 .uts）
 *
 * App 端 ucss 不支持 flex gap，且 ucss 无子级 / 结构选择器，
 * 容器侧无法给插槽直通的任意子元素加间距；
 * 由 m-flex provide 本上下文并解析间距值，m-flex-item 在 setup 中同步注册自身 id、
 * onUnmounted 注销，按注册序（即渲染顺序）判断首 / 非首轮位，经 margin 实现间距
 * （m-space / m-compact 同款机制）。
 */
import { computed, reactive, type ComputedRef } from 'vue'

/** provide / inject 配对 key（字符串 key，App 原生端无需 Symbol 支持） */
export const FLEX_KEY: string = '__mxi_flex__'

/** 排列方向：等价 flex-direction 四个值 */
export type FlexDirection = 'row' | 'row-reverse' | 'column' | 'column-reverse'

/** 间距大小：number 补 px、string 原样（内置 small / medium / large 走主题变量） */
export type FlexGap = number | string

/**
 * flex 注入上下文：维护组内已挂载 item 的有序 id 集合与间距状态。
 * gap 为 ComputedRef（跟随 gap prop 响应式，m-row 挂 computed 进 ctx 的先例）：
 * 空串表示内置档位（small / medium / large），item 侧走对应的 $m-flex-gap-* 主题变量类；
 * 非空为已补 px 的自定义间距值，走内联 margin。
 */
export class FlexContext {
	/** 组内 item id 有序集合（reactive 数组，注册 / 注销自动触发间距重算） */
	ids: string[] = reactive<string[]>([])
	/** 排列方向（props 只读快照，创建后不变） */
	direction: FlexDirection = 'row'
	/** 是否换行（仅 row / row-reverse 有效，props 只读快照） */
	wrap: boolean = false
	/** 主轴间距（自定义尺寸时为非空值），空串走主题变量类 */
	gap: ComputedRef<string> = computed<string>(() => '')
	/** 内置档位后缀：''（medium）/ '-sm' / '-lg'，用于拼接 $m-flex-gap-* 主题变量类 */
	gapTier: string = ''

	/** 注册 item（item setup 中同步调用，注册顺序即渲染顺序，首帧即为正确位置） */
	register(id: string): void {
		this.ids.push(id)
	}

	/** 注销 item（onUnmounted 调用，v-if / v-for 动态增删后位置自动重算） */
	unregister(id: string): void {
		const index = this.ids.indexOf(id)
		if (index != -1) {
			this.ids.splice(index, 1)
		}
	}

	/** 查询 id 的注册序位（-1 表示未注册） */
	indexOf(id: string): number {
		return this.ids.indexOf(id)
	}
}

/** item id 自增计数器（模块级） */
let flexIdCounter = 0

/** 生成全局唯一 item id（item setup 中调用一次） */
export function generateFlexId(): string {
	flexIdCounter++
	return 'mxi_flex_' + flexIdCounter
}
