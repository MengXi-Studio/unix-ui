<template>
	<!-- m-password-input-popup 密码/验证码弹层：m-popup + 格子 + m-number-keyboard 一体化组合。
	     工具条（取消 / 标题 / 完成）→ 密码格子 → 数字键盘；
	     内部持 value，按键自动收敛 maxlength=length，弹层自动管理 focused 状态。 -->
	<m-popup
		:show="show"
		position="bottom"
		:round="round"
		:close-on-click-overlay="closeOnClickOverlay"
		:overlay="!transparent"
		:safe-area-inset-bottom="safeAreaInsetBottom"
		:z-index="zIndex"
		:duration="duration"
		@update:show="onPopupUpdateShow"
		@open="onPopupOpen"
		@opened="onPopupOpened"
		@close="onPopupClose"
		@closed="onPopupClosed"
		@click-overlay="onPopupClickOverlay"
	>
		<view class="m-password-input-popup">
			<!-- 无遮罩时的顶部投影条，用于与页面分隔（transparent + showShadow） -->
			<view v-if="showShadow" class="m-password-input-popup__shadow"></view>
			<!-- 工具条 -->
			<view v-if="showToolbar" class="m-password-input-popup__toolbar">
				<view
					v-if="showCancel"
					class="m-password-input-popup__action"
					hover-class="m-password-input-popup__action--active"
					:hover-stay-time="80"
					@click="onCancelTap"
				>
					<slot name="cancel">
						<text class="m-password-input-popup__action-text">{{ cancelButtonText }}</text>
					</slot>
				</view>
				<view class="m-password-input-popup__title-wrap">
					<text class="m-password-input-popup__title">{{ title }}</text>
				</view>
				<view
					v-if="showConfirm"
					class="m-password-input-popup__action m-password-input-popup__action--right"
					hover-class="m-password-input-popup__action--active"
					:hover-stay-time="80"
					@click="onConfirmTap"
				>
					<slot name="confirm">
						<text class="m-password-input-popup__action-text m-password-input-popup__action-text--primary">{{ confirmButtonText }}</text>
					</slot>
				</view>
			</view>
			<!-- 密码格子区（容器包一层 padding，与 keyboard 区分层次） -->
			<view class="m-password-input-popup__panel">
				<m-password-input
					:value="localValue"
					:length="length"
					:type="type"
					:gap="gap"
					:mask="mask"
					:plain-text="plainText"
					:focused="isKeyboardOpen"
					:disabled="disabled"
					:readonly="readonly"
					:info="info"
					:error-info="errorInfo"
				></m-password-input>
			</view>
			<!-- 数字键盘 -->
			<m-number-keyboard
				ref="keyboard"
				:type="keyboardType"
				:theme="keyboardTheme"
				:extra-keys="extraKeys"
				:show-delete-key="showDeleteKey"
				:delete-button-text="deleteButtonText"
				:close-button-text="closeButtonText"
				:disabled-key="disabledKeyFn"
				@input="onKeyboardInput"
				@delete="onKeyboardDelete"
				@close="onKeyboardClose"
			>
				<template v-if="hasExtraKeySlot" #extra-key>
					<slot name="extra-key"></slot>
				</template>
			</m-number-keyboard>
		</view>
	</m-popup>
</template>

<script setup lang="uts">
	/**
	 * m-password-input-popup 密码/验证码弹层：m-popup + m-password-input + m-number-keyboard 一体化组合。
	 * 内部维护 value，按键自动收敛 maxlength=length；弹层打开时格子自动 focused。
	 * 业务层无需手动组合，v-model:show + v-model:value 即可开箱使用。
	 *
	 * 与 m-password-input 的区别：
	 * - 面板：纯展示，不持值，业务层手动组合 keyboard
	 * - 弹层：一体化，自动持值、自动 focused、自动 maxlength 收敛
	 */
	import { NumberKeyboardType, NumberKeyboardTheme } from '../m-number-keyboard/keyboard.uts'
	import MNumberKeyboard from '../m-number-keyboard/m-number-keyboard.uvue'
	import MPasswordInput from '../m-password-input/m-password-input.uvue'
	import { slotHasContent } from '../../utils/slot.uts'
	/** 具名插槽内容判定统一在脚本层求值（模板内直接调用工具函数在 Android 端编译异常） */
	const slots = useSlots()
	/** extra-key 具名插槽是否有内容 */
	const hasExtraKeySlot = computed<boolean>(() => slotHasContent(slots['extra-key']))

	type Props = {
		/** 弹层显隐（v-model:show） */
		show?: boolean
		/** 初始密码值（v-model:value） */
		value?: string
		/** 密码格子数量 */
		length?: number
		/** 格子风格：bordered / underlined */
		type?: 'bordered' | 'underlined'
		/** 格子间距（px） */
		gap?: number
		/** 是否隐藏密码为圆点 */
		mask?: boolean
		/** 明文显示 */
		plainText?: boolean
		/** 禁用态 */
		disabled?: boolean
		/** 只读态 */
		readonly?: boolean
		/** 下方文字提示 */
		info?: string
		/** 下方错误提示 */
		errorInfo?: string
		/** 键盘类型 */
		keyboardType?: NumberKeyboardType
		/** 键盘主题：default / custom */
		keyboardTheme?: NumberKeyboardTheme
		/** 键盘额外键 */
		extraKeys?: string[]
		/** 是否显示删除键 */
		showDeleteKey?: boolean
		/** 删除键文字（空则图标） */
		deleteButtonText?: string
		/** custom 主题关闭键文字 */
		closeButtonText?: string
		/** 工具条标题 */
		title?: string
		/** 是否显示取消/完成工具条 */
		showToolbar?: boolean
		/** 取消按钮文字 */
		cancelButtonText?: string
		/** 完成按钮文字 */
		confirmButtonText?: string
		/** 弹层圆角 */
		round?: boolean
		/** 遮罩透明 */
		transparent?: boolean
		/** 顶部投影条 */
		showShadow?: boolean
		/** 显示取消按钮 */
		showCancel?: boolean
		/** 显示完成按钮 */
		showConfirm?: boolean
		/** 点击遮罩关闭 */
		closeOnClickOverlay?: boolean
		/** 底部安全区 */
		safeAreaInsetBottom?: boolean
		/** z-index */
		zIndex?: number
		/** 动画时长秒 */
		duration?: number
	}

	const props = withDefaults(defineProps<Props>(), {
		show: false,
		value: '',
		length: 6,
		type: 'bordered',
		gap: 8,
		mask: true,
		plainText: false,
		disabled: false,
		readonly: false,
		info: '',
		errorInfo: '',
		keyboardType: 'number',
		keyboardTheme: 'default',
		extraKeys: null,
		showDeleteKey: true,
		deleteButtonText: '',
		closeButtonText: '',
		title: '',
		showToolbar: true,
		cancelButtonText: '取消',
		confirmButtonText: '完成',
		round: true,
		transparent: false,
		showShadow: false,
		showCancel: true,
		showConfirm: true,
		closeOnClickOverlay: true,
		safeAreaInsetBottom: true,
		zIndex: 1,
		duration: 0.3
	})

	const emit = defineEmits<{
		'update:show': [value: boolean]
		/** 密码值变化（v-model:value） */
		'update:value': [value: string]
		/** 兼容 v-model 写法 */
		'update:modelValue': [value: string]
		/** 可输入键点击 */
		input: [key: string]
		/** 删除键点击 */
		delete: []
		/** custom 主题关闭键点击 */
		'close-key': []
		/** 取消（随后关闭） */
		cancel: []
		/** 完成（随后关闭） */
		confirm: []
		open: []
		opened: []
		close: []
		closed: []
		'click-overlay': [event: MouseEvent]
	}>()

	/** 内部 value 状态（与 props.value 双向同步） */
	const localValue = ref<string>(props.value)

	/** 键盘是否打开（控制格子 focused） */
	const isKeyboardOpen = ref<boolean>(false)

	/** 内部面板实例（转发 shuffle） */
	const keyboard = ref<ComponentPublicInstance | null>(null)

	/**
	 * 键盘按键禁用回调：填满后禁用，禁用态 / 只读态全部禁用
	 * @param key 按键文本
	 * @returns 是否禁用
	 */
	function disabledKeyFn(key: string): boolean {
		if (props.disabled || props.readonly) return true
		if (key == '' || key == 'delete' || key == 'close') return false
		if (localValue.value.length >= props.length) return true
		return false
	}

	/** 重新打乱数字键序（仅 random 类型） */
	function shuffle() {
		const inst = keyboard.value
		if (inst != null) {
			inst.$callMethod('shuffle')
		}
	}

	/**
	 * 同步 props.value → localValue（外部 value 变更时回写）
	 */
	watch((): string => props.value, (v: string) => {
		if (v != localValue.value) {
			localValue.value = v
		}
	})

	/* ========== Popup 生命周期转发 ========== */

	const onPopupUpdateShow = (v: boolean) => {
		emit('update:show', v)
	}
	const onPopupOpen = () => {
		emit('open')
	}
	const onPopupOpened = () => {
		emit('opened')
		isKeyboardOpen.value = true
		// 乱序键盘每次打开重新打乱
		if (props.keyboardType == 'random') shuffle()
	}
	const onPopupClose = () => {
		emit('close')
		isKeyboardOpen.value = false
	}
	const onPopupClosed = () => {
		emit('closed')
	}
	const onPopupClickOverlay = (e: MouseEvent) => {
		emit('click-overlay', e)
	}

	/* ========== Keyboard 事件处理 ========== */

	/** 键盘按键：自动收敛 maxlength */
	function onKeyboardInput(key: string) {
		if (props.disabled || props.readonly) return
		if (localValue.value.length >= props.length) return
		localValue.value += key
		emit('update:value', localValue.value)
		emit('update:modelValue', localValue.value)
		emit('input', key)
	}

	/** 删除键：自动收敛到 0 */
	function onKeyboardDelete() {
		if (localValue.value.length <= 0) return
		localValue.value = localValue.value.slice(0, -1)
		emit('update:value', localValue.value)
		emit('update:modelValue', localValue.value)
		emit('delete')
	}

	/** custom 主题关闭键：派发 close-key 并关闭弹层 */
	function onKeyboardClose() {
		emit('close-key')
		emit('update:show', false)
	}

	/* ========== 工具条按钮 ========== */

	/** 取消：派发后关闭 */
	function onCancelTap() {
		emit('cancel')
		emit('update:show', false)
	}

	/** 完成：派发后关闭 */
	function onConfirmTap() {
		emit('confirm')
		emit('update:show', false)
	}

	defineExpose({
		shuffle
	})
</script>

<style lang="scss">
	/*
	 * 主题变量说明（默认主题内置 + 变量覆盖）：
	 * 组件内顶层引入 theme/vars.scss（全部 !default），零配置即有默认主题；
	 * 覆盖方式：项目根 uni.scss 直接定义 $m-* 变量（禁止 @import vars.scss）。
	 */
	@import '../../theme/vars.scss';

	/* ========== 根 ========== */
	.m-password-input-popup {
		background-color: $m-number-keyboard-background;
	}

	/* ========== 顶部投影条 ========== */
	.m-password-input-popup__shadow {
		height: 6px;
		background-color: $m-number-keyboard-shadow-color;
	}

	/* ========== 工具条（复用 keyboard-popup 的结构与主题变量） ========== */
	.m-password-input-popup__toolbar {
		position: relative;
		height: $m-number-keyboard-title-height;
		flex-direction: row;
		align-items: center;
		padding: $m-number-keyboard-title-padding;
	}

	.m-password-input-popup__action {
		flex: 1;
		flex-direction: row;
		padding: 0 4px;
		justify-content: flex-start;
		align-items: center;
	}

	.m-password-input-popup__action--right {
		justify-content: flex-end;
	}

	.m-password-input-popup__action--active {
		opacity: 0.6;
	}

	.m-password-input-popup__action-text {
		font-size: $m-number-keyboard-action-font-size;
		color: $m-number-keyboard-key-color;
	}

	.m-password-input-popup__action-text--primary {
		color: $m-number-keyboard-button-color;
	}

	.m-password-input-popup__title-wrap {
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		left: 0;
		flex-direction: row;
		justify-content: center;
		align-items: center;
	}

	.m-password-input-popup__title {
		font-size: $m-number-keyboard-title-font-size;
		font-weight: $m-number-keyboard-title-font-weight;
		color: $m-number-keyboard-title-color;
	}

	/* ========== 密码格子容器（keyboard 上方的独立区块，与键盘底色区分） ========== */
	.m-password-input-popup__panel {
		background-color: $m-number-keyboard-key-background;
		padding: 16px;
	}
</style>
