<template>
	<!-- m-password-input 密码/验证码格子面板。
	     两种视觉风格：bordered（圆角方框 + 等宽 gap） / underlined（仅底部 1px 底线）。
	     格子 flex: 1 等分 + gap 用内联 margin（仅此处动态，其余样式全部走扁平 class）。
	     光标闪烁用 setInterval 半周期切换响应式 class（el.animate 在 web 端不存在、
     el.style.setProperty 在 web 端 UniElement 代理上无效，纯响应式方案全平台一致），
     只有 focused 且 activeIndex 有效时才渲染光标。 -->
	<view class="m-password-input">
		<view class="m-password-input__cells" @click="onRootTap">
			<view
				v-for="(_, index) in lengthList"
				:key="index"
				:class="cellClass(index)"
				:style="cellInnerStyle(index)"
			>
				<!-- 已填格子：明文 or mask 圆点 -->
				<template v-if="index < value.length">
					<view v-if="shouldShowDot" class="m-password-input__dot"></view>
					<text v-else class="m-password-input__char">{{ value.charAt(index) }}</text>
				</template>
				<!-- 未填但当前位 + focused：显示光标（闪烁由响应式 cursorClass 切换 hidden 类） -->
				<view
					v-else-if="index === activeIndex && isFocusedEffective"
					:class="cursorClass"
				></view>
			</view>
		</view>
		<!-- 下方提示文字：errorInfo 优先于 info -->
		<view v-if="showTip" class="m-password-input__tip">
			<text :class="tipClass">{{ actualTip }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	/**
	 * m-password-input 密码/验证码格子面板：纯展示，不持值。
	 * 业务层手动组合模式：password-input 显示 + number-keyboard 输入，
	 * 弹层模式：password-input-popup 内部自动组装（见对应组件）。
	 *
	 * 实现要点：
	 * - 格子宽度用 flex: 1 等分 + gap 内联 margin；不依赖 css calc
	 * - 全部静态样式（圆点/光标/文字/提示）走扁平 class，禁止在 script 里引用 SCSS 变量
	 *   （SCSS 变量只在 <style> 编译期存在，写进 script 是 undefined，会导致内联样式全失效）
	 * - 光标闪烁用 setInterval 切响应式 class；watch immediate 启停
	 * - disabled/readonly 时点击不派发 focus，样式灰显
	 * - mask 圆点用 view + border-radius: 50%，跨平台一致
	 */

	type Props = {
		/** 当前密码值 */
		value?: string
		/** 密码格子数量 */
		length?: number
		/** 风格：bordered 圆角方框 / underlined 仅底线 */
		type?: 'bordered' | 'underlined'
		/** 格子间距（px，number 类型，禁用 string 避免联合类型 Kotlin 退化） */
		gap?: number
		/** 是否隐藏密码为圆点 */
		mask?: boolean
		/** 明文显示（互斥：plainText=true 时 mask 忽略） */
		plainText?: boolean
		/** 聚焦态：当前位显示光标、聚焦框高亮 */
		focused?: boolean
		/** 禁用态（灰显 + 不派发 focus） */
		disabled?: boolean
		/** 只读态（可查看但不可点击聚焦） */
		readonly?: boolean
		/** 下方文字提示 */
		info?: string
		/** 下方错误提示（优先级高于 info） */
		errorInfo?: string
	}

	const props = withDefaults(defineProps<Props>(), {
		value: '',
		length: 6,
		type: 'bordered',
		gap: 8,
		mask: true,
		plainText: false,
		focused: false,
		disabled: false,
		readonly: false,
		info: '',
		errorInfo: ''
	})

	const emit = defineEmits<{
		/** 格子点击（disabled/readonly 时不派发） */
		focus: []
	}>()

	/** 光标闪烁动画时长（毫秒），与 $m-password-input-cursor-duration 保持一致 */
	const CURSOR_DURATION = 1000

	/** 光标闪烁实现说明：
	 *  el.animate 在 web 端不存在、el.style.setProperty 在 web 端 UniElement 代理上无效，
	 *  故统一用 setInterval 半周期切换响应式 cursorVisible，模板拼 hidden class——全平台一致、零 DOM 操作。
	 *  cursorTimer 在 App 端同样可用（uts 标准 API），无需条件编译。 */

	/** 光标当前是否可见（闪烁状态） */
	const cursorVisible = ref(true)

	/** 闪烁定时器句柄 */
	let cursorTimer = -1

	/**
	 * 光标 class：隐藏态叠加扁平类（ucss 无复合选择器）
	 */
	const cursorClass = computed<string>(() => {
		let cls = 'm-password-input__cursor'
		if (!cursorVisible.value) cls += ' m-password-input__cursor--hidden'
		return cls
	})

	/**
	 * length 转数组用于 v-for（uts 不支持 v-for="n in number" 的写法）
	 */
	const lengthList = computed<number[]>(() => {
		const list: number[] = []
		for (let i = 0; i < props.length; i++) {
			list.push(i)
		}
		return list
	})

	/**
	 * 当前活跃位（决定光标和聚焦高亮）：
	 * - focused=false → -1（无光标）
	 * - value.length >= length → length - 1（最后一格闪烁，提示已填满）
	 * - 否则 → value.length（第一个空位）
	 */
	const activeIndex = computed<number>(() => {
		if (!props.focused) return -1
		const v = props.value
		if (v.length >= props.length) return props.length - 1
		return v.length
	})

	/**
	 * 是否有有效光标渲染：focused 为真且 activeIndex 在合法范围
	 */
	const isFocusedEffective = computed<boolean>(() => {
		return props.focused && activeIndex.value >= 0 && activeIndex.value < props.length
	})

	/**
	 * 格子是否应显示 mask 圆点：已填 + mask=true + plainText=false
	 */
	const shouldShowDot = computed<boolean>(() => {
		return props.mask && !props.plainText
	})

	/**
	 * 是否显示下方提示文字
	 */
	const showTip = computed<boolean>(() => {
		return props.errorInfo != '' || props.info != ''
	})

	/**
	 * 实际提示文字（errorInfo 优先）
	 */
	const actualTip = computed<string>(() => {
		if (props.errorInfo != '') return props.errorInfo
		return props.info
	})

	/**
	 * 提示文字 class（error 用 danger 色，扁平类避免复合选择器）
	 */
	const tipClass = computed<string>(() => {
		return props.errorInfo != ''
			? 'm-password-input__tip-text m-password-input__tip-text--error'
			: 'm-password-input__tip-text'
	})

	/**
	 * 单格容器 class：风格 / 聚焦 / 禁用全部拆成扁平类（ucss 无复合选择器对账）
	 */
	function cellClass(index: number): string {
		const isActive = index === activeIndex.value && isFocusedEffective.value
		let cls = 'm-password-input__cell'
		cls += props.type === 'underlined' ? ' m-password-input__cell--underlined' : ' m-password-input__cell--bordered'
		if (isActive) {
			cls += props.type === 'underlined'
				? ' m-password-input__cell--underlined-active'
				: ' m-password-input__cell--bordered-active'
		}
		if (props.disabled) cls += ' m-password-input__cell--disabled'
		return cls
	}

	/**
	 * 单格内联样式：仅 gap margin 是 props 驱动的动态值（number 拼接合法），
	 * 首尾格只在一侧留 margin，相邻两格叠加得完整 gap
	 */
	function cellInnerStyle(index: number): string {
		const margin = props.gap / 2
		let ml = margin
		let mr = margin
		if (index === 0) ml = 0
		if (index === props.length - 1) mr = 0
		return 'flex: 1; margin-left: ' + ml + 'px; margin-right: ' + mr + 'px;'
	}

	/**
	 * 根节点点击：disabled/readonly 不派发 focus
	 */
	function onRootTap() {
		if (props.disabled || props.readonly) return
		emit('focus')
	}

	/**
	 * 停止光标闪烁并复位可见态
	 * 注意：Kotlin 局部函数不允许前向引用，被 startCursorAnimation 调用必须先声明。
	 */
	function stopCursorAnimation() {
		if (cursorTimer != -1) {
			clearInterval(cursorTimer)
			cursorTimer = -1
		}
		cursorVisible.value = true
	}

	/**
	 * 启动光标闪烁：半周期切换 cursorVisible
	 */
	function startCursorAnimation() {
		stopCursorAnimation()
		cursorVisible.value = true
		cursorTimer = setInterval(() => {
			cursorVisible.value = !cursorVisible.value
		}, CURSOR_DURATION / 2)
	}

	/**
	 * 按当前聚焦态启停光标闪烁（focused / activeIndex 任一变化都需重算）
	 */
	function syncCursorAnimation() {
		if (isFocusedEffective.value) {
			startCursorAnimation()
		} else {
			stopCursorAnimation()
		}
	}

	/**
	 * 监听 focused 变化启停光标动画。
	 * immediate: true 保证初始 focused=true 时也启动；flush post 确保 DOM 渲染后 ref 就绪。
	 *
	 * 注意：不能合并成返回元组的单个 watch——`(): [boolean, number] => [...]` 会被编译成
	 * Kotlin 的 `fun(): [Boolean, Number]`（非法类型语法），云打包时直接编译失败；
	 * 拆成两个单值 watch 是 App 端可编译的写法。
	 */
	watch(
		(): boolean => props.focused,
		(_: boolean) => {
			syncCursorAnimation()
		},
		{ immediate: true, flush: 'post' }
	)

	/**
	 * 监听 activeIndex 变化启停光标动画（值填满 / 清空时活跃位会跳变）
	 */
	watch(
		(): number => activeIndex.value,
		(_: number) => {
			syncCursorAnimation()
		},
		{ immediate: true, flush: 'post' }
	)
</script>

<style lang="scss">
	/*
	 * 主题变量说明（默认主题内置 + 变量覆盖）：
	 * 组件内顶层引入 theme/vars.scss（全部 !default），零配置即有默认主题；
	 * 覆盖方式：项目根 uni.scss 直接定义 $m-* 变量（禁止 @import vars.scss）。
	 * 注意：$m-* 变量只能在本 <style> 块里引用，禁止写进 <script>。
	 */
	@import '../../theme/vars.scss';

	/* ========== 根容器 ========== */
	.m-password-input {
		flex-direction: column;
	}

	/* ========== 格子行（flex row，等分交给子项 flex: 1 内联） ========== */
	.m-password-input__cells {
		flex-direction: row;
		align-items: center;
	}

	/* ========== 单格（占满等分 flex 的高度） ========== */
	.m-password-input__cell {
		height: $m-password-input-height;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		box-sizing: border-box;
	}

	/* bordered 风格：圆角方框 */
	.m-password-input__cell--bordered {
		border-radius: $m-password-input-border-radius;
		border-style: solid;
		border-width: 1px;
		border-color: $m-password-input-border-color;
		background-color: $m-password-input-background;
	}

	/* underlined 风格：仅底部 1px 线 */
	.m-password-input__cell--underlined {
		border-bottom-style: solid;
		border-bottom-width: 1px;
		border-bottom-color: $m-password-input-underline-color;
	}

	/* 聚焦高亮：扁平类（运行时拼接，替代复合选择器） */
	.m-password-input__cell--bordered-active {
		border-color: $m-password-input-border-color-focus;
	}
	.m-password-input__cell--underlined-active {
		border-bottom-color: $m-password-input-underline-color-focus;
	}

	/* 禁用态：整行灰显 */
	.m-password-input__cell--disabled {
		opacity: $m-password-input-disabled-opacity;
	}

	/* ========== mask 圆点（view + 50% 圆角，跨平台一致） ========== */
	.m-password-input__dot {
		width: $m-password-input-dot-size;
		height: $m-password-input-dot-size;
		border-radius: 50%;
		background-color: $m-password-input-dot-color;
	}

	/* ========== 明文文字（居中显示） ========== */
	.m-password-input__char {
		font-size: $m-password-input-font-size;
		color: $m-password-input-text-color;
		text-align: center;
	}

	/* ========== 光标（闪烁由响应式 hidden 类切换 opacity） ========== */
	.m-password-input__cursor {
		width: $m-password-input-cursor-width;
		height: $m-password-input-cursor-height;
		background-color: $m-password-input-cursor-color;
	}

	.m-password-input__cursor--hidden {
		opacity: 0;
	}

	/* ========== 下方提示文字 ========== */
	.m-password-input__tip {
		padding-top: 4px;
	}

	.m-password-input__tip-text {
		font-size: $m-password-input-info-font-size;
		color: $m-password-input-info-color;
	}

	.m-password-input__tip-text--error {
		color: $m-password-input-error-info-color;
	}
</style>
