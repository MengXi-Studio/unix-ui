<template>
	<!-- 单选框组容器：provide 上下文给 m-radio 子项（组内子项经 name 参与单选），
	     当前选中值 v-model:value 受控（null 未选）。 -->
	<view :class="rootClass" :style="customStyle">
		<slot></slot>
	</view>
</template>

<script setup lang="uts">
	/**
	 * m-radio-group 单选框组：单值容器。
	 * 视觉规格（形状 / 图标尺寸 / 选中色 / 禁用 / 只读 / direction）经上下文统一下发，
	 * 子项 m-radio inject 后按 name 参与单选；value 变更经 update:value 回写外部。
	 */
	import {
		RADIO_KEY,
		RadioGroupContext,
		RadioValue,
		RadioShape,
		RadioDirection
	} from './radio.uts'

	type Props = {
		/** 当前选中项标识（v-model:value；null 未选） */
		value?: RadioValue
		/** 是否禁用全部单选框 */
		disabled?: boolean
		/** 是否只读全部单选框（视觉正常但不可切换） */
		readonly?: boolean
		/** 排列方向 */
		direction?: RadioDirection
		/** 图标尺寸（number 补 px / string 原样，统一下发子项） */
		iconSize?: string | number
		/** 选中态颜色（统一下发子项，子项 checked-color 优先） */
		checkedColor?: string
		/** 形状（统一下发子项，子项 shape 优先） */
		shape?: RadioShape
		/** 自定义根节点类名 */
		customClass?: string.ClassString
		/** 自定义根节点内联样式 */
		customStyle?: string
	}

	const props = withDefaults(defineProps<Props>(), {
		value: null,
		disabled: false,
		readonly: false,
		direction: 'vertical',
		iconSize: '',
		checkedColor: '',
		shape: 'round',
		customClass: '',
		customStyle: ''
	})

	const emit = defineEmits<{
		/** 选中值变化（v-model:value） */
		'update:value': [value: RadioValue | null]
		/** 选中值变化（回传当前选中值） */
		change: [value: RadioValue | null]
	}>()

	/** 组上下文（provide 给 m-radio） */
	const ctx = new RadioGroupContext()
	provide(RADIO_KEY, ctx)

	/** 数字 / 纯数字字符串补 px（icon-size 换算） */
	function addUnit(value: string): string {
		if (value == '') return ''
		const pattern = new RegExp('^-?\\d+(\\.\\d+)?$')
		return pattern.test(value) ? value + 'px' : value
	}

	/** 根节点类名：纵向 / 横向变体 + customClass */
	const rootClass = computed<string>(() => {
		let cls = 'm-radio-group'
		if (props.direction == 'horizontal') cls += ' m-radio-group--horizontal'
		if (props.customClass != '') cls += ' ' + props.customClass
		return cls
	})

	// 视觉规格 props 变更同步上下文（子项只读上下文，不重复声明逻辑）
	watch((): RadioValue | null => props.value, (v: RadioValue | null) => {
		ctx.value.value = v
	}, { immediate: true })

	watch((): boolean => props.disabled, (v: boolean) => {
		ctx.disabled.value = v
	}, { immediate: true })

	watch((): boolean => props.readonly, (v: boolean) => {
		ctx.readonly.value = v
	}, { immediate: true })

	watch((): RadioShape => props.shape, (v: RadioShape) => {
		ctx.shape.value = v
	}, { immediate: true })

	watch((): RadioDirection => props.direction, (v: RadioDirection) => {
		ctx.direction.value = v
	}, { immediate: true })

	/** 选中色与图标尺寸（null 兜底空串） */
	watch((): string => props.checkedColor, (v: string) => {
		ctx.checkedColor.value = v
	}, { immediate: true })

	watch((): string => {
		if (props.iconSize == '') return ''
		return addUnit('' + props.iconSize)
	}, (v: string) => {
		ctx.iconSize.value = v
	}, { immediate: true })

	/** 上下文选中值变化回写外部（子项 select 修改 ctx.value 后触发） */
	watch(ctx.value, (v: RadioValue | null) => {
		emit('update:value', v)
		emit('change', v)
	})
</script>

<style lang="scss">
	/*
	 * 主题变量说明（默认主题内置 + 变量覆盖）：
	 * 组件内顶层引入 theme/vars.scss（全部 !default），零配置即有默认主题；
	 * 覆盖方式：项目根 uni.scss 直接定义 $m-* 变量（禁止 @import vars.scss，
	 * uni.scss 注入机制与组件内引入同一文件会触发循环导入）。
	 */
	@import '../../theme/vars.scss';

	/* 组容器：纵向排列 */
	.m-radio-group {
		flex-direction: column;
	}

	/* 横向排列（换行） */
	.m-radio-group--horizontal {
		flex-direction: row;
		flex-wrap: wrap;
	}
</style>
