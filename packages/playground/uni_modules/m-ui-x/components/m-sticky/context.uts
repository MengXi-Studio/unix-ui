/**
 * m-sticky-box 与 m-sticky 的容器上下文（跨组件共享，独立 .uts）
 *
 * Web 端 CSS sticky 的边界由父容器天然约束；App / 小程序没有原生 sticky，
 * 由 m-sticky-box 把根节点引用注入上下文，子 m-sticky 测量容器上下边界，
 * 吸附时超出边界则回顶（对齐 Vant container / Sard StickyBox 语义）
 */
import { ref, type Ref } from 'vue'

/** provide / inject 配对 key（字符串 key，App 原生端无需 Symbol 支持） */
export const STICKY_BOX_KEY: string = '__mxi_sticky_box__'

/**
 * 粘性容器上下文
 *
 * root 与 m-sticky-box 的模板 ref 同源，子组件在挂载后的 nextTick 读取
 * （此时父级模板 ref 已填充，可安全测量容器边界）
 */
export class StickyBoxContext {
	/** 容器根节点引用（未挂载 / 未使用容器时为 null） */
	root: Ref<UniElement | null> = ref<UniElement | null>(null)
}
