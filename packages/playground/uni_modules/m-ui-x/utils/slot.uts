/**
 * 插槽工具：跨端判断具名插槽是否实际传入了内容。
 *
 * 背景（issue #24）：未传具名插槽时，Web / App 端 `$slots[name]` / `useSlots()[name]` 为 null，
 * 而微信小程序端会得到一个空数组（个别实现为空对象），因此 `slots[name] != null` 在小程序端恒为真。
 * 若直接据此向子组件条件转发插槽，就会把「空插槽」转发下去，覆盖子组件的默认内容
 * （典型表现：picker-popup 系列的取消 / 标题 / 确认工具栏消失，无法提交选择）。
 *
 * 用法：
 *   import { slotHasContent } from '../../utils/slot.uts'
 *   模板：v-if="slotHasContent($slots['toolbar'])" #toolbar
 *   脚本：computed<boolean>(() => slotHasContent(slots['content']))
 *
 * 注意：本函数只适用于**具名插槽**。默认插槽（写在组件标签之间的匿名子节点）在小程序端
 * 父级传了内容时 `$slots.default` 是「空数组」（子节点不进入数组元素），未传时则没有该 key；
 * 长度判定在本端恒为 false，会把「已传」误判成「未传」。默认插槽请一律用 `slots['default'] != null` 判定。
 */

/**
 * 判断具名插槽是否实际传入内容（Web / App / 小程序跨端一致）。
 *
 * @param slot 插槽值：渲染函数 / 布尔标记（存在即已传入）或节点数组（未传时为空）
 * @returns 是否实际传入内容；null 或空容器均返回 false
 */
export function slotHasContent(slot: any | null): boolean {
	if (slot == null) return false
	// #ifdef MP
	// VDOM 模式下小程序端插槽值为布尔标记（页面已传为 true，未传时为 undefined），按标记真值判定（issue #27）
	if (typeof slot == 'boolean') return slot as boolean
	// 非 VDOM 模式：插槽为节点数组，未传时为空数组；空对象取不到 length，同样视为未传
	const list = slot as any[]
	const len = list.length
	if (len == null) return false
	return len > 0
	// #endif
	// #ifndef MP
	// Web / App：插槽存在即视为已传入（渲染函数），内容为空是调用方自身的选择
	return true
	// #endif
}

/**
 * 判断具名插槽是否生效：父级下发的存在性标记优先，未下发时回退本组件探测。
 *
 * 背景（issue #29）：弹层组合组件（如 m-picker-popup）把具名插槽转发给面板时，小程序端会把这些插槽
 * **静态声明**在面板上——即使页面没有传，面板拿到的也是布尔 true，无法自行区分「未传」与「传了空内容」。
 * 组合组件能拿到页面级的真实插槽值，因此由它把「已传入的插槽名」编码成英文逗号分隔字符串下发给面板，
 * 面板优先采用该标记渲染默认内容，避免默认工具栏 / 标题被空插槽吞掉。
 *
 * @param slot 本组件 useSlots() 中对应插槽的值
 * @param presence 父级下发的存在性标记（英文逗号分隔的插槽名）；null 表示未下发，回退本组件探测
 * @param name 插槽名
 * @returns 该具名插槽是否应视为已传入
 */
export function slotActive(slot: any | null, presence: string | null, name: string): boolean {
	if (presence != null) {
		const names = presence.split(',')
		for (let i = 0; i < names.length; i++) {
			if (names[i] == name) {
				return true
			}
		}
		return false
	}
	return slotHasContent(slot)
}
